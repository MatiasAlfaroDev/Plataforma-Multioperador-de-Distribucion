{
  "title": "Tablero técnico — Última Milla",
  "uid": "tablero-tecnico",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "ultimamilla",
    "rnf-6.12"
  ],
  "description": "Tablero técnico de la RNF 6.12: API detrás de Traefik (dos réplicas), outbox de MassTransit y runtime .NET.",
  "panels": [
    {
      "type": "row",
      "title": "API",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Solicitudes por segundo",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "unit": "reqps"
    },
    {
      "type": "stat",
      "title": "Latencia media",
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_sum{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "unit": "s"
    },
    {
      "type": "stat",
      "title": "Tasa de errores (5xx)",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"api\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "unit": "percentunit",
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": 0
          },
          {
            "color": "red",
            "value": 0.01
          }
        ]
      },
      "noValue": "0"
    },
    {
      "type": "stat",
      "title": "Réplicas reportando",
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (instance) (http_server_request_duration_seconds_count{job=\"api\",instance!=\"\"}))",
          "legendFormat": ""
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "red",
            "value": 0
          },
          {
            "color": "green",
            "value": 2
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Latencia: media, p95 y p99",
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_sum{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval]))",
          "legendFormat": "media"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "unit": "s"
    },
    {
      "type": "timeseries",
      "title": "Solicitudes por réplica",
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_server_request_duration_seconds_count{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "unit": "reqps"
    },
    {
      "type": "timeseries",
      "title": "Respuestas por código",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"api\",http_route!~\"/ready|/health|/live\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "unit": "reqps",
      "stacking": {
        "mode": "normal"
      }
    },
    {
      "type": "table",
      "title": "p95 por ruta",
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"api\",http_route!~\"/ready|/health|/live\"}[5m])))",
          "legendFormat": ""
        }
      ],
      "unit": "s",
      "instant": true,
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Outbox y mensajería (RNF 6.8)",
