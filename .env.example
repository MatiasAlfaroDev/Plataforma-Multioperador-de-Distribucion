# Copiar como .env (que está en .gitignore) y cambiar el valor. Si no existe .env, se usa el valor de desarrollo.
POSTGRES_PASSWORD=cambiar_esta_clave
# Obligatoria: clave de los usuarios de demostración que siembra el inicializador.
# Identity exige 8 caracteres o más, con mayúscula, minúscula, dígito y símbolo.
DEMO_PASSWORD=Cambiar.esta1
