<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models"
             x:Class="UltimaMilla.Mobile.Pages.EnviosPage"
             x:DataType="vm:EnviosViewModel"
             Title="Mi ruta de hoy">

    <!-- Botón "Actualizar" arriba a la derecha (en Windows no se puede deslizar con el mouse) -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cargar vehículo" Command="{Binding IrACargaCommand}" />
        <ToolbarItem Text="Actualizar" Command="{Binding CargarCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding CargarCommand}" IsRefreshing="{Binding EstaCargando}">
        <CollectionView ItemsSource="{Binding Envios}" Margin="16,0">

            <!-- ===== CABECERA: resumen del día, conexión y pendientes ===== -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="0,16,0,4">

                    <!-- Tarjeta azul con el resumen -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Tertiary}}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding FechaHoy}" TextColor="#CFE0F5" FontSize="13" />
                                    <Label Text="{Binding Operador.Nombre}" TextColor="White"
                                           FontFamily="OpenSansSemibold" FontSize="22" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="🚚" FontSize="34" VerticalOptions="Center" />
                            </Grid>

                            <ProgressBar Progress="{Binding Progreso}" ProgressColor="White" />
                            <Label Text="{Binding TextoProgreso}" TextColor="#CFE0F5" FontSize="13" />

                            <!-- Tres contadores -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="8,10" BackgroundColor="#33FFFFFF">
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="{Binding PorEntregar}" TextColor="White" FontFamily="OpenSansSemibold"
                                               FontSize="22" HorizontalOptions="Center" />
                                        <Label Text="Por entregar" TextColor="#E3EEFA" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="8,10" BackgroundColor="#33FFFFFF">
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="{Binding Entregados}" TextColor="White" FontFamily="OpenSansSemibold"
                                               FontSize="22" HorizontalOptions="Center" />
                                        <Label Text="Entregados" TextColor="#E3EEFA" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="8,10" BackgroundColor="#33FFFFFF">
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="{Binding NoEntregados}" TextColor="White" FontFamily="OpenSansSemibold"
                                               FontSize="22" HorizontalOptions="Center" />
                                        <Label Text="No entregados" TextColor="#E3EEFA" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Estado de la conexión: verde en línea, naranja sin conexión -->
                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource ExitoSuave}"
                            HorizontalOptions="Start" IsVisible="{Binding EnLinea}">
                        <Label Text="● En línea" TextColor="{StaticResource Exito}" FontSize="12" FontFamily="OpenSansSemibold" />
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource AlertaSuave}"
                            Stroke="{StaticResource Alerta}" Padding="14,10" IsVisible="{Binding SinConexion}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="📡 Sin conexión" TextColor="{StaticResource Alerta}" FontFamily="OpenSansSemibold" />
                            <Label Text="Podés seguir trabajando: todo queda guardado en el teléfono."
                                   TextColor="{StaticResource Alerta}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Registros sin enviar al servidor -->
                    <Border Style="{StaticResource Tarjeta}" Padding="14,10" IsVisible="{Binding HayPendientes}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding TextoPendientes, StringFormat='⏳ {0}'}" VerticalOptions="Center"
                                   TextColor="{StaticResource Alerta}" FontSize="13" />
                            <Button Grid.Column="1" Text="{Binding TextoBotonSincronizar}"
                                    Command="{Binding SincronizarCommand}" Padding="14,6" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding Aviso}" Style="{StaticResource Secundario}" IsVisible="{Binding HayAviso}" />
                    <Label Text="{Binding Error}" TextColor="{StaticResource Peligro}" IsVisible="{Binding HayError}" />

                    <Label Text="Envíos" Style="{StaticResource Titulo}" FontSize="18" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ===== Lista vacía ===== -->
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="📦" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No hay envíos en tu ruta" Style="{StaticResource Titulo}" FontSize="18"
                           HorizontalOptions="Center" />
                    <Label Text="Tocá «Actualizar» o deslizá hacia abajo para descargarla."
                           Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- ===== Tarjeta de cada envío ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EnvioRuta">
                    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,6">
                        <Grid ColumnDefinitions="6,*">

                            <!-- Franja de color según el estado -->
                            <BoxView Color="{Binding ColorEstado}" />

                            <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="6">

                                <!-- Referencia + etiqueta de estado -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding ReferenciaExterna}" FontFamily="OpenSansSemibold"
                                           FontSize="16" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource Chip}"
                                            BackgroundColor="{Binding ColorEstadoSuave}">
                                        <Label Text="{Binding EtiquetaEstado}" TextColor="{Binding ColorEstado}"
                                               FontSize="12" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding DestinatarioNombre, StringFormat='👤 {0}'}" FontSize="15" />
                                <Label Text="{Binding Direccion, StringFormat='📍 {0}'}" FontSize="14" />
                                <Label Style="{StaticResource Secundario}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ComercioNombre}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding DetalleBultos}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- ¿Ya llegó al servidor? -->
                                <Label Text="{Binding TextoSincronizacion}" TextColor="{Binding ColorSincronizacion}"
                                       FontSize="12" FontFamily="OpenSansSemibold" IsVisible="{Binding MostrarSincronizacion}" />
                                <!-- Conflicto: el servidor rechazó lo registrado -->
                                <Button Text="Descartar" Style="{StaticResource BotonPeligro}"
                                        HorizontalOptions="Start" Padding="16,6"
                                        IsVisible="{Binding Rechazado}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EnviosViewModel}}, Path=DescartarCommand}"
                                        CommandParameter="{Binding .}" />

                                <!-- Botones: solo si todavía no se registró el resultado -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0"
                                      IsVisible="{Binding PuedeRegistrar}">
                                    <Button Text="✓ Entregado" Style="{StaticResource BotonExito}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EnviosViewModel}}, Path=EntregarCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1" Text="✕ No entregado" Style="{StaticResource BotonPeligro}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EnviosViewModel}}, Path=NoEntregadoCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ContentView HeightRequest="24" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
