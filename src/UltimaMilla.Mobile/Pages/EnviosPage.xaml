<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models"
             x:Class="UltimaMilla.Mobile.Pages.EnviosPage"
             x:DataType="vm:EnviosViewModel"
             Title="{Binding Operador.Nombre}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <Label Text="{Binding Error}" TextColor="Red" IsVisible="{Binding HayError}" />

        <RefreshView Grid.Row="1" Command="{Binding CargarCommand}" IsRefreshing="{Binding EstaCargando}">
            <CollectionView ItemsSource="{Binding Envios}">
                <CollectionView.EmptyView>
                    <Label Text="No hay envíos para este operador." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EnvioItem">
                        <Border Margin="0,6" Padding="14" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding ReferenciaExterna}" FontAttributes="Bold" FontSize="16" />
                                    <Label Grid.Column="1" Text="{Binding Estado}" FontSize="13" TextColor="Gray" />
                                </Grid>
                                <Label Text="{Binding DestinatarioNombre}" />
                                <Label Text="{Binding Direccion}" FontSize="13" />
                                <Label FontSize="12" TextColor="Gray">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ComercioNombre}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding CantidadBultos, StringFormat='{0} bulto(s)'}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Modalidad}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
