<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models"
             x:Class="UltimaMilla.Mobile.Pages.CargaVehiculoPage"
             x:DataType="vm:CargaVehiculoViewModel"
             Title="Cargar vehículo">

    <!-- Fila 0: la lista (con su cabecera). Fila 1: el botón Despachar, siempre visible abajo. -->
    <Grid RowDefinitions="*,Auto">

        <!-- En el celular ocupa todo el ancho; en tablet o Windows queda centrada -->
        <CollectionView ItemsSource="{Binding Bultos}" Margin="16,0"
                        WidthRequest="{OnIdiom Phone=-1, Default=680}"
                        HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- ===== CABECERA: hoja, progreso, escaneo y sobrantes ===== -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="0,16,0,4">

                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource PeligroSuave}"
                            Padding="12,8" HorizontalOptions="Fill" IsVisible="{Binding HayError}">
                        <Label Text="{Binding Error}" TextColor="{StaticResource Peligro}" FontSize="13" />
                    </Border>

                    <!-- 1. Elegir la hoja de ruta de hoy -->
                    <Label Text="Tus hojas de ruta de hoy" Style="{StaticResource Seccion}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Hojas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HojaDeRutaItem">
                                <Border Style="{StaticResource Tarjeta}" Padding="16,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CargaVehiculoViewModel}}, Path=ElegirHojaCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                WidthRequest="44" HeightRequest="44"
                                                BackgroundColor="{StaticResource AzulClaro}">
                                            <Label Text="🗺️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="16" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Secundario}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="›" FontSize="26" VerticalOptions="Center"
                                               TextColor="{StaticResource Gray400}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- 2. Progreso de la carga de la hoja elegida -->
                    <Border Style="{StaticResource Hero}" IsVisible="{Binding HayHojaElegida}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Cargando" TextColor="#CFE0F5" FontSize="13" />
                            <Label Text="{Binding HojaElegida.Titulo}" TextColor="White"
                                   FontFamily="OpenSansSemibold" FontSize="22" />
                            <ProgressBar Progress="{Binding Progreso}" ProgressColor="White" />
                            <Label Text="{Binding TextoProgreso}" TextColor="#E3EEFA" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Escanear: con lector entra solo; en el emulador se escribe y Enter -->
                    <Border Style="{StaticResource Tarjeta}" Padding="14" IsVisible="{Binding HayHojaElegida}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Escaneá o escribí el código del bulto" Style="{StaticResource EtiquetaCampo}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource Campo}">
                                    <Entry x:Name="CampoCodigo"
                                           Placeholder="Ej. PED-300-1"
                                           Text="{Binding Codigo}"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding AgregarCodigoCommand}"
                                           Completed="AlConfirmarCodigo" />
                                </Border>
                                <Button Grid.Column="1" Text="Agregar" Style="{StaticResource BotonSecundario}"
                                        Command="{Binding AgregarCodigoCommand}" Clicked="AlConfirmarCodigo" />
                            </Grid>

                            <!-- Respuesta a la última lectura: verde si está bien, roja si sobra -->
                            <Label Text="{Binding Mensaje}" FontFamily="OpenSansSemibold" FontSize="14"
                                   IsVisible="{Binding HayMensaje}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding MensajeEsAlerta}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Peligro}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding MensajeEsAlerta}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource Exito}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. Sobrantes (RF 19): bultos que no son de esta ruta -->
                    <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource PeligroSuave}"
                            Stroke="{StaticResource PeligroSuave}" Padding="14" IsVisible="{Binding HaySobrantes}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="⚠  Sobran en el vehículo: no son de esta ruta"
                                   TextColor="{StaticResource Peligro}" FontFamily="OpenSansSemibold" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Sobrantes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding .}" FontFamily="OpenSansSemibold" VerticalOptions="Center"
                                                   TextColor="{StaticResource Peligro}" />
                                            <Button Grid.Column="1" Text="Ya lo bajé" Style="{StaticResource BotonSecundario}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CargaVehiculoViewModel}}, Path=QuitarSobranteCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Bultos de la hoja" Style="{StaticResource Seccion}"
                           IsVisible="{Binding HayHojaElegida}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ===== Cada bulto esperado: ✅ cargado o ⏳ falta ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BultoCarga">
                    <Border Style="{StaticResource Tarjeta}" Padding="14,12" Margin="0,5">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="{Binding Icono}" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Codigo}" FontFamily="OpenSansSemibold" FontSize="16" />
                                <Label Style="{StaticResource Secundario}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Referencia}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Destinatario}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding TextoEstado}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ContentView HeightRequest="16" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ===== Despachar: barra fija abajo; se habilita solo con la carga completa ===== -->
        <Border Grid.Row="1" StrokeThickness="0" Padding="16,12,16,16" IsVisible="{Binding HayHojaElegida}"
                BackgroundColor="{AppThemeBinding Light={StaticResource FondoTarjeta}, Dark={StaticResource FondoTarjetaOscuro}}">
            <Border.Shadow>
                <Shadow Brush="#0F2A4A" Opacity="0.08" Radius="16" Offset="0,-4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="8"
                                 WidthRequest="{OnIdiom Phone=-1, Default=680}"
                                 HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">
                <Label HorizontalTextAlignment="Center" Style="{StaticResource Secundario}"
                       Text="{Binding TextoDespacho}" />
                <Button Text="🚚  Despachar ruta" Style="{StaticResource BotonPrimario}"
                        Command="{Binding DespacharCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
