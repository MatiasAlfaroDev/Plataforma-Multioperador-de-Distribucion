<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:app="clr-namespace:UltimaMilla.Mobile"
             x:Class="UltimaMilla.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Iniciar sesión">

    <ScrollView>
        <!-- En el celular ocupa todo el ancho; en tablet o Windows queda centrado -->
        <VerticalStackLayout Padding="24,56,24,24" Spacing="28"
                             WidthRequest="{OnIdiom Phone=-1, Default=440}"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">
            
            <!-- Marca -->
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Image Source="logo.png" WidthRequest="40" HeightRequest="40" />
                <Label Text="Última Milla" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Iniciá sesión" Style="{StaticResource Titulo}" />
                <Label Text="Usá la cuenta que te dio tu operador." Style="{StaticResource Secundario}" FontSize="15" />
            </VerticalStackLayout>

            <!-- Formulario -->
            <VerticalStackLayout Spacing="18">
                
                <!-- Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" Style="{StaticResource EtiquetaCampo}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Placeholder="nombre@empresa.com" Keyboard="Email" Text="{Binding Email}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Contraseña -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Contraseña" Style="{StaticResource EtiquetaCampo}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Password}" IsPassword="True"
                               ReturnType="Go" ReturnCommand="{Binding IniciarSesionCommand}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Error -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PeligroSuave}, Dark={StaticResource PeligroSuaveOscuro}}"
                        IsVisible="{Binding HayError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Style="{StaticResource Icono}" Text="{x:Static app:Iconos.Advertencia}"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
                        <Label Grid.Column="1" Text="{Binding Error}"
                               TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}"
                               FontSize="14" />
                    </Grid>
                </Border>

                <!-- Botón Entrar -->
                <Grid>
                    <Button Text="Entrar" Style="{StaticResource BotonPrimario}"
                            Command="{Binding IniciarSesionCommand}" />
                    <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}"
                                       Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                       HorizontalOptions="End" Margin="0,0,16,0"
                                       HeightRequest="22" WidthRequest="22" />
                </Grid>

            </VerticalStackLayout>

            <!-- Sin señal -->
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />

            <VerticalStackLayout Spacing="0" HorizontalOptions="Start">
                <Label Text="¿Sin señal?" Style="{StaticResource Secundario}" />
                <Button Text="Trabajar con la ruta guardada" Style="{StaticResource BotonTexto}"
                        Command="{Binding TrabajarSinConexionCommand}" HorizontalOptions="Start" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
