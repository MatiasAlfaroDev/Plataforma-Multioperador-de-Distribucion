<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models"
             x:Class="UltimaMilla.Mobile.Pages.SeleccionOperadorPage"
             x:DataType="vm:SeleccionOperadorViewModel"
             Title="Repartidor">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Actualizar" Command="{Binding CargarCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding CargarCommand}" IsRefreshing="{Binding EstaCargando}">
        <!-- En el celular ocupa todo el ancho; en tablet o Windows queda centrada -->
        <CollectionView ItemsSource="{Binding Operadores}" Margin="16,0"
                        WidthRequest="{OnIdiom Phone=-1, Default=680}"
                        HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- ===== Bienvenida ===== -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="0,16,0,8">
                    <Border Style="{StaticResource Hero}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📦" FontSize="34" />
                            <Label Text="¡Hola!" TextColor="White" FontFamily="OpenSansSemibold" FontSize="26" />
                            <Label Text="¿Para qué operador repartís hoy?" TextColor="#CFE0F5" FontSize="15" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource PeligroSuave}"
                            Padding="12,8" HorizontalOptions="Fill" IsVisible="{Binding HayError}">
                        <Label Text="{Binding Error}" TextColor="{StaticResource Peligro}" FontSize="13" />
                    </Border>
                    <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource AlertaSuave}"
                            Stroke="{StaticResource AlertaSuave}" Padding="14,10" IsVisible="{Binding HayAviso}">
                        <Label Text="{Binding Aviso, StringFormat='📡 {0}'}" TextColor="{StaticResource Alerta}" FontSize="13" />
                    </Border>

                    <Label Text="Operadores" Style="{StaticResource Seccion}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🔌" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="No hay operadores" Style="{StaticResource Titulo}" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="¿La API está levantada? Tocá «Actualizar» para reintentar."
                           Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- ===== Tarjeta de cada operador ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OperadorItem">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,6" Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeleccionOperadorViewModel}}, Path=ElegirCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <!-- Círculo con la inicial, en el color de marca del operador -->
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="52" HeightRequest="52"
                                    BackgroundColor="{Binding ColorMarca}">
                                <Label Text="{Binding Inicial}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="20"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="17" />
                                <Label Text="Tocá para ver tu ruta" Style="{StaticResource Secundario}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="28" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Text="Provisorio: el operador saldrá del inicio de sesión." Style="{StaticResource Secundario}"
                       FontSize="12" HorizontalOptions="Center" Margin="0,16,0,24" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
