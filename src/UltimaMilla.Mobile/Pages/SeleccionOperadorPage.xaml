<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models"
             xmlns:app="clr-namespace:UltimaMilla.Mobile"
             x:Class="UltimaMilla.Mobile.Pages.SeleccionOperadorPage"
             x:DataType="vm:SeleccionOperadorViewModel"
             Title="Repartidor">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Actualizar" Command="{Binding CargarCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding CargarCommand}" IsRefreshing="{Binding EstaCargando}">
        <!-- En el celular ocupa todo el ancho; en tablet o Windows queda centrada -->
        <CollectionView ItemsSource="{Binding Operadores}" Margin="16,0"
                        WidthRequest="{OnIdiom Phone=-1, Default=680}"
                        HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- ===== Bienvenida ===== -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="6" Padding="0,8,0,0">
                    <Label Text="Elegí el operador" Style="{StaticResource Titulo}" />
                    <Label Text="Vas a ver la ruta de hoy de ese operador." Style="{StaticResource Secundario}" FontSize="15" />

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PeligroSuave}, Dark={StaticResource PeligroSuaveOscuro}}"
                            IsVisible="{Binding HayError}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static app:Iconos.Advertencia}" 
                                    TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
                            <Label Text="{Binding Error}" 
                                    TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" 
                                    FontSize="13" Grid.Column="1" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AlertaSuave}, Dark={StaticResource AlertaSuaveOscuro}}"
                            IsVisible="{Binding HayAviso}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static app:Iconos.SinConexion}" 
                                    TextColor="{AppThemeBinding Light={StaticResource Alerta}, Dark={StaticResource AlertaOscuro}}" />
                            <Label Text="{Binding Aviso}" 
                                    TextColor="{AppThemeBinding Light={StaticResource Alerta}, Dark={StaticResource AlertaOscuro}}" 
                                    FontSize="14" Grid.Column="1" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="{x:Static app:Iconos.Operador}" Style="{StaticResource Icono}" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="No hay operadores" Style="{StaticResource Subtitulo}" HorizontalOptions="Center" />
                    <Label Text="¿La API está levantada? Tocá Actualizar para reintentar."
                           Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- ===== Tarjeta de cada operador ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OperadorItem">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,5" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeleccionOperadorViewModel}}, Path=ElegirCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <!-- Círculo con la inicial, en el color de marca del operador -->
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{Binding ColorMarca}">
                                <Label Text="{Binding Inicial}" TextColor="{StaticResource White}" FontFamily="Titulos" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{x:Static app:Iconos.Avanzar}" Style="{StaticResource Icono}" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Text="Provisorio: el operador saldrá del inicio de sesión." Style="{StaticResource Secundario}"
                       FontSize="12" HorizontalOptions="Start" Margin="2,16,0,24" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
