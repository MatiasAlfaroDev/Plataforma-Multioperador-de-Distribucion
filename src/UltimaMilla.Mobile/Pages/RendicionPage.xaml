<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models"
             xmlns:app="clr-namespace:UltimaMilla.Mobile"
             x:Class="UltimaMilla.Mobile.Pages.RendicionPage"
             x:DataType="vm:RendicionViewModel"
             Title="Rendir en el depósito">

    <!-- RF 22: la carga del vehículo al revés. Fila 0: la lista (con su cabecera). Fila 1: el botón Rendir, siempre visible abajo. -->
    <Grid RowDefinitions="*,Auto">

        <!-- En el celular ocupa todo el ancho; en tablet o Windows queda centrada -->
        <CollectionView ItemsSource="{Binding Bultos}" Margin="16,0"
                        WidthRequest="{OnIdiom Phone=-1, Default=680}"
                        HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- ===== CABECERA: hoja, progreso, escaneo y sobrantes ===== -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="0,16,0,4">

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,10" IsVisible="{Binding HayError}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PeligroSuave}, Dark={StaticResource PeligroSuaveOscuro}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icono}" Text="{x:Static app:Iconos.Advertencia}" 
                                    TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
                            <Label Text="{Binding Error}" 
                                    TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" 
                                    FontSize="14" Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- 1. Elegir la hoja de ruta de hoy -->
                    <Label Text="Hojas de ruta para rendir" Style="{StaticResource Seccion}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Hojas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HojaDeRutaItem">
                                <Border Style="{StaticResource Tarjeta}" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RendicionViewModel}}, Path=ElegirHojaCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                WidthRequest="44" HeightRequest="44"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource AcentoSuave}, Dark={StaticResource AcentoSuaveOscuro}}">
                                            <Label Text="{x:Static app:Iconos.Mapa}" 
                                                    Style="{StaticResource Icono}" 
                                                    FontSize="22" 
                                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" 
                                                    HorizontalOptions="Center" 
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Secundario}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{x:Static app:Iconos.Avanzar}" 
                                                Style="{StaticResource Icono}" 
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- 2. Progreso de la rendición de la hoja elegida -->
                    <Border Style="{StaticResource Hero}" IsVisible="{Binding HayHojaElegida}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Rindiendo" Style="{StaticResource Secundario}" />
                            <Label Text="{Binding HojaElegida.Titulo}" Style="{StaticResource Titulo}" FontSize="24" />
                            <ProgressBar Progress="{Binding Progreso}" 
                                        ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding TextoProgreso}" Style="{StaticResource Cuerpo}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Escanear: con lector entra solo; en el emulador se escribe y Enter -->
                    <Border Style="{StaticResource Tarjeta}" Padding="14" IsVisible="{Binding HayHojaElegida}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Escaneá o escribí el código de cada bulto que bajás del vehículo" Style="{StaticResource EtiquetaCampo}" />

                            <!-- Con la cámara del celular (o una imagen guardada, para probar en el emulador) -->
                            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10" IsVisible="{Binding HayLectorCamara}">
                                <Button Text="Escanear" Style="{StaticResource BotonPrimario}"
                                        Command="{Binding EscanearCommand}" ContentLayout="Left,8">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="Iconos" Glyph="{x:Static app:Iconos.Camara}" Size="18"
                                                        Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </Button.ImageSource>
                                </Button>
                                <Button Grid.Column="1" Text="Imagen" Style="{StaticResource BotonSecundario}"
                                        Command="{Binding EscanearDesdeImagenCommand}" ContentLayout="Left,8">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="Iconos" Glyph="{x:Static app:Iconos.Imagen}" Size="18"
                                                        Color="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource Campo}">
                                    <Entry x:Name="CampoCodigo"
                                           Placeholder="Ej. PED-300-1"
                                           Text="{Binding Codigo}"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding AgregarCodigoCommand}"
                                           Completed="AlConfirmarCodigo" />
                                </Border>
                                <Button Grid.Column="1" Text="Agregar" Style="{StaticResource BotonSecundario}"
                                        Command="{Binding AgregarCodigoCommand}" Clicked="AlConfirmarCodigo" />
                            </Grid>

                            <!-- Respuesta a la última lectura: verde si está bien, roja si sobra -->
                            <Label Text="{Binding Mensaje}" FontFamily="TextoMedio" FontSize="14"
                                   IsVisible="{Binding HayMensaje}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding MensajeEsAlerta}" Value="True">
                                        <Setter Property="TextColor" 
                                                Value="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding MensajeEsAlerta}" Value="False">
                                        <Setter Property="TextColor" 
                                                Value="{AppThemeBinding Light={StaticResource Exito}, Dark={StaticResource ExitoOscuro}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. Sobrantes: escaneados que no tienen que volver con esta hoja -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="14" IsVisible="{Binding HaySobrantes}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PeligroSuave}, Dark={StaticResource PeligroSuaveOscuro}}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Style="{StaticResource Icono}" Text="{x:Static app:Iconos.Advertencia}" 
                                        TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
                                <Label Text="No tienen que volver con esta hoja" 
                                        FontFamily="TextoFuerte" 
                                        TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" 
                                        Grid.Column="1" />
                            </Grid>
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Sobrantes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding .}" Style="{StaticResource Codigo}" 
                                                    FontSize="15" 
                                                    TextColor="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
                                            <Button Grid.Column="1" Text="Quitar" Style="{StaticResource BotonSecundario}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RendicionViewModel}}, Path=QuitarSobranteCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 5. Paradas que el servidor todavía no tiene resueltas: no se rinde a ciegas -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="14" IsVisible="{Binding HaySinResultado}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AlertaSuave}, Dark={StaticResource AlertaSuaveOscuro}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Paradas sin resultado: registralas en la ruta y volvé" FontFamily="TextoFuerte"
                                   TextColor="{AppThemeBinding Light={StaticResource Alerta}, Dark={StaticResource AlertaOscuro}}" />
                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding SinResultado}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Alerta}, Dark={StaticResource AlertaOscuro}}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Lo que tiene que volver al depósito" Style="{StaticResource Seccion}"
                           IsVisible="{Binding HayHojaElegida}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ===== Cada bulto que tiene que volver: escaneado o falta (el ícono y su color salen de BultoCarga) ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BultoCarga">
                    <Border Style="{StaticResource Tarjeta}" Padding="14,12" Margin="0,5">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="{Binding Icono}" FontSize="24" 
                                    TextColor="{Binding ColorIcono}" 
                                    VerticalOptions="Center" 
                                    Style="{StaticResource Icono}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Codigo}" Style="{StaticResource Codigo}" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
                                <Label Style="{StaticResource Secundario}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Referencia}" />
                                            <Span Text=", " />
                                            <Span Text="{Binding Destinatario}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding TextoEstado}" Style="{StaticResource Secundario}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ContentView HeightRequest="16" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ===== Rendir: barra fija abajo; se habilita solo si coincide todo (RF 22) ===== -->
        <Border Grid.Row="1" StrokeThickness="0" IsVisible="{Binding HayHojaElegida}">
            <VerticalStackLayout Spacing="0">
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />
                <Border Padding="16,12,16,16" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FondoTarjeta}, Dark={StaticResource FondoTarjetaOscuro}}">
                    <VerticalStackLayout Spacing="8"
                                         WidthRequest="{OnIdiom Phone=-1, Default=680}"
                                         HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource Secundario}"
                               Text="{Binding TextoRendicion}" />
                        <Button Text="Rendir hoja de ruta" Style="{StaticResource BotonPrimario}"
                                Command="{Binding RendirCommand}" ContentLayout="Left,8">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="Iconos" Glyph="{x:Static app:Iconos.Caja}" Size="18"
                                                Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
