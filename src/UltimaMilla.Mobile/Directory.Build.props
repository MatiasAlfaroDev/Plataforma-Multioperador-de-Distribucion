<Project>
  <!--
    La app MAUI NO usa el Directory.Build.props de la raíz del repo: aquel fija
    TargetFramework=net10.0 y MAUI necesita varios (net10.0-android, net10.0-windows...).
    Al existir este archivo más cerca, MSBuild usa este y no el de la raíz.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
