<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta compartida con Portal y Backoffice (assets/marca): neutros zinc y un solo acento naranja.
         Los colores de estado (Exito, Peligro, Alerta) solo marcan estado, nunca decoran. -->
    <Color x:Key="Primary">#C2410C</Color>
    <Color x:Key="PrimaryDark">#F97316</Color>
    <Color x:Key="PrimaryDarkText">#431407</Color>
    <Color x:Key="Secondary">#FFEDD5</Color>
    <Color x:Key="SecondaryDarkText">#FDBA74</Color>
    <Color x:Key="Tertiary">#9A3412</Color>

    <Color x:Key="AcentoSuave">#FFEDD5</Color>
    <Color x:Key="AcentoSuaveOscuro">#2C1608</Color>

    <Color x:Key="Exito">#15803D</Color>
    <Color x:Key="ExitoOscuro">#4ADE80</Color>
    <Color x:Key="ExitoSuave">#DCFCE7</Color>
    <Color x:Key="ExitoSuaveOscuro">#0F2918</Color>
    <Color x:Key="Peligro">#B91C1C</Color>
    <Color x:Key="PeligroOscuro">#F87171</Color>
    <Color x:Key="PeligroSuave">#FEE2E2</Color>
    <Color x:Key="PeligroSuaveOscuro">#2C1313</Color>
    <Color x:Key="Alerta">#B45309</Color>
    <Color x:Key="AlertaOscuro">#FBBF24</Color>
    <Color x:Key="AlertaSuave">#FEF3C7</Color>
    <Color x:Key="AlertaSuaveOscuro">#2B1D08</Color>

    <Color x:Key="FondoPagina">#F4F4F5</Color>
    <Color x:Key="FondoPaginaOscuro">#0C0C0E</Color>
    <Color x:Key="FondoTarjeta">#FFFFFF</Color>
    <Color x:Key="FondoTarjetaOscuro">#18181B</Color>
    <Color x:Key="TextoPrincipal">#18181B</Color>
    <Color x:Key="TextoPrincipalOscuro">#F4F4F5</Color>
    <Color x:Key="TextoSecundario">#52525B</Color>
    <Color x:Key="TextoSecundarioOscuro">#A1A1AA</Color>
    <Color x:Key="Borde">#E4E4E7</Color>
    <Color x:Key="BordeOscuro">#27272A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#09090B</Color>
    <Color x:Key="OffBlack">#18181B</Color>

    <Color x:Key="Gray100">#F4F4F5</Color>
    <Color x:Key="Gray200">#E4E4E7</Color>
    <Color x:Key="Gray300">#D4D4D8</Color>
    <Color x:Key="Gray400">#A1A1AA</Color>
    <Color x:Key="Gray500">#71717A</Color>
    <Color x:Key="Gray600">#52525B</Color>
    <Color x:Key="Gray900">#18181B</Color>
    <Color x:Key="Gray950">#09090B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
