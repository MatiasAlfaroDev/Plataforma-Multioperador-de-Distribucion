    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoPagina}, Dark={StaticResource FondoPaginaOscuro}}" />
    </Style>

    <!-- Barra superior del color del fondo: el acento queda para las acciones -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoPagina}, Dark={StaticResource FondoPaginaOscuro}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoTarjeta}, Dark={StaticResource FondoTarjetaOscuro}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- ===== Estilos propios de la app del repartidor (se usan con Style="{StaticResource ...}") =====
         Radios fijos: tarjetas 16, controles 12, chips redondos. Sin degradados; sombras solo en lo que flota. -->

    <!-- Ancho máximo del contenido: en tablet o Windows la pantalla no se estira de borde a borde -->
    <x:Double x:Key="AnchoContenido">680</x:Double>

    <!-- Tarjeta: superficie con borde fino, sin sombra -->
    <Style TargetType="Border" x:Key="Tarjeta">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoTarjeta}, Dark={StaticResource FondoTarjetaOscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Resumen principal de la pantalla (ruta del día, progreso de la carga): una tarjeta con más aire -->
    <Style TargetType="Border" x:Key="Hero" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Recuadro de un contador dentro del resumen -->
    <Style TargetType="Border" x:Key="Contador">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoPagina}, Dark={StaticResource FondoPaginaOscuro}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Etiqueta chica con fondo de color (el estado del envío) -->
    <Style TargetType="Border" x:Key="Chip">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Caja de un campo de texto: la Entry va adentro, sin la línea de abajo de Android -->
    <Style TargetType="Border" x:Key="Campo">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoTarjeta}, Dark={StaticResource FondoTarjetaOscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource BordeOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,2" />
    </Style>

    <!-- Escala tipográfica: 28 / 17 / 15 / 13, con saltos marcados.
         Space Grotesk para títulos y cifras, IBM Plex Sans para todo lo demás. -->
    <Style TargetType="Label" x:Key="Titulo">
        <Setter Property="FontFamily" Value="Titulos" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="CharacterSpacing" Value="-0.6" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
    </Style>

    <Style TargetType="Label" x:Key="Subtitulo">
        <Setter Property="FontFamily" Value="TextoFuerte" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
    </Style>

    <!-- Título de sección ("Envíos", "Bultos de la hoja"): en minúscula, sin tracking abierto -->
    <Style TargetType="Label" x:Key="Seccion">
        <Setter Property="FontFamily" Value="TextoFuerte" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="2,12,0,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
    </Style>

    <Style TargetType="Label" x:Key="Cuerpo">
        <Setter Property="FontFamily" Value="Texto" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
    </Style>

    <Style TargetType="Label" x:Key="Secundario">
        <Setter Property="FontFamily" Value="Texto" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioOscuro}}" />
    </Style>

    <Style TargetType="Label" x:Key="EtiquetaCampo">
        <Setter Property="FontFamily" Value="TextoMedio" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
    </Style>

    <!-- Números grandes (contadores, progreso) y códigos de seguimiento -->
    <Style TargetType="Label" x:Key="Cifra">
        <Setter Property="FontFamily" Value="Titulos" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
    </Style>

    <Style TargetType="Label" x:Key="Codigo">
        <Setter Property="FontFamily" Value="Cifras" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioOscuro}}" />
    </Style>

    <!-- Ícono de Phosphor como texto: Text="{x:Static app:Iconos.Caja}" -->
    <Style TargetType="Label" x:Key="Icono">
        <Setter Property="FontFamily" Value="Iconos" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundario}, Dark={StaticResource TextoSecundarioOscuro}}" />
    </Style>

    <!-- Botón principal (Entrar, Despachar): el único lugar donde el acento es fondo -->
    <Style TargetType="Button" x:Key="BotonPrimario">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
        <Setter Property="FontFamily" Value="TextoFuerte" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Botón con borde (acciones secundarias: Cargar vehículo, Enviar ahora) -->
    <Style TargetType="Button" x:Key="BotonSecundario">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FondoTarjeta}, Dark={StaticResource FondoTarjetaOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoPrincipal}, Dark={StaticResource TextoPrincipalOscuro}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource BordeOscuro}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="TextoMedio" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <!-- Se mantiene la clave por compatibilidad: hoy el resumen es una tarjeta clara -->
    <Style TargetType="Button" x:Key="BotonSobreHero" BasedOn="{StaticResource BotonSecundario}" />

    <!-- Botón que parece un link (Trabajar sin conexión) -->
    <Style TargetType="Button" x:Key="BotonTexto">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontFamily" Value="TextoMedio" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0,10" />
    </Style>

    <!-- Entregado (verde lleno) y No entregado (rojo suave): el color es el estado que se va a registrar -->
    <Style TargetType="Button" x:Key="BotonExito">
        <Setter Property="BackgroundColor" Value="{StaticResource Exito}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="TextoFuerte" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="BotonPeligro">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PeligroSuave}, Dark={StaticResource PeligroSuaveOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Peligro}, Dark={StaticResource PeligroOscuro}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontFamily" Value="TextoFuerte" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

</ResourceDictionary>
