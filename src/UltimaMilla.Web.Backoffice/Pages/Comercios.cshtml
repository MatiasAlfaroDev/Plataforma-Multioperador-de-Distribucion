@page
@model UltimaMilla.Web.Backoffice.Pages.ComerciosModel

@{
    ViewData["Title"] = "Comercios";
}

<div class="pagina">
    <partial name="_Toast" model="(false, Model.Error)" />

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Comercios vinculados <span class="chip">@Model.Comercios.Count</span></h2>
        @if (Model.Comercios.Count == 0)
        {
            <p class="vacio">No hay comercios vinculados.</p>
        }
        else
        {
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr><th>Comercio</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Comercios)
                        {
                            var (estado, clase) = c.Estado == "Confirmada"
                                ? (c.Activa ? ("Activo", "chip chip-exito") : ("De baja", "chip chip-peligro"))
                                : (c.Estado, "chip");

                            <tr>
                                <td><b>@c.Nombre</b><span class="linea2">RUT @c.Rut</span></td>
                                <td><span class="@clase">@estado</span></td>
                                <td class="text-right">
                                    @if (c.Estado == "Confirmada")
                                    {
                                        var esBaja = c.Activa;

                                        <form method="post" asp-page-handler="@(esBaja ? "Baja" : "Reactivar")" class="formulario-comercio">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.CuentaId" />
                                            <button type="button" class="btn-chico @(esBaja ? "peligro" : "primario")"
                                                    data-accion="@(esBaja ? "baja" : "reactivar")" data-comercio="@c.Nombre">
                                                @(esBaja ? "Dar de baja" : "Reactivar")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<dialog id="modalComercio" class="modal-despacho" aria-labelledby="modalComercioTitulo" aria-describedby="modalComercioDescripcion">
    <h2 id="modalComercioTitulo" class="titulo-tarjeta"></h2>
    <p id="modalComercioDescripcion"></p>
    <div class="acciones-modal">
        <button type="button" id="cancelarComercio">Cancelar</button>
        <button type="button" id="confirmarComercio">Confirmar</button>
    </div>
</dialog>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("modalComercio");
        const titulo = document.getElementById("modalComercioTitulo");
        const descripcion = document.getElementById("modalComercioDescripcion");
        const confirmar = document.getElementById("confirmarComercio");
        let formularioActual = null;

        document.querySelectorAll(".formulario-comercio button").forEach(boton => {
            boton.addEventListener("click", () => {
                formularioActual = boton.closest("form");
                const comercio = boton.dataset.comercio;

                if (boton.dataset.accion === "baja") {
                    titulo.textContent = "Dar de baja el comercio";
                    descripcion.textContent = `¿Das de baja a "${comercio}"? No podrá crear envíos ni retiros nuevos; lo que está en curso no cambia.`;
                    confirmar.textContent = "Dar de baja";
                    confirmar.className = "peligro";
                } else {
                    titulo.textContent = "Reactivar el comercio";
                    descripcion.textContent = `¿Reactivás a "${comercio}"? Va a poder operar de nuevo.`;
                    confirmar.textContent = "Reactivar";
                    confirmar.className = "primario";
                }
                modal.showModal();
            });
        });

        document.getElementById("cancelarComercio").addEventListener("click", () => modal.close());
        modal.addEventListener("close", () => formularioActual = null);
        confirmar.addEventListener("click", () => {
            if (!formularioActual) return;
            confirmar.disabled = true;
            formularioActual.requestSubmit();
        });
    });
</script>
