@page
@model UltimaMilla.Web.Backoffice.Pages.ComerciosModel

@{
    ViewData["Title"] = "Comercios";
}

<div class="encabezado">
    <div>
        <h1>Comercios</h1>
        <p>Consultá, dá de baja o reactivá los comercios vinculados a tu operador y modificá su dirección de recepción.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <p class="aviso ok" role="status">@Model.Mensaje</p>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="aviso error" role="alert">@Model.Error</p>
}

@if (Model.Comercios.Count == 0)
{
    <p class="nota">No hay comercios vinculados.</p>
}
else
{
    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Comercio</th>
                    <th>RUT</th>
                    <th>Estado</th>
                    <th>Dirección de recepción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Comercios)
                {
                    var estado = c.Estado == "Confirmada"
                        ? (c.Activa ? "Activo" : "De baja")
                        : c.Estado;

                    <tr>
                        <td>@c.Nombre</td>
                        <td>@c.Rut</td>
                        <td>@estado</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(c.Calle))
                            {
                                <span>Sin configurar</span>
                            }
                            else
                            {
                                <span>@c.Calle @c.Numero, @c.Localidad, @c.Departamento</span>
                            }
                        </td>
                        <td>
                            @if (c.Estado == "Confirmada" && c.Activa)
                            {
                                <form method="post" asp-page-handler="Baja" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.CuentaId" />
                                    <button type="submit"
                                            class="peligro"
                                            onclick="return confirm('¿Dar de baja a este comercio? No podrá crear envíos ni retiros nuevos.');">
                                        Dar de baja
                                    </button>
                                </form>
                            }
                            else if (c.Estado == "Confirmada")
                            {
                                <form method="post" asp-page-handler="Reactivar" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.CuentaId" />
                                    <button type="submit" class="primario">Reactivar</button>
                                </form>
                            }

                            <details>
                                <summary>Modificar dirección</summary>
                                <form method="post" asp-page-handler="Direccion">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.CuentaId" />
                                    <label>Calle <input name="calle" value="@c.Calle" required /></label>
                                    <label>Número <input name="numero" value="@c.Numero" /></label>
                                    <label>Localidad <input name="localidad" value="@c.Localidad" required /></label>
                                    <label>Departamento <input name="departamento" value="@c.Departamento" required /></label>
                                    <button type="submit" class="primario">Guardar</button>
                                </form>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
