@page "{id:guid}"
@model UltimaMilla.Web.Backoffice.Pages.EditarZonaModel

@{
    ViewData["Title"] = "Editar zona";
}

<div class="pagina">
    <a asp-page="/Zonas" class="nota w-fit"><i class="ph ph-arrow-left"></i> Zonas</a>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    @if (Model.OperadorIdSesion != Guid.Empty)
    {
        <section class="tarjeta">
            <h1 class="titulo-tarjeta">Editar zona</h1>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="aviso error mb-4"></div>
                <p class="nota mb-4">Las coberturas y franjas que guardes reemplazan a las actuales. Una localidad no puede quedar en dos zonas del mismo departamento.</p>
                <partial name="_CamposZona" for="Formulario" />
                <div class="acciones">
                    <button type="submit" class="primario">Guardar cambios</button>
                    <a asp-page="/Zonas" class="btn-secundario">Cancelar</a>
                </div>
            </form>
        </section>
    }
</div>
