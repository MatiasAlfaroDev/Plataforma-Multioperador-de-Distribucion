@page
@model IndexModel
@using UltimaMilla.Web.Backoffice.Services

@{
    ViewData["Title"] = "Envíos";

    var hayRecepciones = Model.Envios.Any(
        e => e.Estado == "Admitido");

    var hayReprogramaciones = Model.Envios.Any(
        e => e.Estado == "EnDeposito" && e.IntentosRealizados > 0);
}

<div class="encabezado">
    <div>
        <h1>Envíos</h1>
        <p>Operador: <strong>@Model.OperadorNombre</strong></p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="aviso error" role="alert">
        @Model.Error
    </div>
}

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="aviso" role="status">@mensajeExito</div>
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="aviso error" role="alert">
        @mensajeError
    </div>
}

@if (Model.Retiros.Count > 0)
{
    <section>
        <h2>Retiros a domicilio</h2>

        <p class="nota">
            @string.Join(" · ",
                Model.Retiros
                    .GroupBy(r => r.Estado)
                    .Select(g => $"{g.Key}: {g.Count()}"))
        </p>

        <div class="tabla">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Motivo</th>
                        <th>Localidad</th>
                        <th>Bultos</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Retiros
                        .OrderBy(r => r.FechaSolicitada))
                    {
                        var accion = r.Estado switch
                        {
                        
                            "NoRetirado" =>
                                ("reprogramar", "Reprogramar"),

                            _ => default
                        };

                        <tr>
                            <td>
                                @r.FechaSolicitada.ToString("dd/MM/yyyy")
                            </td>

                            <td>@r.Motivo</td>

                            <td>@r.DomicilioRetiro.Localidad</td>

                            <td class="num">@r.Bultos.Count</td>

                            <td>
                                @switch (r.Estado)
                                {
                                    case "Solicitado":
                                        <span class="chip chip-acento">
                                            Solicitado
                                        </span>
                                        break;

                                    case "AsignadoARuta":
                                        <span class="chip chip-exito">
                                            Asignado a ruta
                                        </span>
                                        break;

                                    case "EnTransito":
                                        <span class="chip chip-acento">
                                            En tránsito
                                        </span>
                                        break;

                                    case "Retirado":
                                        <span class="chip chip-exito">
                                            Retirado
                                        </span>
                                        break;

                                    case "NoRetirado":
                                        <span class="chip chip-alerta">
                                            No retirado
                                        </span>
                                        break;

                                    case "EnDeposito":
                                        <span class="chip chip-alerta">
                                            En depósito
                                        </span>
                                        break;

                                    case "EntregadoAlComercio":
                                        <span class="chip chip-exito">
                                            Entregado al comercio
                                        </span>
                                        break;

                                    default:
                                        <span class="nota">@r.Estado</span>
                                        break;
                                }
                            </td>

                            <td class="text-right">
                                <a asp-page="/DetalleRetiro"
                                   asp-route-id="@r.Id"
                                   class="btn-secundario py-1.5 text-sm">
                                    Ver detalle
                                </a>

                                @if (r.Estado == "Retirado" && r.HojaDeRutaId is Guid hojaId)
                                {
                                    <a asp-page="/Rendicion"
                                    asp-route-hojaId="@hojaId"
                                    class="btn-secundario py-1.5 text-sm">
                                        Recibir en depósito
                                    </a>
                                }
                                else if (r.Estado == "EnDeposito")
                                {
                                    <a asp-page="/HojasDeRuta"
                                    asp-route-entregaRetiroId="@r.Id"
                                    class="btn-secundario py-1.5 text-sm">
                                        Asignar a segunda ruta
                                    </a>
                                }
                                else if (accion != default)
                                {
                                    <form method="post"
                                        asp-page-handler="Retiro"
                                        class="inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                            name="retiroId"
                                            value="@r.Id" />

                                        <input type="hidden"
                                            name="accion"
                                            value="@accion.Item1" />

                                        <button type="submit"
                                                class="primario py-1.5 text-sm">
                                            @accion.Item2
                                        </button>
                                    </form>
                                }
                                                                else if (r.Estado == "Solicitado")
                                {
                                    <a asp-page="/HojasDeRuta"
                                       class="btn-secundario py-1.5 text-sm">
                                        Asignar a ruta
                                    </a>
                                }
                                else
                                {
                                    <span class="nota">Sin acciones</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}


@if (Model.Envios.Count == 0)
{
    <p class="nota">
        No hay envíos. Da de alta uno desde el Portal del comercio.
    </p>
}
else
{
    <p class="nota">
        @(Model.Envios.Count == 1
            ? "1 envío"
            : $"{Model.Envios.Count} envíos")
    </p>

    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Referencia</th>
                    <th>Comercio</th>
                    <th>Destinatario</th>
                    <th>Dirección</th>
                    <th class="num">Bultos</th>
                    <th class="num">Peso (kg)</th>
                    <th>Modalidad</th>
                    <th>Estado</th>
                    <th class="num">Tarifa</th>
                    <th>Alta</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var e in Model.Envios)
                {
                    <tr>
                        <td class="codigo">@e.ReferenciaExterna</td>
                        <td>@e.ComercioNombre</td>
                        <td>@e.DestinatarioNombre</td>
                        <td>@e.Direccion</td>
                        <td class="num">@e.CantidadBultos</td>
                        <td class="num">@Formato.Numero(e.PesoTotalKg)</td>
                        <td>@Formato.Modalidad(e.Modalidad)</td>
                        <td>
                            @switch (e.Estado)
                            {
                                case "Admitido":
                                    <span class="chip chip-acento">Admitido</span>
                                    break;

                                case "EnDeposito":
                                    <span class="chip chip-alerta">En depósito</span>
                                    break;

                                case "AsignadoARuta":
                                    <span class="chip chip-exito">Asignado a ruta</span>
                                    break;

                                case "EnTransito":
                                    <span class="chip chip-acento">En tránsito</span>
                                    break;

                                case "Entregado":
                                    <span class="chip chip-exito">Entregado</span>
                                    break;

                                case "EntregadoParcialmente":
                                    <span class="chip chip-alerta">Entregado parcialmente</span>
                                    break;

                                case "NoEntregado":
                                    <span class="chip chip-alerta">No entregado</span>
                                    break;

                                case "Reprogramado":
                                    <span class="chip chip-alerta">Reprogramado</span>
                                    break;

                                case "EnDevolucion":
                                    <span class="chip chip-alerta">En devolución</span>
                                    break;

                                case "Devuelto":
                                    <span class="chip chip-exito">Devuelto</span>
                                    break;

                                case "Extraviado":
                                    <span class="chip chip-alerta">Extraviado</span>
                                    break;

                                default:
                                    <span class="nota">@e.Estado</span>
                                    break;
                            }
                        </td>
                        <td class="num">
                            @(e.TarifaCalculada is decimal tarifa
                                ? Formato.Moneda(tarifa)
                                : "Sin tarifa")
                        </td>
                        <td>@Formato.Hora(e.FechaAlta)</td>
                        <td class="text-right">
                        <a asp-page="/DetalleEnvio"
                            asp-route-id="@e.Id"
                            class="btn-secundario py-1.5 text-sm">
                                Ver detalle
                        </a>
                            @if (e.Estado == "Admitido")
                            {
                                <button type="button"
                                        class="abrir-recepcion primario py-1.5 text-sm"
                                        data-envio-id="@e.Id"
                                        data-referencia="@e.ReferenciaExterna"
                                        data-operador="@e.OperadorNombre"
                                        data-bultos="@e.CantidadBultos">
                                    Recibir en depósito
                                </button>
                            }

                            else if (e.Estado == "EnDeposito" &&
                                    e.IntentosRealizados == 0)
                            {
                                <a asp-page="/HojasDeRuta"
                                asp-route-envioId="@e.Id"
                                class="accion-asignar btn-secundario py-1.5 text-sm">
                                    Asignar a ruta
                                </a>
                            }
                           else if (e.Estado == "EnDeposito" &&
                                    e.UltimoMotivoRequiereDevolucion)
                            {
                                <button type="button"
                                        class="abrir-devolucion primario py-1.5 text-sm"
                                        data-envio-id="@e.Id"
                                        data-referencia="@e.ReferenciaExterna">
                                    Iniciar devolución
                                </button>
                            }
                            else if (e.Estado == "EnDeposito" &&
                                    e.IntentosRealizados > 0)
                            {
                                <button type="button"
                                        class="abrir-reprogramacion primario py-1.5 text-sm"
                                        data-envio-id="@e.Id"
                                        data-referencia="@e.ReferenciaExterna"
                                        data-intentos="@e.IntentosRealizados">
                                    Reprogramar
                                </button>
                            }
                            else if (e.Estado == "Reprogramado")
                            {
                                <a asp-page="/HojasDeRuta"
                                asp-route-envioId="@e.Id"
                                class="accion-asignar btn-secundario py-1.5 text-sm">
                                    Asignar a ruta
                                </a>
                            }

                            
                            else if (e.Estado == "AsignadoARuta")
                            {
                                <span class="accion-estado nota">Asignado a ruta</span>
                            }
                            else if (e.Estado == "EnDevolucion")
                            {
                                <a asp-page="/HojasDeRuta"
                                asp-route-devolucionId="@e.Id"
                                class="accion-asignar btn-secundario py-1.5 text-sm">
                                    Asignar devolución a ruta
                                </a>
                            }
                            else
                            {
                                <span class="nota">Sin acciones</span>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (hayRecepciones)
{
    <dialog id="modalRecepcion"
            class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
            aria-labelledby="tituloRecepcion">

        <form method="post"
              asp-page-handler="Recibir"
              id="formRecepcion">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="envioId"
                   id="recepcionEnvioId" />


            <div class="modal-encabezado flex items-start justify-between gap-4">
                <h2 id="tituloRecepcion" class="mt-0 font-display text-xl font-bold tracking-tight">
                    Recibir en depósito
                </h2>

                <button type="button"
                        class="cerrar-modal border-0 bg-transparent p-1 text-xl text-suave"
                        id="cerrarRecepcion"
                        aria-label="Cerrar">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="modal-info mt-4 grid gap-1 rounded-xl bg-hundido px-4 py-3 text-sm">
                <p>
                    <strong>Envío:</strong>
                    <span id="recepcionReferencia"></span>
                </p>

                <p>
                    <strong>Operador:</strong>
                    <span id="recepcionOperador"></span>
                </p>

                <p>
                    <strong>Bultos declarados:</strong>
                    <span id="recepcionBultos"></span>
                </p>
            </div>

            <div class="modal-campo">
                <label for="identificaciones">
                    Códigos de bultos escaneados
                </label>

                <textarea id="identificaciones"
                          name="identificaciones"
                          rows="4"
                          placeholder="Ingresá un código por línea"
                          required></textarea>

                <p class="nota mt-1.5">Ingresá todos los códigos de los bultos recibidos.</p>
            </div>


            <div class="modal-acciones acciones justify-end">
                <button type="button"
                        id="cancelarRecepcion"
                        class="boton-cancelar">
                    Cancelar
                </button>

                <button type="submit" class="primario">
                    Confirmar recepción
                </button>
            </div>
        </form>
    </dialog>

    <script>
        const modalRecepcion =
            document.getElementById("modalRecepcion");

        const formularioRecepcion =
            document.getElementById("formRecepcion");

        document.querySelectorAll(".abrir-recepcion")
            .forEach(boton => {
                boton.addEventListener("click", () => {
                    formularioRecepcion.reset();

                    document.getElementById(
                        "recepcionEnvioId"
                    ).value = boton.dataset.envioId;

                    document.getElementById(
                        "recepcionReferencia"
                    ).textContent = boton.dataset.referencia;

                    document.getElementById(
                        "recepcionOperador"
                    ).textContent = boton.dataset.operador;

                    document.getElementById(
                        "recepcionBultos"
                    ).textContent = boton.dataset.bultos;

                    modalRecepcion.showModal();
                });
            });

        document.getElementById("cerrarRecepcion")
            .addEventListener("click", () => {
                modalRecepcion.close();
            });

        document.getElementById("cancelarRecepcion")
            .addEventListener("click", () => {
                modalRecepcion.close();
            });
    </script>
}

<dialog id="modalDevolucion"
        class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
        aria-labelledby="tituloDevolucion">

    <form method="post"
          asp-page-handler="IniciarDevolucion"
          id="formDevolucion">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="envioId"
               id="devolucionEnvioId" />

        <div class="modal-encabezado flex items-start justify-between gap-4">
            <h2 id="tituloDevolucion"
                class="mt-0 font-display text-xl font-bold tracking-tight">
                Iniciar devolución
            </h2>

            <button type="button"
                    class="cerrar-devolucion border-0 bg-transparent p-1 text-xl text-suave"
                    aria-label="Cerrar">
                <i class="ph ph-x"></i>
            </button>
        </div>

        <div class="modal-info mt-4 grid gap-2 rounded-xl bg-hundido px-4 py-3 text-sm">
            <p>
                <strong>Envío:</strong>
                <span id="devolucionReferencia"></span>
            </p>

            <p>
                Este envío requiere devolución al comercio.
                ¿Confirmás que querés iniciar el proceso?
            </p>
        </div>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button"
                    class="cerrar-devolucion btn-secundario px-4 py-2">
                Cancelar
            </button>

            <button type="submit"
                    class="primario px-4 py-2">
                Confirmar devolución
            </button>
        </div>
    </form>
</dialog>

@if (hayReprogramaciones)
{
    <dialog id="modalReprogramacion"
            class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
            aria-labelledby="tituloReprogramacion">
        <form method="post" asp-page-handler="Reprogramar" id="formReprogramacion">
            @Html.AntiForgeryToken()
            <input type="hidden" name="envioId" id="reprogramacionEnvioId" />

            <div class="modal-encabezado flex items-start justify-between gap-4">
                <h2 id="tituloReprogramacion" class="mt-0 font-display text-xl font-bold tracking-tight">
                    Reprogramar envío
                </h2>
                <button type="button" id="cerrarReprogramacion"
                        class="cerrar-modal border-0 bg-transparent p-1 text-xl text-suave"
                        aria-label="Cerrar">×</button>
            </div>

            <div class="modal-info mt-4 grid gap-1 rounded-xl bg-hundido px-4 py-3 text-sm">
                <p><strong>Envío:</strong> <span id="reprogramacionReferencia"></span></p>
                <p><strong>Intentos realizados:</strong> <span id="reprogramacionIntentos"></span></p>
                <p class="nota">La API verificará las reglas operativas antes de permitir la reprogramación.</p>
            </div>

            <div class="modal-campo">
                <label for="responsableReprogramacion">Responsable de reprogramación</label>
                <input type="text" id="responsableReprogramacion"
                       name="responsable" maxlength="150"
                       placeholder="Nombre del responsable" required />
            </div>

            <div class="modal-acciones acciones justify-end">
                <button type="button" id="cancelarReprogramacion" class="boton-cancelar">
                    Cancelar
                </button>
                <button type="submit" class="primario" id="confirmarReprogramacion">
                    Confirmar reprogramación
                </button>
            </div>
        </form>
    </dialog>

    <script>
        (() => {
            const modal = document.getElementById("modalReprogramacion");
            const form = document.getElementById("formReprogramacion");
            document.querySelectorAll(".abrir-reprogramacion").forEach(boton => {
                boton.addEventListener("click", () => {
                    form.reset();
                    document.getElementById("reprogramacionEnvioId").value = boton.dataset.envioId;
                    document.getElementById("reprogramacionReferencia").textContent = boton.dataset.referencia;
                    document.getElementById("reprogramacionIntentos").textContent = boton.dataset.intentos;
                    modal.showModal();
                });
            });
            document.getElementById("cerrarReprogramacion")
                .addEventListener("click", () => modal.close());
            document.getElementById("cancelarReprogramacion")
                .addEventListener("click", () => modal.close());
            form.addEventListener("submit", () => {
                const boton = document.getElementById("confirmarReprogramacion");
                boton.disabled = true;
                boton.textContent = "Procesando...";
            });

            const modalDevolucion = document.getElementById("modalDevolucion");

if (modalDevolucion) {

    document.querySelectorAll(".abrir-devolucion")
        .forEach(boton => {

            boton.addEventListener("click", () => {

                document.getElementById("devolucionEnvioId").value =
                    boton.dataset.envioId;

                document.getElementById("devolucionReferencia").textContent =
                    boton.dataset.referencia;

                modalDevolucion.showModal();
            });
        });

    document.querySelectorAll(".cerrar-devolucion")
        .forEach(boton => {

            boton.addEventListener("click", () => {
                modalDevolucion.close();
            });
        });

    modalDevolucion.addEventListener("click", evento => {

        if (evento.target === modalDevolucion) {
            modalDevolucion.close();
        }
    });
}
        })();
    </script>
}

