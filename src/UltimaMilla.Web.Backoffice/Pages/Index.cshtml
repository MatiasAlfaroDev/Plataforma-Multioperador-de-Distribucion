@page
@model IndexModel
@using UltimaMilla.Web.Backoffice.Services

@{
    ViewData["Title"] = "Envíos";

    var hayRecepciones = Model.Envios.Any(
        e => e.Estado == "Admitido");
}

<div class="encabezado">
    <div>
        <h1>Envíos</h1>
        <p>Operador: <strong>@Model.OperadorNombre</strong></p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="aviso error" role="alert">
        @Model.Error
    </div>
}

@if (Model.Envios.Count == 0)
{
    <p class="nota">
        No hay envíos. Da de alta uno desde el Portal del comercio.
    </p>
}
else
{
    <p class="nota">
        @(Model.Envios.Count == 1
            ? "1 envío"
            : $"{Model.Envios.Count} envíos")
    </p>

    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Referencia</th>
                    <th>Comercio</th>
                    <th>Destinatario</th>
                    <th>Dirección</th>
                    <th class="num">Bultos</th>
                    <th class="num">Peso (kg)</th>
                    <th>Modalidad</th>
                    <th>Estado</th>
                    <th class="num">Tarifa</th>
                    <th>Alta</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var e in Model.Envios)
                {
                    <tr>
                        <td class="codigo">@e.ReferenciaExterna</td>
                        <td>@e.ComercioNombre</td>
                        <td>@e.DestinatarioNombre</td>
                        <td>@e.Direccion</td>
                        <td class="num">@e.CantidadBultos</td>
                        <td class="num">@Formato.Numero(e.PesoTotalKg)</td>
                        <td>@Formato.Modalidad(e.Modalidad)</td>                  
                        <td>
                            @switch (e.Estado)
                            {
                                case "Admitido":
                                    <span class="chip chip-acento">Admitido</span>
                                    break;

                                case "EnDeposito":
                                    <span class="chip chip-alerta">En depósito</span>
                                    break;

                                case "AsignadoARuta":
                                    <span class="chip chip-exito">Asignado a ruta</span>
                                    break;

                                case "EnTransito":
                                    <span class="chip chip-acento">En tránsito</span>
                                    break;

                                case "Entregado":
                                    <span class="chip chip-exito">Entregado</span>
                                    break;

                                case "EntregadoParcialmente":
                                    <span class="chip chip-alerta">Entregado parcialmente</span>
                                    break;

                                case "NoEntregado":
                                    <span class="chip chip-alerta">No entregado</span>
                                    break;

                                case "Reprogramado":
                                    <span class="chip chip-alerta">Reprogramado</span>
                                    break;

                                case "EnDevolucion":
                                    <span class="chip chip-alerta">En devolución</span>
                                    break;

                                case "Devuelto":
                                    <span class="chip chip-exito">Devuelto</span>
                                    break;

                                case "Extraviado":
                                    <span class="chip chip-alerta">Extraviado</span>
                                    break;

                                default:
                                    <span class="nota">@e.Estado</span>
                                    break;
                            }
                        </td>
                        <td class="num">
                            @(e.TarifaCalculada is decimal tarifa
                                ? Formato.Moneda(tarifa)
                                : "Sin tarifa")
                        </td>
                        <td>@Formato.Hora(e.FechaAlta)</td>
                        <td class="text-right">
                            @if (e.Estado == "Admitido")
                            {
                                <button type="button"
                                        class="abrir-recepcion primario py-1.5 text-sm"
                                        data-envio-id="@e.Id"
                                        data-referencia="@e.ReferenciaExterna"
                                        data-operador="@e.OperadorNombre"
                                        data-bultos="@e.CantidadBultos">
                                    Recibir en depósito
                                </button>
                            }
                            else if (e.Estado == "EnDeposito")
                            {
                               <a asp-page="/HojasDeRuta"
                                asp-route-envioId="@e.Id"
                                class="accion-asignar btn-secundario py-1.5 text-sm">
                                    Asignar a ruta
                                </a>
                            }
                            else if (e.Estado == "AsignadoARuta")
                            {
                                <span class="accion-estado nota">Asignado a ruta</span>
                            }
                            else
                            {
                                <span class="nota">Sin acciones</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (hayRecepciones)
{
    <dialog id="modalRecepcion"
            class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
            aria-labelledby="tituloRecepcion">

        <form method="post"
              asp-page-handler="Recibir"
              id="formRecepcion">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="envioId"
                   id="recepcionEnvioId" />


            <div class="modal-encabezado flex items-start justify-between gap-4">
                <h2 id="tituloRecepcion" class="mt-0 font-display text-xl font-bold tracking-tight">
                    Recibir en depósito
                </h2>

                <button type="button"
                        class="cerrar-modal border-0 bg-transparent p-1 text-xl text-suave"
                        id="cerrarRecepcion"
                        aria-label="Cerrar">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="modal-info mt-4 grid gap-1 rounded-xl bg-hundido px-4 py-3 text-sm">
                <p>
                    <strong>Envío:</strong>
                    <span id="recepcionReferencia"></span>
                </p>

                <p>
                    <strong>Operador:</strong>
                    <span id="recepcionOperador"></span>
                </p>

                <p>
                    <strong>Bultos declarados:</strong>
                    <span id="recepcionBultos"></span>
                </p>
            </div>

            <div class="modal-campo">
                <label for="identificaciones">
                    Códigos de bultos escaneados
                </label>

                <textarea id="identificaciones"
                          name="identificaciones"
                          rows="4"
                          placeholder="Ingresá un código por línea"
                          required></textarea>

                <p class="nota mt-1.5">Ingresá todos los códigos de los bultos recibidos.</p>
            </div>

            <div class="modal-campo">
                <label for="responsable">
                    Responsable de recepción
                </label>

                <input type="text"
                       id="responsable"
                       name="responsable"
                       placeholder="Nombre del operario"
                       required />

                <p class="nota mt-1.5">Provisorio hasta implementar la identificación de usuarios.</p>
            </div>

            <div class="modal-acciones acciones justify-end">
                <button type="button"
                        id="cancelarRecepcion"
                        class="boton-cancelar">
                    Cancelar
                </button>

                <button type="submit" class="primario">
                    Confirmar recepción
                </button>
            </div>
        </form>
    </dialog>

    <script>
        const modalRecepcion =
            document.getElementById("modalRecepcion");

        const formularioRecepcion =
            document.getElementById("formRecepcion");

        document.querySelectorAll(".abrir-recepcion")
            .forEach(boton => {
                boton.addEventListener("click", () => {
                    formularioRecepcion.reset();

                    document.getElementById(
                        "recepcionEnvioId"
                    ).value = boton.dataset.envioId;

                    document.getElementById(
                        "recepcionReferencia"
                    ).textContent = boton.dataset.referencia;

                    document.getElementById(
                        "recepcionOperador"
                    ).textContent = boton.dataset.operador;

                    document.getElementById(
                        "recepcionBultos"
                    ).textContent = boton.dataset.bultos;

                    modalRecepcion.showModal();
                });
            });

        document.getElementById("cerrarRecepcion")
            .addEventListener("click", () => {
                modalRecepcion.close();
            });

        document.getElementById("cancelarRecepcion")
            .addEventListener("click", () => {
                modalRecepcion.close();
            });
    </script>
}
