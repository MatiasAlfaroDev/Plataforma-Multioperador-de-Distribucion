@page
@model IndexModel
@using UltimaMilla.Web.Backoffice.Services
@{
    ViewData["Title"] = "Envíos";
}

<h1>Envíos</h1>

<form method="get" class="filtro">
    <div>
        <label for="operador">Operador</label>
        <select id="operador" name="operadorId">
            <option value="">Todos</option>
            @foreach (var o in Model.Operadores)
            {
                <option value="@o.Id" selected="@(Model.OperadorId == o.Id)">@o.Nombre</option>
            }
        </select>
    </div>
    <button type="submit">Ver</button>
</form>

@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
else if (Model.Envios.Count == 0)
{
    <p>No hay envíos. Da de alta uno desde el Portal del comercio.</p>
}
else
{
    <p class="nota">@(Model.Envios.Count == 1 ? "1 envío" : $"{Model.Envios.Count} envíos")</p>
    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Referencia</th><th>Operador</th><th>Comercio</th><th>Destinatario</th>
                    <th>Dirección</th><th class="num">Bultos</th><th class="num">Peso (kg)</th><th>Modalidad</th><th>Estado</th><th class="num">Tarifa</th><th>Alta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Envios)
                {
                    <tr>
                        <td>@e.ReferenciaExterna</td>
                        <td><span class="operador" style="background:@Model.ColorDe(e.OperadorId)"></span>@e.OperadorNombre</td>
                        <td>@e.ComercioNombre</td>
                        <td>@e.DestinatarioNombre</td>
                        <td>@e.Direccion</td>
                        <td class="num">@e.CantidadBultos</td>
                        <td class="num">@Formato.Numero(e.PesoTotalKg)</td>
                        <td>@Formato.Modalidad(e.Modalidad)</td>
                        <td>@e.Estado</td>
                        <td class="num">@(e.TarifaCalculada is decimal t ? Formato.Moneda(t) : "Sin tarifa")</td>
                        <td>@Formato.Hora(e.FechaAlta)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
