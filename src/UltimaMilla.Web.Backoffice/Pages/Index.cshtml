@page
@model IndexModel
@using UltimaMilla.Web.Backoffice.Services

@{
    ViewData["Title"] = "Envíos";

    var hayRecepciones = Model.Envios.Any(
        e => e.Estado == "Admitido");

    var hayReprogramaciones = Model.Envios.Any(
        e => e.Estado == "EnDeposito" && e.IntentosRealizados > 0);
}

<div class="pagina">
    @if (Model.Error is not null)
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    @if (Model.SolicitudesPendientes.Count > 0)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Reprogramaciones pendientes <span class="chip chip-alerta">@Model.SolicitudesPendientes.Count</span></h2>
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr>
                            <th>Envío</th>
                            <th>Solicitada</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in Model.SolicitudesPendientes)
                        {
                            var referencia = Model.Envios.FirstOrDefault(e => e.Id == solicitud.EnvioId)?.ReferenciaExterna
                                ?? solicitud.EnvioId.ToString();

                            <tr>
                                <td><b class="codigo">@referencia</b></td>
                                <td>@Formato.Hora(solicitud.SolicitadaEn)</td>
                                <td><span class="chip chip-alerta">@solicitud.Estado</span></td>
                                <td class="text-right">
                                    <button type="button" class="abrir-aceptacion primario btn-chico"
                                            data-solicitud-id="@solicitud.Id" data-referencia="@referencia">
                                        Aceptar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="tarjeta">
        <div class="cabecera-tarjeta">
            <h2 class="titulo-tarjeta">Envíos <span class="chip">@Model.Envios.Count</span></h2>
            <span class="nota">@Model.OperadorNombre</span>
        </div>

        @if (Model.Retiros.Count > 0)
        {
            <p class="nota mb-4 flex flex-wrap items-center gap-2">
                <i class="ph ph-house-line"></i>
                Retiros a domicilio:
                @string.Join(" · ", Model.Retiros.GroupBy(r => r.Estado).Select(g => $"{Formato.EstadoRetiro(g.Key)}: {g.Count()}"))
                <a asp-page="/Retiros">Ver retiros</a>
            </p>
        }

        @if (Model.Envios.Count == 0)
        {
            <p class="vacio">No hay envíos. Los comercios los dan de alta desde el Portal.</p>
        }
        else
        {
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr>
                            <th>Envío</th>
                            <th>Destinatario</th>
                            <th>Carga</th>
                            <th>Estado</th>
                            <th class="num">Tarifa</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Envios)
                        {
                            <tr>
                                <td>
                                    <b class="codigo">@e.ReferenciaExterna</b>
                                    <span class="linea2">@e.ComercioNombre · @Formato.Hora(e.FechaAlta)</span>
                                </td>
                                <td>
                                    @e.DestinatarioNombre
                                    <span class="linea2">@e.Direccion</span>
                                </td>
                                <td>
                                    @(e.CantidadBultos == 1 ? "1 bulto" : $"{e.CantidadBultos} bultos") · @Formato.Numero(e.PesoTotalKg) kg
                                    <span class="linea2">@Formato.Modalidad(e.Modalidad)</span>
                                </td>
                                <td><span class="@Formato.ClaseEstado(e.Estado)">@Formato.Estado(e.Estado)</span></td>
                                <td class="num">@(e.TarifaCalculada is decimal tarifa ? Formato.Moneda(tarifa) : "Sin tarifa")</td>
                                <td>
                                    <div class="flex items-center justify-end gap-2">
                                        @if (e.Estado == "Admitido")
                                        {
                                            <button type="button" class="abrir-recepcion primario btn-chico"
                                                    data-envio-id="@e.Id" data-referencia="@e.ReferenciaExterna"
                                                    data-operador="@e.OperadorNombre" data-bultos="@e.CantidadBultos">
                                                Recibir en depósito
                                            </button>
                                        }
                                        else if (e.Estado == "EnDeposito" && e.IntentosRealizados == 0)
                                        {
                                            <a asp-page="/HojasDeRuta" asp-route-envioId="@e.Id" class="accion-asignar btn-secundario btn-chico">Asignar a ruta</a>
                                        }
                                        else if (e.Estado == "EnDeposito" && Model.SolicitudesPendientes.Any(s => s.EnvioId == e.Id))
                                        {
                                            <span class="chip chip-alerta">Solicitud pendiente</span>
                                        }
                                        else if (e.Estado == "EnDeposito" && e.IntentosRealizados > 0)
                                        {
                                            <button type="button" class="abrir-reprogramacion primario btn-chico"
                                                    data-envio-id="@e.Id" data-referencia="@e.ReferenciaExterna"
                                                    data-intentos="@e.IntentosRealizados">
                                                Reprogramar
                                            </button>
                                        }
                                        else if (e.Estado == "Reprogramado")
                                        {
                                            <a asp-page="/HojasDeRuta" asp-route-envioId="@e.Id" class="accion-asignar btn-secundario btn-chico">Asignar a ruta</a>
                                        }
                                        else if (e.Estado == "EnDevolucion")
                                        {
                                            <a asp-page="/HojasDeRuta" asp-route-devolucionId="@e.Id" class="accion-asignar btn-secundario btn-chico">Asignar devolución</a>
                                        }
                                        else if (e.Estado == "Extraviado")
                                        {
                                            <a asp-page="/DetalleEnvio" asp-route-id="@e.Id" asp-fragment="reaparicion" class="accion-asignar btn-primario btn-chico">Registrar reaparición</a>
                                        }
                                        <a asp-page="/DetalleEnvio" asp-route-id="@e.Id" class="btn-secundario btn-chico" title="Ver detalle">
                                            <i class="ph ph-caret-right"></i>Detalle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (Model.SolicitudesPendientes.Count > 0)
{
    <dialog id="modalAceptarReprogramacion"
            class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
            aria-labelledby="tituloAceptarReprogramacion">

        <form method="post" asp-page-handler="AceptarReprogramacion">
            @Html.AntiForgeryToken()

            <input type="hidden" name="solicitudId" id="aceptarSolicitudId" />

            <div class="modal-encabezado flex items-start justify-between gap-4">
                <h2 id="tituloAceptarReprogramacion" class="mt-0 font-display text-xl font-bold tracking-tight">
                    Confirmar reprogramación
                </h2>

                <button type="button"
                        id="cerrarAceptarReprogramacion"
                        class="cerrar-modal border-0 bg-transparent p-1 text-xl text-suave"
                        aria-label="Cerrar">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="modal-info mt-4 grid gap-2 rounded-xl bg-hundido px-4 py-3 text-sm">
                <p><strong>Envío:</strong> <span id="aceptarReferencia"></span></p>
                <p>¿Confirmás que querés aceptar esta reprogramación?</p>
                <p class="nota">El envío pasará a Reprogramado y podrá asignarse a una nueva ruta.</p>
            </div>

            <div class="modal-acciones acciones justify-end">
                <button type="button" id="cancelarAceptarReprogramacion" class="boton-cancelar">
                    Cancelar
                </button>

                <button type="submit" class="primario">
                    Aceptar reprogramación
                </button>
            </div>
        </form>
    </dialog>

    <script>
        (() => {
            const modal = document.getElementById("modalAceptarReprogramacion");

            document.querySelectorAll(".abrir-aceptacion").forEach(boton => {
                boton.addEventListener("click", () => {
                    document.getElementById("aceptarSolicitudId").value = boton.dataset.solicitudId;
                    document.getElementById("aceptarReferencia").textContent = boton.dataset.referencia;
                    modal.showModal();
                });
            });

            document.getElementById("cerrarAceptarReprogramacion")
                .addEventListener("click", () => modal.close());
            document.getElementById("cancelarAceptarReprogramacion")
                .addEventListener("click", () => modal.close());
        })();
    </script>
}

@if (hayRecepciones)
{
    <dialog id="modalRecepcion"
            class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
            aria-labelledby="tituloRecepcion">

        <form method="post"
              asp-page-handler="Recibir"
              id="formRecepcion">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="envioId"
                   id="recepcionEnvioId" />


            <div class="modal-encabezado flex items-start justify-between gap-4">
                <h2 id="tituloRecepcion" class="mt-0 font-display text-xl font-bold tracking-tight">
                    Recibir en depósito
                </h2>

                <button type="button"
                        class="cerrar-modal border-0 bg-transparent p-1 text-xl text-suave"
                        id="cerrarRecepcion"
                        aria-label="Cerrar">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <div class="modal-info mt-4 grid gap-1 rounded-xl bg-hundido px-4 py-3 text-sm">
                <p>
                    <strong>Envío:</strong>
                    <span id="recepcionReferencia"></span>
                </p>

                <p>
                    <strong>Operador:</strong>
                    <span id="recepcionOperador"></span>
                </p>

                <p>
                    <strong>Bultos declarados:</strong>
                    <span id="recepcionBultos"></span>
                </p>
            </div>

            <div class="modal-campo">
                <label for="identificaciones">
                    Códigos de bultos escaneados
                </label>

                <textarea id="identificaciones"
                          name="identificaciones"
                          rows="4"
                          placeholder="Ingresá un código por línea"
                          required></textarea>

                <p class="nota mt-1.5">Ingresá todos los códigos de los bultos recibidos.</p>
            </div>

            <div class="modal-acciones acciones justify-end">
                <button type="button"
                        id="cancelarRecepcion"
                        class="boton-cancelar">
                    Cancelar
                </button>

                <button type="submit" class="primario">
                    Confirmar recepción
                </button>
            </div>
        </form>
    </dialog>

    <script>
        const modalRecepcion =
            document.getElementById("modalRecepcion");

        const formularioRecepcion =
            document.getElementById("formRecepcion");

        document.querySelectorAll(".abrir-recepcion")
            .forEach(boton => {
                boton.addEventListener("click", () => {
                    formularioRecepcion.reset();

                    document.getElementById(
                        "recepcionEnvioId"
                    ).value = boton.dataset.envioId;

                    document.getElementById(
                        "recepcionReferencia"
                    ).textContent = boton.dataset.referencia;

                    document.getElementById(
                        "recepcionOperador"
                    ).textContent = boton.dataset.operador;

                    document.getElementById(
                        "recepcionBultos"
                    ).textContent = boton.dataset.bultos;

                    modalRecepcion.showModal();
                });
            });

        document.getElementById("cerrarRecepcion")
            .addEventListener("click", () => {
                modalRecepcion.close();
            });

        document.getElementById("cancelarRecepcion")
            .addEventListener("click", () => {
                modalRecepcion.close();
            });
    </script>
}

@if (hayReprogramaciones)
{
    <dialog id="modalReprogramacion"
            class="modal-recepcion w-[min(32rem,calc(100vw-2rem))] m-auto"
            aria-labelledby="tituloReprogramacion">
        <form method="post" asp-page-handler="Reprogramar" id="formReprogramacion">
            @Html.AntiForgeryToken()
            <input type="hidden" name="envioId" id="reprogramacionEnvioId" />

            <div class="modal-encabezado flex items-start justify-between gap-4">
                <h2 id="tituloReprogramacion" class="mt-0 font-display text-xl font-bold tracking-tight">
                    Reprogramar envío
                </h2>
                <button type="button" id="cerrarReprogramacion"
                        class="cerrar-modal border-0 bg-transparent p-1 text-xl text-suave"
                        aria-label="Cerrar"><i class="ph ph-x"></i></button>
            </div>

            <div class="modal-info mt-4 grid gap-1 rounded-xl bg-hundido px-4 py-3 text-sm">
                <p><strong>Envío:</strong> <span id="reprogramacionReferencia"></span></p>
                <p><strong>Intentos realizados:</strong> <span id="reprogramacionIntentos"></span></p>
                <p class="nota">La API verificará las reglas operativas antes de permitir la reprogramación.</p>
            </div>

            <div class="modal-acciones acciones justify-end">
                <button type="button" id="cancelarReprogramacion" class="boton-cancelar">
                    Cancelar
                </button>
                <button type="submit" class="primario" id="confirmarReprogramacion">
                    Confirmar reprogramación
                </button>
            </div>
        </form>
    </dialog>

    <script>
        (() => {
            const modal = document.getElementById("modalReprogramacion");
            const form = document.getElementById("formReprogramacion");
            document.querySelectorAll(".abrir-reprogramacion").forEach(boton => {
                boton.addEventListener("click", () => {
                    form.reset();
                    document.getElementById("reprogramacionEnvioId").value = boton.dataset.envioId;
                    document.getElementById("reprogramacionReferencia").textContent = boton.dataset.referencia;
                    document.getElementById("reprogramacionIntentos").textContent = boton.dataset.intentos;
                    modal.showModal();
                });
            });
            document.getElementById("cerrarReprogramacion")
                .addEventListener("click", () => modal.close());
            document.getElementById("cancelarReprogramacion")
                .addEventListener("click", () => modal.close());
            form.addEventListener("submit", () => {
                const boton = document.getElementById("confirmarReprogramacion");
                boton.disabled = true;
                boton.textContent = "Procesando...";
            });
        })();
    </script>
}

