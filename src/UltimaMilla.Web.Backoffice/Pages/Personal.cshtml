@page
@model UltimaMilla.Web.Backoffice.Pages.PersonalModel

@{
    ViewData["Title"] = "Personal";
}

<div class="pagina">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Personal <span class="chip">@Model.Personal.Count</span></h2>
        @if (Model.Personal.Count == 0)
        {
            <p class="vacio">Todavía no hay personal dado de alta.</p>
        }
        else
        {
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr><th>Nombre</th><th>Perfil</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Personal)
                        {
                            <tr>
                                <td><b>@p.Nombre</b><span class="linea2">@p.Email</span></td>
                                <td><span class="chip @(p.Perfil == "AdministradorOperador" ? "chip-acento" : null)">@UltimaMilla.Web.Backoffice.Pages.PersonalModel.TextoPerfil(p.Perfil)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Dar de alta</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="aviso error mb-4"></div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="campo">
                    <label asp-for="Formulario.NombreCompleto">Nombre completo</label>
                    <input asp-for="Formulario.NombreCompleto" autocomplete="off" />
                    <span asp-validation-for="Formulario.NombreCompleto"></span>
                </div>
                <div class="campo">
                    <label asp-for="Formulario.Email">Correo electrónico</label>
                    <input asp-for="Formulario.Email" type="email" autocomplete="off" />
                    <span asp-validation-for="Formulario.Email"></span>
                </div>
                <div class="campo">
                    <label asp-for="Formulario.Password">Contraseña inicial <span class="opcional">(vacía si ya tiene cuenta)</span></label>
                    <input asp-for="Formulario.Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Formulario.Password"></span>
                </div>
                <div class="campo">
                    <label asp-for="Formulario.Perfil">Perfil</label>
                    <select asp-for="Formulario.Perfil">
                        @foreach (var p in UltimaMilla.Web.Backoffice.Pages.PersonalModel.Perfiles)
                        {
                            <option value="@p.Valor">@p.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="Formulario.Perfil"></span>
                </div>
                <div class="campo">
                    <label asp-for="Formulario.Telefono">Teléfono <span class="opcional">(repartidores)</span></label>
                    <input asp-for="Formulario.Telefono" type="tel" />
                    <span asp-validation-for="Formulario.Telefono"></span>
                </div>
            </div>
            <div class="acciones">
                <button type="submit" class="primario"><i class="ph ph-user-plus"></i>Dar de alta</button>
            </div>
        </form>
    </section>
</div>
