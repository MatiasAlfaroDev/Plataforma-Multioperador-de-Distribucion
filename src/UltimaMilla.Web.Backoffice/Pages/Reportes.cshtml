@page
@model UltimaMilla.Web.Backoffice.Pages.ReportesModel
@using System.Globalization

@{
    ViewData["Title"] = "Reportes de gestión";
    var cultura = CultureInfo.GetCultureInfo("es-UY");
}

@functions {
    private static string EstadoLegible(string estado) => estado switch
    {
        "Admitido" => "Admitido",
        "EnDeposito" => "En depósito",
        "AsignadoARuta" => "Asignado a ruta",
        "EnTransito" => "En tránsito",
        "Entregado" => "Entregado",
        "EntregadoParcialmente" => "Entregado parcialmente",
        "NoEntregado" => "No entregado",
        "Reprogramado" => "Reprogramado",
        "EnDevolucion" => "En devolución",
        "Devuelto" => "Devuelto",
        "Extraviado" => "Extraviado",
        _ => estado
    };
}

<div class="pagina">
    <section class="tarjeta">
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="campo">
                <label for="desde">Desde</label>
                <input id="desde" name="desde" type="date"
                       value="@(Model.Desde?.ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="campo">
                <label for="hasta">Hasta</label>
                <input id="hasta" name="hasta" type="date"
                       value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" required />
            </div>
            <button type="submit" class="primario"><i class="ph ph-magnifying-glass"></i>Consultar</button>
        </form>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    @if (Model.Resumen is not null)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Resumen de envíos</h2>
            <dl class="cifras mb-6"><div><dt>Total de envíos</dt><dd>@Model.Resumen.TotalEnvios</dd></div></dl>
            <div class="tabla">
                <table>
                    <thead>
                        <tr><th>Estado</th><th class="num">Cantidad</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Resumen.PorEstado.Count == 0)
                        {
                            <tr><td colspan="2" class="vacio">No hay envíos en el período seleccionado.</td></tr>
                        }
                        else
                        {
                            @foreach (var estado in Model.Resumen.PorEstado)
                            {
                                <tr>
                                    <td>@EstadoLegible(estado.Estado)</td>
                                    <td class="num">@estado.Cantidad</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota mt-3">Envíos dados de alta en el período, clasificados según su estado actual.</p>
        </section>
    }

    @if (Model.Retiros is not null)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Retiros a domicilio</h2>
            <dl class="cifras mb-6">
                <div><dt>Total de retiros</dt><dd>@Model.Retiros.TotalRetiros</dd></div>
                <div><dt>Facturado por retiros</dt><dd>@Formato.Moneda(Model.Retiros.TotalTarifado)</dd></div>
            </dl>
            <div class="tabla">
                <table>
                    <thead>
                        <tr><th>Estado</th><th class="num">Cantidad</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Retiros.PorEstado.Count == 0)
                        {
                            <tr><td colspan="2" class="vacio">No hay retiros en el período seleccionado.</td></tr>
                        }
                        @foreach (var estado in Model.Retiros.PorEstado)
                        {
                            <tr>
                                <td>@estado.Estado</td>
                                <td class="num">@estado.Cantidad</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.Motivos is not null)
    {
        <section class="tarjeta">
            <div class="cabecera-tarjeta">
                <h2 class="titulo-tarjeta">Motivos de no entrega</h2>
                <span class="nota">Total de incidencias: <strong>@Model.Motivos.TotalIncidencias</strong></span>
            </div>
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Motivo</th>
                            <th class="num">Intentos fallidos</th>
                            <th class="num">Bultos no entregados</th>
                            <th class="num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Motivos.Motivos.Count == 0)
                        {
                            <tr><td colspan="4" class="vacio">No se registraron incidencias en el período.</td></tr>
                        }
                        else
                        {
                            @foreach (var motivo in Model.Motivos.Motivos)
                            {
                                <tr>
                                    <td>@motivo.Descripcion</td>
                                    <td class="num">@motivo.IntentosFallidos</td>
                                    <td class="num">@motivo.BultosNoEntregados</td>
                                    <td class="num font-semibold">@motivo.TotalIncidencias</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota mt-3">Se consideran los intentos del período. Los bultos no entregados corresponden a entregas parciales.</p>
        </section>
    }

    @if (Model.Actividad is not null)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Volumen diario</h2>
            <div class="tabla">
                <table>
                    <thead>
                        <tr><th>Fecha</th><th class="num">Envíos registrados</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Actividad.VolumenDiario.Count == 0)
                        {
                            <tr><td colspan="2" class="vacio">No hay actividad registrada en el período.</td></tr>
                        }
                        else
                        {
                            @foreach (var dia in Model.Actividad.VolumenDiario)
                            {
                                <tr>
                                    <td>@dia.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="num">@dia.Cantidad</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Actividad por comercio</h2>
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Comercio</th>
                            <th class="num">Envíos</th>
                            <th class="num">Entregados</th>
                            <th class="num">Parciales</th>
                            <th class="num">Importe tarifado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Actividad.Comercios.Count == 0)
                        {
                            <tr><td colspan="5" class="vacio">No hay actividad comercial en el período.</td></tr>
                        }
                        else
                        {
                            @foreach (var comercio in Model.Actividad.Comercios)
                            {
                                <tr>
                                    <td>@comercio.Comercio</td>
                                    <td class="num">@comercio.TotalEnvios</td>
                                    <td class="num">@comercio.Entregados</td>
                                    <td class="num">@comercio.EntregadosParcialmente</td>
                                    <td class="num">$ @comercio.ImporteTarifado.ToString("N2", cultura)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota mt-3">El importe tarifado suma las tarifas calculadas de los envíos dados de alta en el período. No es una liquidación definitiva.</p>
        </section>
    }

    @if (Model.Repartidores is not null)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Resultados por repartidor</h2>
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Repartidor</th>
                            <th class="num">Completas</th>
                            <th class="num">Parciales</th>
                            <th class="num">Fallidas</th>
                            <th class="num">Completas / resultados</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Repartidores.Repartidores.Count == 0)
                        {
                            <tr><td colspan="5" class="vacio">No hay resultados de entrega por repartidor en el período.</td></tr>
                        }
                        else
                        {
                            @foreach (var repartidor in Model.Repartidores.Repartidores)
                            {
                                var total = repartidor.EntregasCompletas + repartidor.EntregasParciales + repartidor.IntentosFallidos;
                                var porcentaje = total == 0 ? 0m : Math.Round(100m * repartidor.EntregasCompletas / total, 2);
                                <tr>
                                    <td>@repartidor.Repartidor</td>
                                    <td class="num">@repartidor.EntregasCompletas</td>
                                    <td class="num">@repartidor.EntregasParciales</td>
                                    <td class="num">@repartidor.IntentosFallidos</td>
                                    <td class="num font-semibold">@porcentaje.ToString("N2", cultura)%</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota mt-3">Se muestran resultados de intentos, no envíos únicos. Un envío puede tener varios intentos y los casos sin asignación inequívoca se agrupan aparte.</p>
        </section>
    }

    @if (Model.Cumplimiento is not null)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Cumplimiento por zona</h2>
            <div class="tabla">
                <table>
                    <thead>
                        <tr><th>Zona</th><th class="num">Completas</th><th class="num">Parciales</th><th class="num">Fallidas</th><th class="num">Completas / resultados</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Cumplimiento.Resultados.Zonas.Count == 0)
                        {
                            <tr><td colspan="5" class="vacio">No hay resultados por zona en el período.</td></tr>
                        }
                        else
                        {
                            @foreach (var zona in Model.Cumplimiento.Resultados.Zonas)
                            {
                                <tr>
                                    <td>@zona.Zona</td><td class="num">@zona.Completas</td><td class="num">@zona.Parciales</td><td class="num">@zona.Fallidas</td><td class="num font-semibold">@zona.PorcentajeCompletas.ToString("N2", cultura)%</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Cumplimiento por comercio</h2>
            <div class="tabla">
                <table>
                    <thead>
                        <tr><th>Comercio</th><th class="num">Completas</th><th class="num">Parciales</th><th class="num">Fallidas</th><th class="num">Completas / resultados</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Cumplimiento.Resultados.Comercios.Count == 0)
                        {
                            <tr><td colspan="5" class="vacio">No hay resultados por comercio en el período.</td></tr>
                        }
                        else
                        {
                            @foreach (var comercio in Model.Cumplimiento.Resultados.Comercios)
                            {
                                <tr>
                                    <td>@comercio.Comercio</td><td class="num">@comercio.Completas</td><td class="num">@comercio.Parciales</td><td class="num">@comercio.Fallidas</td><td class="num font-semibold">@comercio.PorcentajeCompletas.ToString("N2", cultura)%</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota mt-3">Indicador = entregas completas / resultados de entrega × 100. Las parciales y fallidas cuentan por separado. No mide puntualidad horaria.</p>
        </section>
    }

    @if (Model.Liquidacion is not null)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Detalle de tarifas por comercio</h2>
            <p class="nota -mt-3 mb-5">Desglose tarifario de envíos dados de alta en el período. No representa una liquidación emitida ni importes cobrados.</p>
            @if (Model.Liquidacion.Comercios.Count == 0)
            {
                <p class="vacio">No hay envíos en el período seleccionado.</p>
            }
            else
            {
                @foreach (var comercio in Model.Liquidacion.Comercios)
                {
                    <div class="mt-6 first:mt-0">
                        <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
                            <div>
                                <h3 class="m-0 font-display font-semibold">@comercio.Comercio</h3>
                                <p class="nota">@comercio.TotalEnvios envíos · @comercio.EnviosSinTarifa sin tarifa</p>
                            </div>
                            <p class="font-display text-xl font-semibold tabular-nums">$ @comercio.TotalTarifado.ToString("N2", cultura)</p>
                        </div>
                        <div class="tabla">
                            <table>
                                <thead>
                                    <tr><th>Referencia</th><th>Fecha de alta</th><th>Estado actual</th><th class="num">Tarifa calculada</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var envio in comercio.Envios)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrWhiteSpace(envio.Referencia) ? envio.EnvioId.ToString("N")[..8] : envio.Referencia)</td>
                                            <td>@envio.FechaAlta.ToString("dd/MM/yyyy")</td>
                                            <td>@EstadoLegible(envio.Estado)</td>
                                            <td class="num">@(envio.Tarifa.HasValue ? "$ " + envio.Tarifa.Value.ToString("N2", cultura) : "Sin tarifa")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </section>
    }
    
    @if (Model.Puntualidad is not null)
    {
        var datos = Model.Puntualidad.Resultados;

        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Cumplimiento de plazos</h2>
            <p class="nota -mt-3 mb-5">Entregas completas comparadas con la fecha y la franja comprometidas.</p>

            <dl class="cifras mb-6">
                <div><dt>A tiempo</dt><dd>@datos.ATiempo</dd></div>
                <div><dt>Fuera de plazo</dt><dd>@datos.FueraDePlazo</dd></div>
                <div><dt>No evaluables</dt><dd>@datos.NoEvaluables</dd></div>
                <div><dt>Puntualidad</dt><dd>@(datos.PorcentajePuntualidad.HasValue ? datos.PorcentajePuntualidad.Value.ToString("N2") + "%" : "Sin datos")</dd></div>
            </dl>

            <p class="nota">
                Entregas parciales registradas:
                <strong>@datos.EntregasParciales</strong>.
                No se incluyen en el porcentaje de puntualidad.
                Tampoco se incluyen las entregas sin compromiso verificable
                o con reprogramaciones cuyo historial horario es insuficiente.
            </p>
        </section>
    }

</div>
