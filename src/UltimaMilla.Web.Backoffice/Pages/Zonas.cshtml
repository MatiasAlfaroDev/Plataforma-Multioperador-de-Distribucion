@page
@model UltimaMilla.Web.Backoffice.Pages.ZonasModel

@{
    ViewData["Title"] = "Zonas de cobertura";
}

<div class="pagina">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    @if (Model.OperadorIdSesion != Guid.Empty)
    {
        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Zonas de cobertura <span class="chip">@Model.Zonas.Count</span></h2>
            @if (Model.Zonas.Count == 0)
            {
                <p class="vacio">Todavía no hay zonas activas.</p>
            }
            else
            {
                <div class="tabla tabla-holgada">
                    <table>
                        <thead>
                            <tr><th>Zona</th><th>Departamento</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var zona in Model.Zonas)
                            {
                                <tr>
                                    <td><b>@zona.Nombre</b></td>
                                    <td>@zona.Departamento</td>
                                    <td class="text-right"><a asp-page="/EditarZona" asp-route-id="@zona.Id" class="btn-secundario btn-chico"><i class="ph ph-pencil-simple"></i>Editar</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Nueva zona</h2>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="aviso error mb-4"></div>
                <partial name="_CamposZona" for="Formulario" />
                <div class="acciones">
                    <button type="submit" class="primario"><i class="ph ph-plus"></i>Crear zona</button>
                </div>
            </form>
        </section>
    }
</div>
