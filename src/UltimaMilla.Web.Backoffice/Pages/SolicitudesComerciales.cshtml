@page
@model UltimaMilla.Web.Backoffice.Pages.SolicitudesComercialesModel

@{
    ViewData["Title"] = "Comercios";
}

<div class="encabezado">
    <div>
        <h1>Comercios</h1>
        <p>Gestioná las solicitudes de vinculación y los comercios que ya trabajan con tu operador logístico.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <p class="aviso ok" role="status">
        @Model.Mensaje
    </p>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="aviso error" role="alert">
        @Model.Error
    </p>
}

<section>
<h2>Solicitudes pendientes</h2>

@if (Model.Solicitudes.Count == 0)
{
    <p class="nota">No hay solicitudes pendientes.</p>
}
else
{
    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Comercio</th>
                    <th>Fecha de solicitud</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model.Solicitudes)
                {
                    <tr>
                        <td>@solicitud.NombreComercio</td>

                        <td>
                            @solicitud.CreadoEn.ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>Pendiente</td>

                        <td>
                            <form method="post"
                                  asp-page-handler="Aceptar"
                                  class="inline">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@solicitud.Id" />

                                <button type="submit" class="primario">
                                    Aceptar
                                </button>
                            </form>

                            <form method="post"
                                  asp-page-handler="Rechazar"
                                  class="inline">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@solicitud.Id" />

                                <button type="submit"
                                        class="peligro"
                                        onclick="return confirm('¿Rechazar esta solicitud?');">
                                    Rechazar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</section>

<section>
    <h2>Comercios aceptados</h2>

    @if (Model.Aceptados.Count == 0)
    {
        <p class="nota">Todavía no hay comercios aceptados.</p>
    }
    else
    {
        <div class="tabla">
            <table>
                <thead>
                    <tr><th>Comercio</th><th>RUT</th><th>Dirección de recepción</th><th>Estado</th><th>Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var cuenta in Model.Aceptados)
                    {
                        <tr>
                            <td>@cuenta.ComercioNombre</td>
                            <td>@cuenta.ComercioRut</td>
                            <td>@(cuenta.DireccionRecepcion ?? "Sin configurar")</td>
                            <td>
                                @if (cuenta.Activa)
                                {
                                    <span class="chip chip-exito">Activo</span>
                                }
                                else
                                {
                                    <span class="chip chip-peligro">Dado de baja</span>
                                }
                            </td>
                            <td>
                                <div class="flex flex-wrap items-center gap-2">
                                    <details>
                                        <summary><i class="ph ph-pencil-simple"></i> Modificar</summary>
                                        <form method="post" asp-page-handler="Modificar" class="mt-2 flex flex-wrap items-center gap-2">
                                            <input type="hidden" name="id" value="@cuenta.Id" />
                                            <input aria-label="Nombre del comercio" name="nombre" value="@cuenta.ComercioNombre" required maxlength="200" />
                                            <button type="submit" class="primario">Guardar</button>
                                        </form>
                                    </details>

                                    <form method="post" asp-page-handler="Estado" class="inline">
                                        <input type="hidden" name="id" value="@cuenta.Id" />
                                        <input type="hidden" name="activa" value="@((!cuenta.Activa).ToString().ToLowerInvariant())" />
                                        @if (cuenta.Activa)
                                        {
                                            <button type="submit" class="peligro"
                                                    onclick="return confirm('¿Dar de baja este comercio? No podrá crear envíos ni retiros nuevos con tu operador; los que ya tiene siguen su curso.');">
                                                <i class="ph ph-prohibit"></i> Dar de baja
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"><i class="ph ph-arrow-counter-clockwise"></i> Reactivar</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
