@page "{id:guid}"
@model DetalleEnvioModel
@using UltimaMilla.Web.Backoffice.Services

@{
    ViewData["Title"] = "Detalle de envío";
}

<div class="pagina">
    <a asp-page="/Index" class="nota w-fit"><i class="ph ph-arrow-left"></i> Envíos</a>

    @if (Model.Error is not null)
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    <partial name="_Toast" model="(false, Model.ErrorAccion)" />

    @if (Model.Envio is { } envio)
    {
        var hayAcciones = envio.Estado is "NoEntregado" or "EntregadoParcialmente"
            || Model.PuedeDeclararExtravio || Model.PuedeRegistrarReaparicion || envio.PuedeIniciarDevolucion;

        <div class="grid items-start gap-[24px] @(hayAcciones ? "lg:grid-cols-[minmax(0,1fr)_320px]" : null)">
            <div class="grid gap-[24px]">
                <section class="tarjeta">
                    <div class="cabecera-tarjeta">
                        <h1 class="titulo-tarjeta"><span class="codigo">@envio.ReferenciaExterna</span></h1>
                        <span class="@Formato.ClaseEstado(envio.Estado)">@Formato.Estado(envio.Estado)</span>
                    </div>
                    <dl class="datos">
                        <dt>Destinatario</dt><dd>@envio.Destinatario</dd>
                        <dt>Dirección</dt><dd>@envio.Direccion</dd>
                        <dt>Modalidad</dt><dd>@Formato.Modalidad(envio.Modalidad)</dd>
                        <dt>Alta</dt><dd>@Formato.Hora(envio.FechaAlta)</dd>
                        <dt>Intentos de entrega</dt><dd>@envio.IntentosRealizados</dd>
                    </dl>
                </section>

                <section class="tarjeta">
                    <h2 class="titulo-tarjeta">Bultos <span class="chip">@envio.Bultos.Count</span></h2>
                    <div class="tabla tabla-holgada">
                        <table>
                            <thead>
                                <tr>
                                    <th>Identificación</th>
                                    <th>Estado</th>
                                    <th>Medidas</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bulto in envio.Bultos)
                                {
                                    <tr>
                                        <td><b class="codigo">@bulto.Identificacion</b></td>
                                        <td><span class="@(bulto.Estado switch { "Entregado" or "Devuelto" => "chip chip-exito", "EnDevolucion" or "Extraviado" => "chip chip-peligro", _ => "chip" })">@Formato.Estado(bulto.Estado)</span></td>
                                        <td>
                                            @Formato.Numero(bulto.PesoKg) kg
                                            <span class="linea2">@bulto.AltoCm × @bulto.AnchoCm × @bulto.ProfundidadCm cm</span>
                                        </td>
                                        <td>
                                            @if (envio.Estado is "EnDeposito" or "NoEntregado" or "EntregadoParcialmente" or "AsignadoARuta" or "EnTransito")
                                            {
                                                if (bulto.Estado == "Pendiente" && Model.PuedeGestionarDespacho)
                                                {
                                                    <details class="relative flex justify-end">
                                                        <summary class="btn-secundario btn-chico ml-auto w-fit list-none [&::-webkit-details-marker]:hidden">Declarar extraviado</summary>
                                                        <form method="post" asp-page-handler="ExtraviarBulto" asp-route-id="@envio.Id"
                                                              class="absolute right-0 z-10 mt-2 grid w-72 gap-3 rounded-xl border border-borde bg-superficie p-4 text-left shadow-lg">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="identificacion" value="@bulto.Identificacion" />
                                                            <div class="campo">
                                                                <label for="justificacion-@bulto.Identificacion">Qué pasó y quién lo tenía</label>
                                                                <input type="text" id="justificacion-@bulto.Identificacion" name="justificacion" maxlength="150" required />
                                                            </div>
                                                            <button type="submit" class="peligro">Declarar extraviado</button>
                                                        </form>
                                                    </details>
                                                }
                                                else if (bulto.Estado == "Extraviado" && Model.PuedeGestionarDeposito)
                                                {
                                                    <form method="post" asp-page-handler="ReaparecerBulto" asp-route-id="@envio.Id" class="text-right">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="identificacion" value="@bulto.Identificacion" />
                                                        <button type="submit" class="primario btn-chico">Reaparecer</button>
                                                    </form>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                @if (Model.Discrepancias.Count > 0)
                {
                    <section class="tarjeta">
                        <h2 class="titulo-tarjeta">Discrepancias de recepción</h2>
                        <div class="tabla tabla-holgada">
                            <table>
                                <thead>
                                    <tr><th>Fecha</th><th>Tipo</th><th>Bulto</th><th>Responsable</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.Discrepancias)
                                    {
                                        <tr>
                                            <td>@Formato.Hora(d.RegistradaEn)</td>
                                            <td><span class="chip chip-alerta">@(d.Tipo == "BultoFaltante" ? "Bulto faltante" : "Bulto no declarado")</span></td>
                                            <td class="codigo">@d.Identificacion</td>
                                            <td>@d.Responsable</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                <section class="tarjeta">
                    <h2 class="titulo-tarjeta">Historial</h2>
                    @if (envio.Eventos.Count == 0)
                    {
                        <p class="vacio">Todavía no hay eventos registrados.</p>
                    }
                    else
                    {
                        <div class="tabla tabla-holgada">
                            <table>
                                <thead>
                                    <tr><th>Fecha</th><th>Cambio</th><th>Responsable</th><th>Justificación</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var evento in envio.Eventos)
                                    {
                                        <tr>
                                            <td>@Formato.Hora(evento.OcurridoEn)</td>
                                            <td>
                                                @Formato.Estado(evento.EstadoAnterior) <i class="ph ph-arrow-right text-suave"></i> <b>@Formato.Estado(evento.EstadoNuevo)</b>
                                            </td>
                                            <td>
                                                @evento.Responsable
                                                <span class="linea2">@evento.Origen</span>
                                            </td>
                                            <td>@(evento.Justificacion ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>

            @if (hayAcciones)
            {
                <aside class="grid gap-[24px] lg:sticky lg:top-[24px]">
                    @if (envio.Estado is "NoEntregado" or "EntregadoParcialmente")
                    {
                        <section class="tarjeta">
                            <h2 class="titulo-tarjeta">Retornar al depósito</h2>
                            <form method="post" asp-page-handler="RetornarDeposito" asp-route-id="@envio.Id" class="grid gap-4">
                                @Html.AntiForgeryToken()
                                <p class="nota">Marcá los bultos pendientes que volvieron después del intento de entrega.</p>
                                <div class="grid gap-2">
                                    @foreach (var bulto in envio.Bultos.Where(b => b.Estado == "Pendiente"))
                                    {
                                        <label class="m-0 flex items-center gap-2 text-sm font-normal">
                                            <input type="checkbox" name="identificaciones" value="@bulto.Identificacion" />
                                            <span class="codigo">@bulto.Identificacion</span>
                                        </label>
                                    }
                                </div>
                                <div class="campo">
                                    <label for="responsableRetorno">Responsable de recepción</label>
                                    <input type="text" id="responsableRetorno" name="responsable" maxlength="150" required />
                                </div>
                                <button type="submit" class="primario w-full">Confirmar retorno</button>
                            </form>
                        </section>
                    }

                    @if (envio.PuedeIniciarDevolucion)
                    {
                        <section class="tarjeta">
                            <h2 class="titulo-tarjeta">Iniciar devolución</h2>
                            <form method="post" asp-page-handler="IniciarDevolucion" asp-route-id="@envio.Id" class="grid gap-4">
                                @Html.AntiForgeryToken()
                                <div class="campo">
                                    <label for="responsableDevolucion">Responsable</label>
                                    <input type="text" id="responsableDevolucion" name="responsable" required maxlength="150" />
                                </div>
                                <p class="nota">Solo se inicia si se cumplen las reglas operativas del envío.</p>
                                <button type="submit" class="primario w-full">Iniciar devolución</button>
                            </form>
                        </section>
                    }

                    @if (Model.PuedeRegistrarReaparicion)
                    {
                        <section class="tarjeta" id="reaparicion">
                            <h2 class="titulo-tarjeta">Registrar reaparición</h2>
                            <form method="post" asp-page-handler="Reaparicion" asp-route-id="@envio.Id" class="grid gap-4">
                                @Html.AntiForgeryToken()
                                <p class="nota">Marcá los bultos encontrados. El envío vuelve al depósito y los que no aparecieron siguen extraviados.</p>
                                <div class="grid gap-2">
                                    @foreach (var bulto in envio.Bultos.Where(b => b.Estado == "Extraviado"))
                                    {
                                        <label class="m-0 flex items-center gap-2 text-sm font-normal">
                                            <input type="checkbox" name="identificaciones" value="@bulto.Identificacion" />
                                            <span class="codigo">@bulto.Identificacion</span>
                                        </label>
                                    }
                                </div>
                                <button type="submit" class="primario w-full"><i class="ph ph-arrow-counter-clockwise"></i>Registrar reaparición</button>
                            </form>
                        </section>
                    }

                    @if (Model.PuedeDeclararExtravio)
                    {
                        <section class="tarjeta">
                            <h2 class="titulo-tarjeta">Declarar extraviado</h2>
                            <form method="post" asp-page-handler="DeclararExtravio" asp-route-id="@envio.Id" class="grid gap-4">
                                @Html.AntiForgeryToken()
                                <p class="nota">El envío sale de la operación hasta que reaparezca. Queda a tu nombre con la justificación y libera su parada en la hoja de ruta.</p>
                                <div class="campo">
                                    <label for="justificacionExtravio">Justificación</label>
                                    <textarea id="justificacionExtravio" name="justificacion" maxlength="1000" rows="3" required></textarea>
                                </div>
                                <button type="submit" class="peligro w-full"><i class="ph ph-warning"></i>Declarar extraviado</button>
                            </form>
                        </section>
                    }
                </aside>
            }
        </div>
    }
</div>
