@page
@model UltimaMilla.Web.Backoffice.Pages.BanderasModel

@{
    ViewData["Title"] = "Banderas de funcionalidad";
}

<div class="pagina">
    @if (Model.Error is not null)
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Banderas por operador</h2>
        <p class="nota mb-4">El cambio llega a todas las instancias sin reiniciarlas.</p>
        <div class="tabla tabla-holgada">
            <table>
                <thead>
                    <tr>
                        <th>Operador</th>
                        @foreach (var (_, texto) in UltimaMilla.Web.Backoffice.Pages.BanderasModel.Nombres)
                        {
                            <th>@texto</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Datos.Estado)
                    {
                        <tr>
                            <td><b>@fila.Operador</b></td>
                            @foreach (var (clave, texto) in UltimaMilla.Web.Backoffice.Pages.BanderasModel.Nombres)
                            {
                                var habilitada = fila.Banderas.GetValueOrDefault(clave, true);
                                <td>
                                    <form method="post" class="flex items-center gap-2.5">
                                        <input type="hidden" name="operadorId" value="@fila.OperadorId" />
                                        <input type="hidden" name="bandera" value="@clave" />
                                        <input type="hidden" name="habilitada" value="@((!habilitada).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="interruptor" role="switch" aria-checked="@(habilitada ? "true" : "false")"
                                                title="@(habilitada ? "Deshabilitar" : "Habilitar") @texto para @fila.Operador"></button>
                                        <span class="text-sm @(habilitada ? null : "text-suave")">@(habilitada ? "Habilitada" : "Deshabilitada")</span>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Historial</h2>
        @if (Model.Datos.Historial.Count == 0)
        {
            <p class="vacio">Todavía no se modificó ninguna bandera.</p>
        }
        else
        {
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr><th>Cambio</th><th>Operador</th><th>Valor</th><th>Por</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cambio in Model.Datos.Historial)
                        {
                            <tr>
                                <td><b>@Model.Texto(cambio.Nombre)</b><span class="linea2">@Formato.Hora(cambio.ModificadoEn)</span></td>
                                <td>@Model.Operador(cambio.OperadorId)</td>
                                <td><span class="chip @(cambio.Habilitada ? "chip-exito" : null)">@(cambio.Habilitada ? "Habilitada" : "Deshabilitada")</span></td>
                                <td>@cambio.ModificadoPor</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
