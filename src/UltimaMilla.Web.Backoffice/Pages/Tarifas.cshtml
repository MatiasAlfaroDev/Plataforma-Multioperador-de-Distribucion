
@page
@model UltimaMilla.Web.Backoffice.Pages.TarifasModel
@using UltimaMilla.Web.Backoffice.Services

@{
    ViewData["Title"] = "Configuración de tarifas";
}

@{
    // Los precios son los mismos al crear y al actualizar; cambia el handler y el nombre del cuadro.
    async Task Precios()
    {
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="campo">
                <label asp-for="PrecioBase">Precio base</label>
                <div class="sufijo"><input asp-for="PrecioBase" type="number" min="0" step="0.01" required /><span>$</span></div>
                <span asp-validation-for="PrecioBase"></span>
            </div>
            <div class="campo">
                <label asp-for="PrecioPorKg">Por kg</label>
                <div class="sufijo"><input asp-for="PrecioPorKg" type="number" min="0" step="0.01" required /><span>$</span></div>
                <span asp-validation-for="PrecioPorKg"></span>
            </div>
            <div class="campo">
                <label asp-for="PrecioPorMetroCubico">Por m³</label>
                <div class="sufijo"><input asp-for="PrecioPorMetroCubico" type="number" min="0" step="0.01" required /><span>$</span></div>
                <span asp-validation-for="PrecioPorMetroCubico"></span>
            </div>
            @if (!Model.EsRetiro)
            {
                <div class="campo">
                    <label asp-for="RecargoUrgentePorcentaje">Recargo urgente</label>
                    <div class="sufijo"><input asp-for="RecargoUrgentePorcentaje" type="number" min="0" step="0.01" /><span>%</span></div>
                    <span asp-validation-for="RecargoUrgentePorcentaje"></span>
                </div>
            }
            <div class="campo">
                <label asp-for="BonificacionPorcentaje">Bonificación</label>
                <div class="sufijo"><input asp-for="BonificacionPorcentaje" type="number" min="0" max="100" step="0.01" /><span>%</span></div>
                <span asp-validation-for="BonificacionPorcentaje"></span>
            </div>
        </div>
    }
}

<div class="pagina">
    @if (Model.Error is not null)
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    @if (Model.OperadorIdSesion != Guid.Empty)
    {
        <section class="tarjeta">
            <form method="get" class="grid gap-4 sm:grid-cols-3">
                <div class="campo">
                    <label for="zonaCoberturaId">Zona de cobertura</label>
                    <select id="zonaCoberturaId" name="zonaCoberturaId" onchange="this.form.submit()" required>
                        <option value="">Elegí una zona…</option>
                        @foreach (var zona in Model.Zonas)
                        {
                            <option value="@zona.Id" selected="@(Model.ZonaCoberturaId == zona.Id)">@zona.Nombre (@zona.Departamento)</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="tipoServicio">Servicio</label>
                    <select id="tipoServicio" name="tipoServicio" onchange="this.form.submit()">
                        <option value="Entrega" selected="@(Model.TipoServicio == "Entrega")">Entrega</option>
                        <option value="RetiroDomicilio" selected="@(Model.TipoServicio == "RetiroDomicilio")">Retiro a domicilio</option>
                    </select>
                </div>
                <div class="campo">
                    <label for="accion">Operación</label>
                    <select id="accion" name="accion" onchange="this.form.submit()">
                        <option value="editar" selected="@(Model.Accion == "editar")">Editar la tarifa vigente</option>
                        <option value="nueva" selected="@(Model.Accion == "nueva")">Nueva tarifa</option>
                    </select>
                </div>
                <noscript><button type="submit">Ver configuración</button></noscript>
            </form>
        </section>
    }

    @if (Model.OperadorIdSesion != Guid.Empty && Model.ZonaCoberturaId.HasValue && Model.Error is null)
    {
        <section class="tarjeta max-w-[860px]">
            <div class="cabecera-tarjeta">
                <h2 class="titulo-tarjeta">@(Model.EsRetiro ? "Tarifa de retiro a domicilio" : "Tarifa de entrega")</h2>
                @if (Model.TarifaEncontrada && !Model.EsNuevaTarifa && Model.VigenciaDesde.HasValue)
                {
                    <span class="chip chip-exito">Vigente desde el @Formato.Hora(Model.VigenciaDesde.Value)</span>
                }
            </div>

            @if (Model.EsNuevaTarifa)
            {
                @if (Model.TarifaEncontrada)
                {
                    <p class="aviso">Ya hay una tarifa vigente para esta zona y servicio. Para cambiar sus precios, elegí «Editar la tarifa vigente»: se guarda como una versión nueva.</p>
                }
                else
                {
                    <form method="post" asp-page-handler="Crear" class="grid gap-4">
                        <input type="hidden" asp-for="ZonaCoberturaId" />
                        <input type="hidden" asp-for="TipoServicio" />
                        <div class="campo">
                            <label asp-for="Nombre">Nombre del cuadro tarifario</label>
                            <input asp-for="Nombre" maxlength="150" required placeholder="Retiro a domicilio" />
                            <span asp-validation-for="Nombre"></span>
                        </div>
                        @{ await Precios(); }
                        <div class="acciones">
                            <button type="submit" class="primario">Crear tarifa</button>
                        </div>
                    </form>
                }
            }
            else if (!Model.TarifaEncontrada)
            {
                <p class="vacio">No hay una tarifa vigente para esta zona y servicio. Elegí «Nueva tarifa» para crearla.</p>
            }
            else
            {
                <form method="post" asp-page-handler="Actualizar" class="grid gap-4">
                    <input type="hidden" asp-for="ZonaCoberturaId" />
                    <input type="hidden" asp-for="TipoServicio" />
                    @{ await Precios(); }
                    <p class="nota">Al guardar se crea una versión nueva; la anterior queda en el historial.</p>
                    <div class="acciones mt-0">
                        <button type="submit" class="primario">Guardar nueva versión</button>
                    </div>
                </form>
            }
        </section>
    }
</div>
