@page
@model UltimaMilla.Web.Backoffice.Pages.LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<section style="max-width: 420px; margin: 3rem auto;">
    <h1>Iniciar sesión</h1>
    <p class="nota">Acceso para operadores logísticos.</p>

    <form id="formLogin">
        <label for="email">Correo electrónico</label>
        <input id="email"
               type="email"
               autocomplete="username"
               required />

        <label for="password">Contraseña</label>
        <input id="password"
               type="password"
               autocomplete="current-password"
               required />

        <div class="acciones">
            <button class="primario" type="submit" id="btnLogin">
                Iniciar sesión
            </button>
        </div>

        <p id="mensajeError" class="error" role="alert"></p>
    </form>
    <p>
    ¿Todavía no tenés una cuenta?
    <a asp-page="/Registro">Registrar operador logístico</a>
</p>
</section>

<script>
    document.getElementById("formLogin").addEventListener("submit", async (event) => {
        event.preventDefault();

        const boton = document.getElementById("btnLogin");
        const error = document.getElementById("mensajeError");

        boton.disabled = true;
        error.textContent = "";

        try {
            const respuesta = await fetch("/api/auth/login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    email: document.getElementById("email").value,
                    password: document.getElementById("password").value,
                    aplicacion: "backoffice"

                })
            });

            if (!respuesta.ok) {
            if (respuesta.status === 401) {
                throw new Error("Correo o contraseña incorrectos.");
            }

            if (respuesta.status === 403) {
                throw new Error(
                    "No tenés permisos para acceder al Backoffice."
                );
            }

            throw new Error("No se pudo iniciar sesión.");
        }

            window.location.assign("/SeleccionarOperador");
        } catch (ex) {
            error.textContent = ex.message;
        } finally {
            boton.disabled = false;
        }
    });
</script>