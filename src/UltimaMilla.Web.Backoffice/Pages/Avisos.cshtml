@page
@model AvisosModel
@using UltimaMilla.Web.Backoffice.Services
@{
    ViewData["Title"] = "Avisos a comercios";
}

<h1>Avisos a comercios</h1>

<p class="nota">
    Cada novedad de un envío se avisa al sistema del comercio suscripto.
    El Worker reintenta 5 veces con espera creciente y, si sigue fallando,
    el aviso queda Fallida y el mensaje en la cola entregar-aviso_error.
    Desde acá se reintenta.
</p>

@if (Model.Mensaje is not null)
{
    <p class="aviso @(Model.Reencolado ? "ok" : "error")" role="status">
        @Model.Mensaje
    </p>
}

@if (Model.Error is not null)
{
    <p class="error" role="alert">
        @Model.Error
    </p>
}

<form method="get" class="filtro">
    <label for="estado">Estado</label>
    <select id="estado" name="estado" asp-for="Estado">
        <option value="">Todos</option>
        <option value="Fallida">Fallida</option>
        <option value="Pendiente">Pendiente</option>
        <option value="Entregada">Entregada</option>
    </select>
    <button type="submit">Filtrar</button>
</form>

@if (Model.Avisos.Count == 0)
{
    <p>No hay avisos con ese estado.</p>
}
else
{
    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Evento</th>
                    <th>Clave del evento</th>
                    <th>Estado</th>
                    <th class="num">Intentos</th>
                    <th>Último error</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Avisos)
                {
                    <tr>
                        <td>@a.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@a.TipoEvento</td>
                        <td>@a.ClaveEvento</td>
                        <td>@a.Estado</td>
                        <td class="num">@a.Intentos</td>
                        <td>@a.UltimoError</td>
                        <td>
                            @if (a.Estado == "Fallida")
                            {
                                <form method="post" asp-page-handler="Reenviar" asp-route-id="@a.Id" asp-route-estado="@Model.Estado">
                                    <button type="submit" class="primario">Reintentar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
