@page
@model AvisosModel
@using UltimaMilla.Web.Backoffice.Services
@{
    ViewData["Title"] = "Avisos a comercios";
}

<div class="pagina">
    <partial name="_Toast" model="(Model.Reencolado, Model.Mensaje)" />
    <partial name="_Toast" model="(false, Model.Error)" />

    <section class="tarjeta">
        <div class="cabecera-tarjeta">
            <h2 class="titulo-tarjeta">Avisos a comercios <span class="chip">@Model.Avisos.Count</span></h2>
            <form method="get" class="flex items-center gap-3">
                <select id="estado" name="estado" asp-for="Estado" class="w-auto min-w-44" aria-label="Filtrar por estado" onchange="this.form.requestSubmit()">
                    <option value="">Todos los estados</option>
                    <option value="Fallida">Fallida</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Entregada">Entregada</option>
                </select>
                <noscript><button type="submit">Filtrar</button></noscript>
            </form>
        </div>
        <p class="nota mb-4">El Worker reintenta 5 veces con espera creciente; si sigue fallando, el aviso queda Fallida y el mensaje en la cola entregar-aviso_error. Desde acá se reintenta.</p>

        @if (Model.Avisos.Count == 0)
        {
            <p class="vacio">No hay avisos con ese estado.</p>
        }
        else
        {
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr><th>Evento</th><th>Estado</th><th class="num">Intentos</th><th>Último error</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Avisos)
                        {
                            <tr>
                                <td>
                                    <b class="codigo">@a.TipoEvento</b>
                                    <span class="linea2">@a.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · <span class="codigo">@a.ClaveEvento</span></span>
                                </td>
                                <td><span class="chip @(a.Estado switch { "Entregada" => "chip-exito", "Fallida" => "chip-peligro", _ => null })">@a.Estado</span></td>
                                <td class="num">@a.Intentos</td>
                                <td>@a.UltimoError</td>
                                <td class="text-right">
                                    @if (a.Estado == "Fallida")
                                    {
                                        <form method="post" asp-page-handler="Reenviar" asp-route-id="@a.Id" asp-route-estado="@Model.Estado">
                                            <button type="submit" class="primario btn-chico"><i class="ph ph-arrow-clockwise"></i>Reintentar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
