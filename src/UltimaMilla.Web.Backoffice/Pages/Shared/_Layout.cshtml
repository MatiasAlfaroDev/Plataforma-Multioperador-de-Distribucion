<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Backoffice</title>
    <style>
        /* Tokens compartidos por Portal y Backoffice: mismos nombres en los dos archivos. */
        :root {
          color-scheme: light dark;
          --fondo: #f6f7f9; --superficie: #ffffff; --texto: #1f2328; --texto-suave: #57606a;
          --borde: #d0d7de; --acento: #0b6e4f; --acento-texto: #ffffff;
          --peligro: #b3261e; --ok: #16692e; --radio: 6px;
        }
        @@media (prefers-color-scheme: dark) {
          :root {
            --fondo: #16181c; --superficie: #1f2228; --texto: #e6e8eb; --texto-suave: #a3aab3;
            --borde: #3a3f47; --acento: #3fb68b; --acento-texto: #0d1512;
            --peligro: #ff8a80; --ok: #6fd38f;
          }
        }
        body { font-family: system-ui, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; background: var(--fondo); color: var(--texto); }
        header { padding-bottom: .5rem; border-bottom: 1px solid var(--borde); margin-bottom: 1rem; }
        label { display: block; margin: .7rem 0 .2rem; font-weight: 600; }
        input, select { width: 100%; padding: .5rem; box-sizing: border-box; background: var(--superficie);
          color: var(--texto); border: 1px solid var(--borde); border-radius: var(--radio); font: inherit; }
        button { padding: .55rem 1.1rem; border-radius: var(--radio); border: 1px solid var(--borde);
          background: var(--superficie); color: var(--texto); font: inherit; cursor: pointer; }
        button:active { transform: translateY(1px); }
        button.primario { background: var(--acento); border-color: var(--acento); color: var(--acento-texto); font-weight: 600; }
        button.peligro { color: var(--peligro); border-color: currentColor; background: transparent; }
        button:disabled { opacity: .6; cursor: progress; }
        :focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }
        .nota { color: var(--texto-suave); font-size: .9rem; }
        .aviso { padding: .6rem .8rem; border-radius: var(--radio); border: 1px solid currentColor; }
        .ok { color: var(--ok); }
        .error, .validation-message, .validation-errors { color: var(--peligro); }

        .filtro { display: flex; flex-wrap: wrap; gap: .5rem; align-items: end; margin: 1rem 0; }
        .filtro label { margin: 0 0 .2rem; }
        .filtro select { width: auto; min-width: 14rem; }
        .campos { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0 1rem; max-width: 760px; }
        .acciones { margin-top: 1rem; }
        .tabla { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: .95rem; }
        th, td { text-align: left; padding: .5rem; border-bottom: 1px solid var(--borde); vertical-align: top; white-space: nowrap; }
        .num { text-align: right; font-variant-numeric: tabular-nums; }
        .operador { display: inline-block; width: .7rem; height: .7rem; border-radius: 50%; margin-right: .3rem; }
        nav { margin-top: .75rem; }
        nav a { color: var(--acento); margin-right: 1rem; }
    </style>
</head>
<body>
    <header>
        <strong>Backoffice del operador</strong> · Plataforma de última milla
        <nav>
            <a asp-page="/Index">Envíos</a>
            <a asp-page="/Tarifas">Tarifas</a>
            <a asp-page="/Zonas">Zonas de cobertura</a>
            <a asp-page="/HojasDeRuta">Hojas de ruta</a>
        </nav>
    </header>
    <main>@RenderBody()</main>
</body>
</html>
