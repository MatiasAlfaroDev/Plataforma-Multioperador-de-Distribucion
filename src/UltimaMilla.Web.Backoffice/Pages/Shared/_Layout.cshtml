<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Backoffice</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preload" href="~/fuentes/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/iconos/phosphor.css" />
</head>

@{
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString();

    var esPaginaPublica = paginaActual is "/Login" or "/Registro";

    var esAdmin = User.IsInRole("AdministradorOperador");
    var esDespacho = esAdmin || User.IsInRole("Despachador") || User.IsInRole("Operador");
    var esDeposito = User.IsInRole("OperarioDeposito");

    var mostrarMenu =
        !esPaginaPublica &&
        User.Identity?.IsAuthenticated == true &&
        (esDespacho || esDeposito);

    var mostrarMenuPlataforma = !esPaginaPublica && User.IsInRole("AdministradorPlataforma");

    // Entradas del menú lateral según el rol (letra 3.3): página, ícono de Phosphor y texto.
    var entradas = new List<(string Pagina, string Icono, string Texto)>();
    if (mostrarMenu)
    {
        entradas.Add(("/Index", "ph-package", "Envíos"));
        if (esDespacho)
        {
            entradas.Add(("/HojasDeRuta", "ph-path", "Hojas de ruta"));
            entradas.Add(("/Avisos", "ph-bell", "Avisos a comercios"));
            entradas.Add(("/Reportes", "ph-chart-bar", "Reportes"));
        }
        if (esAdmin)
        {
            entradas.Add(("/Zonas", "ph-map-trifold", "Zonas de cobertura"));
            entradas.Add(("/Tarifas", "ph-currency-dollar", "Tarifas"));
            entradas.Add(("/ReglasOperativas", "ph-sliders-horizontal", "Reglas operativas"));
            entradas.Add(("/Personal", "ph-users-three", "Personal"));
            entradas.Add(("/SolicitudesComerciales", "ph-handshake", "Solicitudes de comercios"));
        }
    }
    if (mostrarMenuPlataforma)
    {
        entradas.Add(("/MensajesFallidos", "ph-warning-octagon", "Mensajes fallidos"));
    }
    var hayMenu = entradas.Count > 0;
}

<body>
    @if (!hayMenu)
    {
        <!-- Páginas públicas (login, registro, elegir operador): sin menú lateral -->
        <header class="mx-auto flex max-w-5xl items-center gap-2.5 px-4 py-5 md:px-8">
            <img src="~/logo.svg" alt="" class="size-8" />
            <span class="font-display text-[17px] font-bold tracking-tight">Última Milla</span>
            <span class="text-[13px] text-suave">Backoffice del operador</span>
        </header>
        <main class="mx-auto max-w-5xl px-4 pb-16 pt-6 md:px-8">@RenderBody()</main>
    }
    else
    {
        <div class="lg:grid lg:min-h-dvh lg:grid-cols-[248px_1fr]">
            <!-- Menú: lateral fijo en escritorio; desplegable con <details> en el celular -->
            <aside class="border-b border-borde bg-superficie lg:sticky lg:top-0 lg:h-dvh lg:border-b-0 lg:border-r">
                <details class="group lg:contents" open>
                    <summary class="flex list-none items-center gap-2.5 px-4 py-3 text-texto no-underline lg:pointer-events-none lg:px-5 lg:py-5 [&::-webkit-details-marker]:hidden">
                        <img src="~/logo.svg" alt="" class="size-8" />
                        <span class="flex flex-col leading-tight">
                            <span class="font-display text-[16px] font-bold tracking-tight">Última Milla</span>
                            <span class="text-[12px] font-normal text-suave">Backoffice del operador</span>
                        </span>
                        <i class="ph ph-list ml-auto text-xl text-suave lg:hidden"></i>
                    </summary>

                    <nav class="flex flex-col gap-0.5 px-3 pb-4 lg:pb-0">
                        @foreach (var e in entradas)
                        {
                            <a asp-page="@e.Pagina" class="nav-item" aria-current="@(paginaActual == e.Pagina ? "page" : null)">
                                <i class="ph @e.Icono"></i>@e.Texto
                            </a>
                        }
                    </nav>

                    <div class="flex flex-col gap-0.5 border-t border-borde px-3 py-3 lg:absolute lg:inset-x-0 lg:bottom-0">
                        <a asp-page="/SeleccionarOperador" class="nav-item"><i class="ph ph-arrows-left-right"></i>Cambiar operador</a>
                        <button type="button" id="btnCerrarSesion"
                                class="nav-item w-full justify-start border-0 bg-transparent">
                            <i class="ph ph-sign-out"></i>Cerrar sesión
                        </button>
                    </div>
                </details>
            </aside>

            <main class="min-w-0 px-4 py-8 md:px-10 md:py-12">
                <div class="mx-auto max-w-6xl">@RenderBody()</div>
            </main>
        </div>
    }

    <script>
    document.addEventListener("DOMContentLoaded", () => {
        // En escritorio el menú siempre está abierto; en el celular arranca cerrado.
        const menu = document.querySelector("aside details");
        if (menu && !matchMedia("(min-width: 1024px)").matches) menu.open = false;

        const btnCerrarSesion = document.getElementById("btnCerrarSesion");

        if (!btnCerrarSesion) return;

        btnCerrarSesion.addEventListener("click", async () => {
            btnCerrarSesion.disabled = true;

            try {
                const respuesta = await fetch("/api/auth/logout", {
                    method: "POST",
                    credentials: "same-origin"
                });

                if (!respuesta.ok) {
                    throw new Error(
                        `No se pudo cerrar sesión. Código: ${respuesta.status}`
                    );
                }

                window.location.replace("/Login");

            } catch (error) {
                console.error("Error al cerrar sesión:", error);
                alert(error.message);
                btnCerrarSesion.disabled = false;
            }
        });
    });
    </script>
</body>
</html>
