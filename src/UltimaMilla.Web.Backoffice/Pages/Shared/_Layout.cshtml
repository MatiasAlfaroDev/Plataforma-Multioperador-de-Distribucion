<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Backoffice</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #222; }
        header { padding-bottom: .5rem; border-bottom: 1px solid #ddd; margin-bottom: 1rem; }
        form { display: flex; gap: .5rem; align-items: center; margin: 1rem 0; }
        select, button { padding: .4rem; }
        table { width: 100%; border-collapse: collapse; font-size: .95rem; }
        th, td { text-align: left; padding: .5rem; border-bottom: 1px solid #ddd; vertical-align: top; }
        .operador { display: inline-block; width: .7rem; height: .7rem; border-radius: 50%; margin-right: .3rem; }
        .nota { color: #666; font-size: .9rem; }
        .error { color: #b3261e; }
    </style>
</head>
<body>
    <header><strong>Backoffice del operador</strong> · Plataforma de última milla</header>
    <main>@RenderBody()</main>
</body>
</html>
