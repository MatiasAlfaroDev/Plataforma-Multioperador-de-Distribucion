@* Un toast del lado del servidor. Se puede poner en cualquier parte de la página: el layout lo mueve a la pila. *@
@model (bool Exito, string? Mensaje)
@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <div class="toast @(Model.Exito ? null : "toast-error")" role="@(Model.Exito ? "status" : "alert")" data-toast>
        <i class="ph @(Model.Exito ? "ph-check-circle" : "ph-warning-circle") text-xl"></i>
        <div>@Model.Mensaje</div>
        <button type="button" title="Cerrar" data-cerrar-toast><i class="ph ph-x"></i></button>
    </div>
}
