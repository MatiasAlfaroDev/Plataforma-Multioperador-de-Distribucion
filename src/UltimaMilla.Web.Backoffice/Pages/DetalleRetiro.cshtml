@page "{id:guid}"
@model DetalleRetiroModel
@using UltimaMilla.Web.Backoffice.Services

@{
    ViewData["Title"] = "Detalle de retiro";
}

<div class="pagina">
    <a asp-page="/Retiros" class="nota w-fit"><i class="ph ph-arrow-left"></i> Retiros</a>

    @if (Model.Error is not null)
    {
        <p class="aviso error" role="alert">@Model.Error</p>
    }

    @if (Model.Retiro is { } retiro)
    {
        var hayAcciones = retiro.Estado is "Retirado" or "NoRetirado";

        <div class="grid items-start gap-[24px] @(hayAcciones ? "lg:grid-cols-[minmax(0,1fr)_320px]" : null)">
            <div class="grid gap-[24px]">
                <section class="tarjeta">
                    <div class="cabecera-tarjeta">
                        <h1 class="titulo-tarjeta">Retiro del @retiro.FechaSolicitada.ToString("dd/MM/yyyy")</h1>
                        <span class="@Formato.ClaseEstadoRetiro(retiro.Estado)">@Formato.EstadoRetiro(retiro.Estado)</span>
                    </div>
                    <dl class="datos">
                        <dt>Motivo</dt><dd>@retiro.Motivo</dd>
                        <dt>Franja</dt><dd>@retiro.HoraDesde.ToString("HH:mm")–@retiro.HoraHasta.ToString("HH:mm")</dd>
                        <dt>Solicitado</dt><dd>@Formato.Hora(retiro.SolicitadoEn)</dd>
                        <dt>Retiro de</dt><dd>@retiro.DomicilioRetiro.Calle @retiro.DomicilioRetiro.Numero, @retiro.DomicilioRetiro.Localidad, @retiro.DomicilioRetiro.Departamento</dd>
                        <dt>Entrega en</dt><dd>@retiro.DomicilioDestino.Calle @retiro.DomicilioDestino.Numero, @retiro.DomicilioDestino.Localidad, @retiro.DomicilioDestino.Departamento</dd>
                        <dt>Hoja de ruta</dt><dd class="codigo">@(retiro.HojaDeRutaId?.ToString() ?? "Sin asignar")</dd>
                        <dt>Cuenta comercial</dt><dd class="codigo">@retiro.CuentaComercialId</dd>
                        <dt>Identificador</dt><dd class="codigo">@retiro.Id</dd>
                    </dl>
                </section>

                <section class="tarjeta">
                    <h2 class="titulo-tarjeta">Carga y tarifa</h2>
                    <dl class="cifras mb-6">
                        <div><dt>Peso total</dt><dd>@Formato.Numero(retiro.PesoTotalKg) kg</dd></div>
                        <div><dt>Volumen total</dt><dd>@Formato.Numero(retiro.VolumenTotalMetrosCubicos) m³</dd></div>
                        <div><dt>Tarifa</dt><dd>@(retiro.TarifaCalculada is decimal tarifa ? Formato.Moneda(tarifa) : "Sin tarifa")</dd></div>
                    </dl>
                    <div class="tabla tabla-holgada">
                        <table>
                            <thead>
                                <tr><th>Bulto</th><th>Medidas</th><th class="num">Volumen</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var bulto in retiro.Bultos)
                                {
                                    <tr>
                                        <td><b class="codigo">@bulto.Identificacion</b></td>
                                        <td>
                                            @Formato.Numero(bulto.PesoKg) kg
                                            <span class="linea2">@bulto.AltoCm × @bulto.AnchoCm × @bulto.ProfundidadCm cm</span>
                                        </td>
                                        <td class="num">@Formato.Numero(bulto.VolumenMetrosCubicos) m³</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="tarjeta">
                    <h2 class="titulo-tarjeta">Constancia del retiro</h2>
                    <dl class="datos">
                        <dt>Retirado</dt><dd>@(retiro.RetiradoEn is { } fecha ? Formato.Hora(fecha) : "Pendiente")</dd>
                        <dt>Fotografía</dt><dd>@(retiro.ReferenciaFotografia ?? "Sin registrar")</dd>
                        <dt>Firma</dt><dd>@(retiro.ReferenciaFirma ?? "Sin registrar")</dd>
                    </dl>
                </section>
            </div>

            @if (hayAcciones)
            {
                <aside class="tarjeta lg:sticky lg:top-[24px]">
                    @if (retiro.Estado == "Retirado")
                    {
                        <h2 class="titulo-tarjeta">Recibir en depósito</h2>
                        @if (retiro.HojaDeRutaId is Guid hojaId)
                        {
                            <p class="nota mb-4">Primero se verifican los bultos en el control de rendición de su hoja de ruta.</p>
                            <a asp-page="/Rendicion" asp-route-hojaId="@hojaId" class="btn-primario w-full justify-center">Ir a la rendición</a>
                        }
                        else
                        {
                            <p class="aviso">El retiro no tiene hoja de ruta asignada: no se puede hacer la rendición.</p>
                        }
                    }
                    else
                    {
                        <h2 class="titulo-tarjeta">Reprogramar</h2>
                        <form method="post" asp-page-handler="Gestionar" asp-route-id="@retiro.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accion" value="reprogramar" />
                            <p class="nota mb-4">El retiro vuelve a quedar disponible para asignarse a una ruta.</p>
                            <button type="submit" class="primario w-full">Reprogramar retiro</button>
                        </form>
                    }
                </aside>
            }
        </div>
    }
</div>
