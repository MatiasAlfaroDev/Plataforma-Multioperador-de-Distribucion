@page
@model UltimaMilla.Web.Backoffice.Pages.HojasDeRutaModel

@{
    ViewData["Title"] = "Hojas de ruta";
}

<div class="encabezado">
    <div>
        <h1>Hojas de ruta</h1>
        <p>Seleccioná los envíos, el repartidor y el vehículo. El sistema comprobará las restricciones y calculará el orden de las paradas.</p>
    </div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="aviso ok">
        @exito
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="aviso error">
        @Model.Error
    </div>
}

<p class="nota">
    Los datos corresponden al operador de tu sesión.
</p>

@if (Model.OperadorIdSesion != Guid.Empty){
    <h2>Crear hoja de ruta</h2>

    <form method="post">

        <div asp-validation-summary="All"
             class="error mb-3"></div>


        <!-- Fecha de reparto -->
        <div class="mb-3">
            <label asp-for="Formulario.Fecha">
                Fecha de reparto
            </label>

            <input asp-for="Formulario.Fecha"
                   type="date"
                   />

            <small class="nota">
                Día en que se realizará el reparto.
            </small>
        </div>

        <!-- Hora de salida -->
        <div class="mb-3">
            <label asp-for="Formulario.HoraSalida">
                Hora de salida
            </label>

            <input asp-for="Formulario.HoraSalida"
                   type="time"
                   />

            <small class="nota">
                Hora prevista de salida del repartidor.
            </small>
        </div>

        <!-- Franja horaria -->
        <div class="mb-3">
            <label asp-for="Formulario.FranjaSeleccionada">
                Franja horaria de entrega
            </label>

            <select asp-for="Formulario.FranjaSeleccionada"
                   >

                <option value="">
                    Seleccionar franja
                </option>

                @foreach (var franja in Model.Franjas)
                {
                    var valor =
                        $"{franja.HoraDesde:HH:mm}|{franja.HoraHasta:HH:mm}";

                    <option value="@valor">
                        @franja.HoraDesde.ToString("HH:mm")
                        -
                        @franja.HoraHasta.ToString("HH:mm")
                    </option>
                }
            </select>

            <span asp-validation-for="Formulario.FranjaSeleccionada"
                  class="error"></span>

            <small class="nota">
                Se utilizará para validar los horarios
                de los envíos seleccionados.
            </small>
        </div>

        <!-- Repartidor -->
        <div class="mb-3">
            <label asp-for="Formulario.RepartidorId">
                Repartidor
            </label>

            <select asp-for="Formulario.RepartidorId"
                   >

                <option value="">
                    Seleccionar repartidor
                </option>

                @foreach (var repartidor in Model.Repartidores)
                {
                    <option value="@repartidor.Id">
                        @repartidor.Nombre
                    </option>
                }
            </select>
        </div>

        <!-- Vehículo -->
        <div class="mb-3">
            <label asp-for="Formulario.VehiculoId">
                Vehículo
            </label>

            <select asp-for="Formulario.VehiculoId"
                   >

                <option value="">
                    Seleccionar vehículo
                </option>

                @foreach (var vehiculo in Model.Vehiculos)
                {
                    <option value="@vehiculo.Id">
                        @vehiculo.Matricula:
                        @vehiculo.CapacidadPesoKg kg,
                        @vehiculo.CapacidadVolumenM3 m³
                    </option>
                }
            </select>
        </div>

        <!-- Máximo de paradas -->
        <div class="mb-3">
            <label asp-for="Formulario.MaximoParadas">
                Máximo de paradas
            </label>

            <input asp-for="Formulario.MaximoParadas"
                   type="number"
                   min="1"
                   max="200"
                   />

            <span asp-validation-for="Formulario.MaximoParadas"
                  class="error"></span>
        </div>

        <!-- Selección de envíos -->
        <h3>Envíos disponibles</h3>

        <p class="nota">
            Seleccioná los envíos que querés incluir
            en esta hoja de ruta.
        </p>

        @if (Model.Envios.Count == 0)
        {
            <div class="aviso">
                <i class="ph ph-info"></i>
                <p>No hay envíos en depósito para este operador.</p>
            </div>
        }
        else
        {
            <div class="tabla">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Seleccionar</th>
                            <th>Referencia</th>
                            <th>Localidad</th>
                            <th>Peso</th>
                            <th>Compromiso actual</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var envio in Model.Envios)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="Formulario.EnviosIds"
                                           value="@envio.Id"
                                           checked="@(Model.Formulario.EnviosIds.Contains(envio.Id))" />
                                </td>

                                <td class="codigo">
                                    @envio.ReferenciaExterna
                                </td>

                                <td>
                                    @envio.Localidad
                                </td>

                                <td class="num">
                                    @envio.PesoKg kg
                                </td>

                                <td>
                                    @if (envio.TieneCompromiso)
                                    {
                                        <span>
                                            @envio.FechaComprometida
                                            |
                                            @envio.HoraDesde a @envio.HoraHasta
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nota">
                                            Se definirá al planificar
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <button type="submit"
                class="btn-primario"
                disabled="@(Model.Envios.Count == 0)">
            Crear y asignar hoja de ruta
        </button>
    </form>

    <hr class="my-4" />

    <!-- Listado de hojas de ruta -->
    <h2>Hojas de ruta creadas</h2>

    @if (Model.Hojas.Count == 0)
    {
        <p>
            Todavía no hay hojas de ruta para este operador.
        </p>
    }
    else
    {
        <div class="tabla">
            <table class="table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Salida</th>
                        <th>Paradas</th>
                        <th>Peso asignado</th>
                        <th>Identificador</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var hoja in Model.Hojas)
                    {
                        <tr>
                            <td>@hoja.Fecha</td>

                            <td>
                                @(hoja.HoraSalida?.ToString("HH:mm") ?? "Sin definir")
                            </td>

                            <td class="num">@hoja.CantidadParadas</td>

                            <td class="num">@hoja.PesoAsignadoKg kg</td>

                            <td class="codigo">@hoja.Id</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
