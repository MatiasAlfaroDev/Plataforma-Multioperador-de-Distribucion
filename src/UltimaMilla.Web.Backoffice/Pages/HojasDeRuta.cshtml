
@page
@model UltimaMilla.Web.Backoffice.Pages.HojasDeRutaModel

@{
    ViewData["Title"] = "Hojas de ruta";
}

<div class="encabezado">
    <div>
        <h1>Hojas de ruta</h1>
        <p>
            Planificá envíos y retiros seleccionando el repartidor,
            el vehículo y las operaciones que se incluirán en la ruta.
        </p>
    </div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="aviso ok" role="status">
        @exito
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="aviso error" role="alert">
        @Model.Error
    </div>
}

<p class="nota">
    Los datos corresponden al operador de tu sesión.
</p>

@if (Model.OperadorIdSesion != Guid.Empty)
{
    <h2>Crear hoja de ruta</h2>

    <form method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="error mb-3"></div>

        <div class="mb-3">
            <label asp-for="Formulario.Fecha">
                Fecha de reparto
            </label>

            <input asp-for="Formulario.Fecha"
                   type="date" />

            <small class="nota">
                Día en que se realizará la ruta.
            </small>
        </div>

        <div class="mb-3">
            <label asp-for="Formulario.HoraSalida">
                Hora de salida
            </label>

            <input asp-for="Formulario.HoraSalida"
                   type="time" />

            <small class="nota">
                Hora prevista de salida del repartidor.
            </small>
        </div>

        <div class="mb-3">
            <label asp-for="Formulario.FranjaSeleccionada">
                Franja horaria de entrega
            </label>

            <select asp-for="Formulario.FranjaSeleccionada">
                <option value="">
                    Seleccionar franja
                </option>

                @foreach (var franja in Model.Franjas)
                {
                    var valor =
                        $"{franja.HoraDesde:HH:mm}|{franja.HoraHasta:HH:mm}";

                    <option value="@valor">
                        @franja.HoraDesde.ToString("HH:mm")
                        -
                        @franja.HoraHasta.ToString("HH:mm")
                    </option>
                }
            </select>

            <span asp-validation-for="Formulario.FranjaSeleccionada"
                  class="error"></span>

            <small class="nota">
                La API validará la compatibilidad de horarios
                de las operaciones seleccionadas.
            </small>
        </div>

        <div class="mb-3">
            <label asp-for="Formulario.RepartidorId">
                Repartidor
            </label>

            <select asp-for="Formulario.RepartidorId">
                <option value="">
                    Seleccionar repartidor
                </option>

                @foreach (var repartidor in Model.Repartidores)
                {
                    <option value="@repartidor.Id">
                        @repartidor.Nombre
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Formulario.VehiculoId">
                Vehículo
            </label>

            <select asp-for="Formulario.VehiculoId">
                <option value="">
                    Seleccionar vehículo
                </option>

                @foreach (var vehiculo in Model.Vehiculos)
                {
                    <option value="@vehiculo.Id">
                        @vehiculo.Matricula:
                        @vehiculo.CapacidadPesoKg kg,
                        @vehiculo.CapacidadVolumenM3 m³
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Formulario.MaximoParadas">
                Máximo de paradas
            </label>

            <input asp-for="Formulario.MaximoParadas"
                   type="number"
                   min="1"
                   max="200" />

            <span asp-validation-for="Formulario.MaximoParadas"
                  class="error"></span>
        </div>

        <h3>Envíos disponibles</h3>

        <p class="nota">
            Seleccioná los envíos que querés incluir
            en esta hoja de ruta.
        </p>

        @if (Model.Envios.Count == 0)
        {
            <div class="aviso">
                <i class="ph ph-info"></i>
                <p>
                    No hay envíos disponibles para este operador.
                </p>
            </div>
        }
        else
        {
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Seleccionar</th>
                            <th>Referencia</th>
                            <th>Localidad</th>
                            <th>Peso</th>
                            <th>Compromiso actual</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var envio in Model.Envios)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="Formulario.EnviosIds"
                                           value="@envio.Id"
                                           checked="@(Model.Formulario.EnviosIds.Contains(envio.Id))" />
                                </td>

                                <td class="codigo">
                                    @envio.ReferenciaExterna
                                </td>

                                <td>
                                    @envio.Localidad
                                </td>

                                <td class="num">
                                    @envio.PesoKg kg
                                </td>

                                <td>
                                    @if (envio.TieneCompromiso)
                                    {
                                        <span>
                                            @envio.FechaComprometida
                                            |
                                            @envio.HoraDesde a @envio.HoraHasta
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nota">
                                            Se definirá al planificar
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h3 class="mt-6">Retiros disponibles</h3>

        <p class="nota">
            Seleccioná los retiros solicitados por los comercios.
            Solo aparecen los que todavía no fueron asignados
            a una hoja de ruta.
        </p>

        @if (Model.Retiros.Count == 0)
        {
            <div class="aviso">
                <i class="ph ph-info"></i>
                <p>
                    No hay retiros pendientes de asignación.
                </p>
            </div>
        }
        else
        {
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Seleccionar</th>
                            <th>Motivo</th>
                            <th>Domicilio de retiro</th>
                            <th>Fecha</th>
                            <th>Franja</th>
                            <th>Peso (kg)</th>
                            <th>Bultos</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var retiro in Model.Retiros)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="Formulario.RetirosIds"
                                           value="@retiro.Id"
                                           checked="@(Model.Formulario.RetirosIds.Contains(retiro.Id))" />
                                </td>

                                <td>
                                    @retiro.Motivo
                                </td>

                                <td>
                                    @retiro.DomicilioRetiro.Calle
                                    @retiro.DomicilioRetiro.Numero,
                                    @retiro.DomicilioRetiro.Localidad
                                </td>

                                <td>
                                    @retiro.FechaSolicitada.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @retiro.HoraDesde.ToString("HH:mm")
                                    -
                                    @retiro.HoraHasta.ToString("HH:mm")
                                </td>

                                <td class="num">
                                    @retiro.PesoTotalKg.ToString("N2")
                                </td>

                                <td class="num">
                                    @retiro.Bultos.Count
                                </td>

                                <td>
                                    <a asp-page="/DetalleRetiro"
                                       asp-route-id="@retiro.Id"
                                       class="btn-secundario py-1.5 text-sm">
                                        Ver detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-6">
            <button type="submit"
                    class="btn-primario"
                    disabled="@(Model.Envios.Count == 0 && Model.Retiros.Count == 0)">
                Crear y asignar hoja de ruta
            </button>
        </div>
    </form>

    <hr class="my-4" />

    <h2>Hojas de ruta creadas</h2>

    @if (Model.Hojas.Count == 0)
    {
        <p>
            Todavía no hay hojas de ruta para este operador.
        </p>
    }
    else
    {
        <div class="tabla">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Salida</th>
                        <th>Paradas</th>
                        <th>Peso asignado</th>
                        <th>Identificador</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var hoja in Model.Hojas)
                    {
                        <tr>
                            <td>
                                @hoja.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(hoja.HoraSalida?.ToString("HH:mm")
                                    ?? "Sin definir")
                            </td>

                            <td class="num">
                                @hoja.CantidadParadas
                            </td>

                            <td class="num">
                                @hoja.PesoAsignadoKg kg
                            </td>

                            <td class="codigo">
                                @hoja.Id
                            </td>

                            <td>
                                @if (hoja.Despachada)
                                {
                                    <span class="estado-despachada">
                                        Despachada
                                    </span>
                                }
                                else
                                {
                                    <form method="post"
                                          asp-page-handler="Despachar"
                                          asp-route-hojaId="@hoja.Id">

                                        @Html.AntiForgeryToken()

                                        <button type="button"
                                                class="btn-primario"
                                                onclick="abrirConfirmacionDespacho(this)">
                                            Despachar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <dialog id="confirmarDespacho"
                class="modal-despacho">

            <h2>Confirmar despacho</h2>

            <p>
                ¿Confirmás que querés despachar esta hoja de ruta?
            </p>

            <p class="nota">
                La API verificará las condiciones de despacho
                de las operaciones asignadas.
            </p>

            <div class="acciones-modal">
                <button type="button"
                        class="btn-secundario"
                        onclick="cerrarConfirmacionDespacho()">
                    Cancelar
                </button>

                <button type="button"
                        class="btn-primario"
                        onclick="confirmarDespacho()">
                    Confirmar despacho
                </button>
            </div>
        </dialog>

        <script>
            let formularioDespacho = null;

            function abrirConfirmacionDespacho(boton) {
                formularioDespacho = boton.closest("form");

                document.getElementById(
                    "confirmarDespacho"
                ).showModal();
            }

            function cerrarConfirmacionDespacho() {
                document.getElementById(
                    "confirmarDespacho"
                ).close();

                formularioDespacho = null;
            }

            function confirmarDespacho() {
                if (formularioDespacho) {
                    formularioDespacho.requestSubmit();
                }
            }
        </script>
    }
}
