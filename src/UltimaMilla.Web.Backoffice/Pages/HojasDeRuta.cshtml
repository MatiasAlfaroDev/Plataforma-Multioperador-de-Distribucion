@page
@model UltimaMilla.Web.Backoffice.Pages.HojasDeRutaModel

@{
    ViewData["Title"] = "Hojas de ruta";

    // Fecha actual en Uruguay.
    var zonaUruguay = TimeZoneInfo.FindSystemTimeZoneById(
        "America/Montevideo");

    var ahoraUruguay = TimeZoneInfo.ConvertTime(
        DateTimeOffset.UtcNow,
        zonaUruguay).DateTime;
    var hoy = DateOnly.FromDateTime(ahoraUruguay);

    // Un retiro vencido (su franja ya pasó) se puede llevar a una hoja de una fecha posterior.
    bool RetiroVaEnHoja(RetiroRutaApiDto r, DateOnly fecha) =>
        r.Fecha == fecha ||
        (r.Fecha < fecha && r.Fecha.ToDateTime(r.HoraHasta) <= ahoraUruguay);
}

<partial name="_Toast" model="(false, Model.Error)" />

@if (Model.OperadorIdSesion != Guid.Empty)
{
    var franjas = Model.Franjas.Select(f => (Valor: $"{f.HoraDesde:HH:mm}|{f.HoraHasta:HH:mm}", Texto: $"{f.HoraDesde:HH:mm}–{f.HoraHasta:HH:mm}")).ToList();

    <div class="pagina">
        <form method="post" id="formHoja">
            <div class="grid items-start gap-[24px] lg:grid-cols-[minmax(0,1fr)_320px]">
                <div class="grid gap-[24px]">
                    <section class="tarjeta">
                        <h2 class="titulo-tarjeta"><span class="paso">1</span>Datos de la hoja</h2>
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div class="campo">
                                <label asp-for="Formulario.Fecha">Fecha de reparto</label>
                                <input asp-for="Formulario.Fecha" type="date" />
                                <span asp-validation-for="Formulario.Fecha"></span>
                            </div>
                            <div class="campo">
                                <label asp-for="Formulario.HoraSalida">Hora de salida</label>
                                <input asp-for="Formulario.HoraSalida" type="time" />
                                <span asp-validation-for="Formulario.HoraSalida"></span>
                            </div>
                            <div class="campo">
                                <label asp-for="Formulario.FranjaSeleccionada">Franja de entrega</label>
                                <select asp-for="Formulario.FranjaSeleccionada">
                                    <option value="">Elegí una franja…</option>
                                    @foreach (var franja in franjas)
                                    {
                                        <option value="@franja.Valor">@franja.Texto</option>
                                    }
                                </select>
                                <span asp-validation-for="Formulario.FranjaSeleccionada"></span>
                            </div>
                            <div class="campo">
                                <label asp-for="Formulario.RepartidorId">Repartidor</label>
                                <select asp-for="Formulario.RepartidorId">
                                    <option value="">Elegí un repartidor…</option>
                                    @foreach (var repartidor in Model.Repartidores)
                                    {
                                        <option value="@repartidor.Id">@repartidor.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="Formulario.RepartidorId"></span>
                            </div>
                            <div class="campo">
                                <label asp-for="Formulario.VehiculoId">Vehículo</label>
                                <select asp-for="Formulario.VehiculoId">
                                    <option value="">Elegí un vehículo…</option>
                                    @foreach (var vehiculo in Model.Vehiculos)
                                    {
                                        <option value="@vehiculo.Id">@vehiculo.Matricula · @vehiculo.CapacidadPesoKg kg, @vehiculo.CapacidadVolumenM3 m³</option>
                                    }
                                </select>
                                <span asp-validation-for="Formulario.VehiculoId"></span>
                            </div>
                            <div class="campo">
                                <label asp-for="Formulario.MaximoParadas">Máximo de paradas</label>
                                <input asp-for="Formulario.MaximoParadas" type="number" min="1" max="200" />
                                <span asp-validation-for="Formulario.MaximoParadas"></span>
                            </div>
                        </div>
                    </section>

                    <section class="tarjeta">
                        <h2 class="titulo-tarjeta"><span class="paso">2</span>Envíos en depósito</h2>
                        @if (Model.Envios.Count == 0)
                        {
                            <p class="vacio">No hay envíos en depósito.</p>
                        }
                        else
                        {
                            <div class="tabla tabla-holgada">
                                <table>
                                    <thead>
                                        <tr><th class="w-10"></th><th>Envío</th><th class="num">Peso</th><th>Compromiso</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var envio in Model.Envios)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="Formulario.EnviosIds" value="@envio.Id" id="envio-@envio.Id"
                                                           checked="@(Model.Formulario.EnviosIds.Contains(envio.Id))" />
                                                </td>
                                                <td>
                                                    <label for="envio-@envio.Id" class="m-0 cursor-pointer font-semibold"><span class="codigo">@envio.ReferenciaExterna</span></label>
                                                    <span class="linea2">@envio.Localidad</span>
                                                </td>
                                                <td class="num">@envio.PesoKg kg</td>
                                                <td>
                                                    @if (envio.TieneCompromiso)
                                                    {
                                                        @envio.FechaComprometida <span class="linea2">@envio.HoraDesde–@envio.HoraHasta</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="nota">Se define al planificar</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="tarjeta">
                        <h2 class="titulo-tarjeta"><span class="paso">3</span>Devoluciones al comercio</h2>
                        <p class="nota mb-4">Van a la dirección de recepción de la cuenta comercial. Solo aparecen las cuentas con dirección dentro de una zona de cobertura.</p>
                        @if (Model.Devoluciones.Count == 0)
                        {
                            <p class="vacio">No hay devoluciones pendientes de asignar.</p>
                        }
                        else
                        {
                            <div class="tabla tabla-holgada">
                                <table>
                                    <thead>
                                        <tr><th class="w-10"></th><th>Envío</th><th>Estado</th><th class="num">Peso</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var devolucion in Model.Devoluciones)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="Formulario.DevolucionesIds" value="@devolucion.Id" id="devolucion-@devolucion.Id"
                                                           checked="@(Model.Formulario.DevolucionesIds.Contains(devolucion.Id))" />
                                                </td>
                                                <td>
                                                    <label for="devolucion-@devolucion.Id" class="m-0 cursor-pointer font-semibold"><span class="codigo">@devolucion.ReferenciaExterna</span></label>
                                                    <span class="linea2">@devolucion.Localidad</span>
                                                </td>
                                                <td><span class="chip chip-peligro">@devolucion.Estado</span></td>
                                                <td class="num">@devolucion.PesoKg kg</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    @if (Model.RetiroHabilitado)
                    {
                        <section class="tarjeta">
                            <h2 class="titulo-tarjeta"><span class="paso">4</span>Retiros a domicilio</h2>
                            <p class="nota mb-4">Hoja mixta (RF 39): lo retirado ocupa lugar desde la parada en que sube, y la API valida la capacidad parada por parada.</p>
                            @if (Model.Retiros.Count == 0 && Model.EntregasRetiros.Count == 0)
                            {
                                <p class="vacio">No hay retiros pendientes de asignar.</p>
                            }
                            else
                            {
                                <div class="tabla tabla-holgada">
                                    <table>
                                        <thead>
                                            <tr><th class="w-10"></th><th>Parada</th><th>Localidad</th><th class="num">Peso</th><th>Franja</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var retiro in Model.Retiros)
                                            {
                                                <tr data-fecha-retiro="@retiro.Fecha.ToString("yyyy-MM-dd")"
                                                    data-retiro-vencido="@((retiro.Fecha.ToDateTime(retiro.HoraHasta) <= ahoraUruguay) ? "true" : "false")">
                                                    <td>
                                                        <input type="checkbox" name="Formulario.RetirosIds" value="@retiro.Id" id="retiro-@retiro.Id"
                                                               checked="@(Model.Formulario.RetirosIds.Contains(retiro.Id))" />
                                                    </td>
                                                    <td>
                                                        <label for="retiro-@retiro.Id" class="m-0 cursor-pointer font-semibold"><i class="ph ph-arrow-circle-up"></i> Retiro, sube carga</label>
                                                        <span class="linea2">@retiro.Motivo</span>
                                                    </td>
                                                    <td>@retiro.Localidad</td>
                                                    <td class="num">@retiro.PesoKg kg</td>
                                                    <td>@retiro.Fecha <span class="linea2">@retiro.HoraDesde–@retiro.HoraHasta</span></td>
                                                </tr>
                                            }
                                            @foreach (var entrega in Model.EntregasRetiros)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" name="Formulario.EntregasRetirosIds" value="@entrega.Id" id="entrega-@entrega.Id"
                                                               checked="@(Model.Formulario.EntregasRetirosIds.Contains(entrega.Id))" />
                                                    </td>
                                                    <td>
                                                        <label for="entrega-@entrega.Id" class="m-0 cursor-pointer font-semibold"><i class="ph ph-arrow-circle-down"></i> Entrega al comercio, baja carga</label>
                                                        <span class="linea2">@entrega.Motivo</span>
                                                    </td>
                                                    <td>@entrega.Localidad</td>
                                                    <td class="num">@entrega.PesoKg kg</td>
                                                    <td>—</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>
                    }
                </div>

                <aside class="tarjeta lg:sticky lg:top-[24px]">
                    <h2 class="titulo-tarjeta">Nueva hoja de ruta</h2>
                    <dl class="resumen">
                        <dt>Paradas elegidas</dt><dd id="paradasElegidas">0</dd>
                    </dl>
                    <div asp-validation-summary="All" class="secciones text-peligro"></div>
                    <p class="nota mb-5">La API comprueba las restricciones del vehículo y calcula el orden de las paradas.</p>
                    <button type="submit" class="primario h-[44px] w-full"
                            disabled="@(Model.Envios.Count + Model.Retiros.Count + Model.EntregasRetiros.Count + Model.Devoluciones.Count == 0)">
                        <i class="ph ph-path"></i>Crear y asignar
                    </button>
                </aside>
            </div>
        </form>

        <section class="tarjeta">
            <h2 class="titulo-tarjeta">Hojas de ruta <span class="chip">@Model.Hojas.Count</span></h2>
            @if (Model.Hojas.Count == 0)
            {
                <p class="vacio">Todavía no hay hojas de ruta.</p>
            }
            else
            {
                <div class="tabla tabla-holgada">
                    <table>
                        <thead>
                            <tr><th>Hoja</th><th class="num">Paradas</th><th class="num">Peso</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var hoja in Model.Hojas)
                            {
                                var anterior = hoja.Fecha < hoy;
                                <tr>
                                    <td>
                                        <b>@hoja.Fecha</b>
                                        <span class="linea2">Sale @(hoja.HoraSalida?.ToString("HH:mm") ?? "sin hora") · <span class="codigo" title="@hoja.Id">@hoja.Id.ToString()[..8]</span></span>
                                    </td>
                                    <td class="num">@hoja.CantidadParadas</td>
                                    <td class="num">@hoja.PesoAsignadoKg kg</td>
                                    <td>
                                        @if (hoja.Rendida)
                                        {
                                            <span class="chip chip-exito">Rendida</span>
                                        }
                                        else if (hoja.PendienteDeControl)
                                        {
                                            @* RF 22: el repartidor ya rindió desde la app; el depósito controla y cierra. *@
                                            <span class="chip chip-alerta">Rendida por el repartidor</span>
                                        }
                                        else if (hoja.Despachada)
                                        {
                                            <span class="chip chip-acento">En ruta</span>
                                            <span class="linea2">@(anterior ? "De una fecha anterior" : "Se rinde desde la app al volver")</span>
                                        }
                                        else
                                        {
                                            <span class="chip">En preparación</span>
                                            @if (anterior)
                                            {
                                                <span class="linea2">De una fecha anterior: no admite envíos</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <div class="flex flex-wrap items-center justify-end gap-2">
                                            @if (hoja.PendienteDeControl)
                                            {
                                                <a asp-page="/Rendicion" asp-route-hojaId="@hoja.Id" class="btn-primario btn-chico">Controlar rendición</a>
                                            }
                                            else if (hoja.Despachada && !hoja.Rendida && hoja.Fecha == hoy && Model.Envios.Count > 0)
                                            {
                                                @* Solo se permiten envíos urgentes en hojas despachadas de hoy. *@
                                                <details class="relative">
                                                    <summary class="btn-secundario btn-chico list-none [&::-webkit-details-marker]:hidden"><i class="ph ph-lightning"></i>Agregar urgente</summary>
                                                    <form method="post" asp-page-handler="AgregarUrgente" asp-route-hojaId="@hoja.Id"
                                                          class="absolute right-0 z-10 mt-2 grid w-72 gap-3 rounded-xl border border-borde bg-superficie p-4 shadow-lg">
                                                        @Html.AntiForgeryToken()
                                                        <div class="campo">
                                                            <label for="urgente-@hoja.Id">Envío</label>
                                                            <select id="urgente-@hoja.Id" name="envioUrgenteId" required>
                                                                <option value="">Elegí un envío…</option>
                                                                @foreach (var envio in Model.Envios)
                                                                {
                                                                    <option value="@envio.Id">@envio.ReferenciaExterna (@envio.Localidad)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="campo">
                                                            <label for="franja-urgente-@hoja.Id">Franja</label>
                                                            <select id="franja-urgente-@hoja.Id" name="franjaUrgente">
                                                                @foreach (var franja in franjas)
                                                                {
                                                                    <option value="@franja.Valor">@franja.Texto</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <button type="submit" class="primario">Agregar urgente</button>
                                                    </form>
                                                </details>
                                            }
                                            else if (!hoja.Despachada && !anterior)
                                            {
                                                @if (Model.Envios.Count > 0)
                                                {
                                                    <details class="relative">
                                                        <summary class="btn-secundario btn-chico list-none [&::-webkit-details-marker]:hidden"><i class="ph ph-plus"></i>Envío</summary>
                                                        <form method="post" asp-page-handler="AgregarEnvio" asp-route-hojaId="@hoja.Id"
                                                              class="absolute right-0 z-10 mt-2 grid w-72 gap-3 rounded-xl border border-borde bg-superficie p-4 shadow-lg">
                                                            @Html.AntiForgeryToken()
                                                            <div class="campo">
                                                                <label for="envio-hoja-@hoja.Id">Envío</label>
                                                                <select id="envio-hoja-@hoja.Id" name="envioId" required>
                                                                    <option value="">Elegí un envío…</option>
                                                                    @foreach (var envio in Model.Envios)
                                                                    {
                                                                        <option value="@envio.Id">@envio.ReferenciaExterna (@envio.Localidad)</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="campo">
                                                                <label for="franja-hoja-@hoja.Id">Franja</label>
                                                                <select id="franja-hoja-@hoja.Id" name="franjaSeleccionada" required>
                                                                    @foreach (var franja in franjas)
                                                                    {
                                                                        <option value="@franja.Valor">@franja.Texto</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <button type="submit" class="primario">Agregar envío</button>
                                                        </form>
                                                    </details>
                                                }

                                                @* RF 39: mientras la hoja está en preparación se le puede sumar un retiro del mismo día. *@
                                                var retirosDelDia = Model.Retiros.Where(r => RetiroVaEnHoja(r, hoja.Fecha)).ToList();
                                                @if (Model.RetiroHabilitado && retirosDelDia.Count > 0)
                                                {
                                                    <details class="relative">
                                                        <summary class="btn-secundario btn-chico list-none [&::-webkit-details-marker]:hidden"><i class="ph ph-plus"></i>Retiro</summary>
                                                        <form method="post" asp-page-handler="AgregarRetiro" asp-route-hojaId="@hoja.Id"
                                                              class="absolute right-0 z-10 mt-2 grid w-80 gap-3 rounded-xl border border-borde bg-superficie p-4 shadow-lg">
                                                            @Html.AntiForgeryToken()
                                                            <div class="campo">
                                                                <label for="retiro-hoja-@hoja.Id">Retiro</label>
                                                                <select id="retiro-hoja-@hoja.Id" name="retiroId" required>
                                                                    <option value="">Elegí un retiro…</option>
                                                                    @foreach (var retiro in retirosDelDia)
                                                                    {
                                                                        <option value="@retiro.Id">@retiro.Motivo (@retiro.Localidad, @retiro.HoraDesde–@retiro.HoraHasta)</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <button type="submit" class="primario">Agregar retiro</button>
                                                        </form>
                                                    </details>
                                                }

                                                <form method="post" asp-page-handler="Despachar" asp-route-hojaId="@hoja.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="primario btn-chico" onclick="abrirConfirmacionDespacho(this)">
                                                        <i class="ph ph-paper-plane-tilt"></i>Despachar
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <dialog id="confirmarDespacho" class="modal-despacho">
        <h2 class="titulo-tarjeta">Confirmar despacho</h2>
        <p>¿Despachás esta hoja de ruta?</p>
        <p class="nota mt-2">Las entregas pasan a En tránsito; las devoluciones siguen En devolución hasta llegar al comercio.</p>
        <div class="acciones-modal">
            <button type="button" onclick="cerrarConfirmacionDespacho()">Cancelar</button>
            <button type="button" class="primario" onclick="confirmarDespacho()">Confirmar despacho</button>
        </div>
    </dialog>

    <script>
        let formularioDespacho = null;

        function abrirConfirmacionDespacho(boton) {
            formularioDespacho = boton.closest("form");
            document.getElementById("confirmarDespacho").showModal();
        }

        function cerrarConfirmacionDespacho() {
            document.getElementById("confirmarDespacho").close();
            formularioDespacho = null;
        }

        function confirmarDespacho() {
            if (formularioDespacho) {
                formularioDespacho.requestSubmit();
            }
        }

        // El resumen cuenta las paradas marcadas en las tres tablas.
        (() => {
            const form = document.getElementById("formHoja");
            const contador = document.getElementById("paradasElegidas");
            const contar = () => contador.textContent = form.querySelectorAll('input[type=checkbox][name^="Formulario."]:checked').length;
            form.addEventListener("change", contar);
            contar();
        })();
    </script>
}

@* Un retiro va en una hoja de su misma fecha, o de una posterior si ya está vencido: se ocultan los demás. *@
<script>
    (() => {
        const fecha = document.getElementById("Formulario_Fecha");
        if (!fecha) return;
        const filtrar = () => document.querySelectorAll("[data-fecha-retiro]").forEach(fila => {
            const mismoDia = fila.dataset.fechaRetiro === fecha.value ||
                (fila.dataset.retiroVencido === "true" && fila.dataset.fechaRetiro < fecha.value);
            fila.hidden = !mismoDia;
            if (!mismoDia) fila.querySelector("input").checked = false;
        });
        fecha.addEventListener("change", filtrar);
        filtrar();
    })();
</script>
