
@page
@model UltimaMilla.Web.Backoffice.Pages.ConfiguracionOperadorModel

@{
    ViewData["Title"] = "Identidad visual";
}

<div class="pagina">
    <partial name="_Toast" model="(false, Model.Error)" />

    @if (Model.Operador is not null)
    {
        <section class="tarjeta max-w-[720px]">
            <h2 class="titulo-tarjeta">Identidad visual</h2>
            <form method="post" class="grid gap-5">
                @Html.AntiForgeryToken()
                <dl class="datos">
                    <dt>Operador</dt><dd class="font-semibold">@Model.Operador.Nombre</dd>
                </dl>
                <div class="campo">
                    <label asp-for="ColorPrimario">Color principal</label>
                    <div class="flex items-center gap-3">
                        <input type="color" id="selectorColor" value="@Model.ColorPrimario" class="h-[41px] w-16 cursor-pointer p-1" aria-label="Elegir color" />
                        <input asp-for="ColorPrimario" id="ColorPrimario" class="w-36 font-display tabular-nums" maxlength="7" />
                    </div>
                    <span asp-validation-for="ColorPrimario"></span>
                </div>
                <div class="rounded-xl border border-borde p-4">
                    <p class="etiqueta mb-3">Así se ve en el seguimiento público</p>
                    <div class="flex items-center gap-3 rounded-xl border-t-4 bg-hundido p-4" id="vistaPrevia" style="border-top-color: @Model.ColorPrimario">
                        <span class="grid size-11 place-items-center rounded-xl text-2xl text-white" id="vistaPreviaIcono" style="background-color: @Model.ColorPrimario"><i class="ph ph-truck"></i></span>
                        <div>
                            <b class="block">@Model.Operador.Nombre</b>
                            <span class="nota">Operador responsable de tu envío</span>
                        </div>
                    </div>
                </div>
                <div>
                    <button type="submit" class="primario">Guardar cambios</button>
                </div>
            </form>
        </section>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const selector = document.getElementById("selectorColor");
        const campo = document.getElementById("ColorPrimario");

        if (!selector || !campo) return;

        const pintar = color => {
            document.getElementById("vistaPrevia").style.borderTopColor = color;
            document.getElementById("vistaPreviaIcono").style.backgroundColor = color;
        };

        selector.addEventListener("input", () => {
            campo.value = selector.value.toUpperCase();
            pintar(selector.value);
        });

        campo.addEventListener("input", () => {
            if (/^#[0-9A-Fa-f]{6}$/.test(campo.value)) {
                selector.value = campo.value;
                pintar(campo.value);
            }
        });
    });
</script>
