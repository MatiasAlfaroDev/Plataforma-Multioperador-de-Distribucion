@page
@model UltimaMilla.Web.Backoffice.Pages.RegistroModel

@{
    ViewData["Title"] = "Registrar operador";
}

<form id="formRegistro" class="grid gap-[24px]" novalidate>
    <section class="tarjeta">
        <h2 class="titulo-tarjeta"><span class="paso">1</span>Administrador</h2>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="campo sm:col-span-2">
                <label for="nombreCompleto">Nombre completo</label>
                <input id="nombreCompleto" type="text" maxlength="150" autocomplete="name" required data-mensaje="Ingresá tu nombre." />
                <span class="field-validation-error" data-error-de="nombreCompleto"></span>
            </div>
            <div class="campo sm:col-span-2">
                <label for="email">Correo electrónico</label>
                <input id="email" type="email" autocomplete="email" required data-mensaje="Ingresá tu correo." />
                <span class="field-validation-error" data-error-de="email"></span>
            </div>
            <div class="campo">
                <label for="password">Contraseña</label>
                <input id="password" type="password" autocomplete="new-password" required
                       pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" data-mensaje="Elegí una contraseña."
                       data-formato="Mínimo 8 caracteres, con mayúscula, minúscula y número." />
                <span class="field-validation-error" data-error-de="password"></span>
            </div>
            <div class="campo">
                <label for="confirmarPassword">Repetí la contraseña</label>
                <input id="confirmarPassword" type="password" autocomplete="new-password" required data-mensaje="Repetí la contraseña." />
                <span class="field-validation-error" data-error-de="confirmarPassword"></span>
            </div>
        </div>
        <p class="nota mt-3">8 caracteres o más, con mayúscula, minúscula y número.</p>
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta"><span class="paso">2</span>Operador</h2>
        <div class="grid gap-4 sm:grid-cols-[2fr_1fr]">
            <div class="campo">
                <label for="nombreOperador">Nombre del operador logístico</label>
                <input id="nombreOperador" type="text" required data-mensaje="Ingresá el nombre del operador." />
                <span class="field-validation-error" data-error-de="nombreOperador"></span>
            </div>
            <div class="campo">
                <label for="colorPrimario">Color principal</label>
                <input id="colorPrimario" type="color" value="#2563EB" class="h-[41px] cursor-pointer p-1" required />
            </div>
            <div class="campo sm:col-span-2">
                <label for="emailContacto">Correo de contacto</label>
                <input id="emailContacto" type="email" required data-mensaje="Ingresá el correo de contacto." />
                <span class="field-validation-error" data-error-de="emailContacto"></span>
            </div>
        </div>
    </section>

    <button class="primario h-[44px] w-full" type="submit" id="btnRegistro">Crear cuenta</button>
</form>

<p class="nota text-center">¿Ya tenés una cuenta? <a asp-page="/Login">Iniciar sesión</a></p>

<script>
    (() => {
        const form = document.getElementById("formRegistro");
        const boton = document.getElementById("btnRegistro");
        const valor = id => document.getElementById(id).value.trim();

        // Mismas reglas que la API y que Identity; cada error va debajo de su campo.
        function mensajeDe(campo) {
            const v = campo.validity;
            if (v.valueMissing) return campo.dataset.mensaje;
            if (v.typeMismatch) return "El correo no es válido.";
            if (v.patternMismatch) return campo.dataset.formato;
            if (campo.id === "confirmarPassword" && campo.value !== document.getElementById("password").value)
                return "Las contraseñas no coinciden.";
            return "";
        }

        function validar(campo) {
            const salida = form.querySelector(`[data-error-de="${campo.id}"]`);
            if (!salida) return true;
            const mensaje = mensajeDe(campo);
            salida.textContent = mensaje;
            campo.classList.toggle("input-validation-error", mensaje !== "");
            return mensaje === "";
        }

        form.querySelectorAll("input[data-mensaje]").forEach(campo =>
            campo.addEventListener("blur", () => validar(campo)));

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const campos = [...form.querySelectorAll("input[data-mensaje]")];
            const validos = campos.map(validar).every(Boolean);
            if (!validos) {
                campos.find(c => c.classList.contains("input-validation-error"))?.focus();
                return;
            }

            boton.disabled = true;
            boton.textContent = "Creando la cuenta…";

            try {
                const respuesta = await fetch("/api/auth/registro-operador", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        nombreCompleto: valor("nombreCompleto"),
                        email: valor("email"),
                        password: document.getElementById("password").value,
                        confirmarPassword: document.getElementById("confirmarPassword").value,
                        nombreOperador: valor("nombreOperador"),
                        colorPrimario: document.getElementById("colorPrimario").value,
                        emailContacto: valor("emailContacto")
                    })
                });

                if (!respuesta.ok) {
                    const resultadoError = await respuesta.json().catch(() => null);
                    throw new Error(resultadoError?.mensaje || "No se pudo registrar el operador.");
                }

                window.toast(true, "Operador registrado. Te llevamos al inicio de sesión…");
                form.reset();
                setTimeout(() => window.location.assign("/Login"), 1200);
            } catch (ex) {
                window.toast(false, ex.message);
                boton.disabled = false;
                boton.textContent = "Crear cuenta";
            }
        });
    })();
</script>
