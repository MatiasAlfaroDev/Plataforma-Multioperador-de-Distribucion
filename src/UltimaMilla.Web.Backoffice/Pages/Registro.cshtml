@page
@model UltimaMilla.Web.Backoffice.Pages.RegistroModel

@{
    ViewData["Title"] = "Registrar operador";
}

<div class="encabezado">
    <div>
        <h1>Registrar operador logístico</h1>
        <p>Creá una cuenta de administrador para gestionar tu operador logístico en ÚltimaMilla.</p>
    </div>
</div>

<form id="formRegistro" class="tarjeta max-w-2xl">
    <h2>Datos del administrador</h2>

    <div class="campos">
        <div>
            <label for="nombreCompleto">Nombre completo</label>
            <input id="nombreCompleto"
                   type="text"
                   maxlength="150"
                   autocomplete="name"
                   required />
        </div>

        <div>
            <label for="email">Correo electrónico</label>
            <input id="email"
                   type="email"
                   autocomplete="email"
                   required />
        </div>

        <div>
            <label for="password">Contraseña</label>
            <input id="password"
                   type="password"
                   minlength="8"
                   autocomplete="new-password"
                   required />
        </div>

        <div>
            <label for="confirmarPassword">Confirmar contraseña</label>
            <input id="confirmarPassword"
                   type="password"
                   minlength="8"
                   autocomplete="new-password"
                   required />
        </div>
    </div>

    <p id="mensajePassword" class="error" role="alert"></p>

    <h2>Datos del operador</h2>

    <div class="campos">
        <div>
            <label for="nombreOperador">Nombre del operador logístico</label>
            <input id="nombreOperador"
                   type="text"
                   required />
        </div>

        <div>
            <label for="colorPrimario">Color principal</label>
            <input id="colorPrimario"
                   type="color"
                   value="#2563EB"
                   required />
        </div>

        <div>
            <label for="emailContacto">Correo de contacto</label>
            <input id="emailContacto"
                   type="email"
                   required />
        </div>
    </div>

    <div class="acciones">
        <button class="primario"
                type="submit"
                id="btnRegistro">
            Crear cuenta
        </button>
    </div>

    <p id="mensajeError" class="error" role="alert"></p>
    <p id="mensajeExito" class="ok" role="status"></p>
</form>

<p>
    ¿Ya tenés una cuenta?
    <a asp-page="/Login">Iniciar sesión</a>
</p>

<script>
    document.getElementById("formRegistro")
        .addEventListener("submit", async (event) => {

            event.preventDefault();

            const boton = document.getElementById("btnRegistro");
            const error = document.getElementById("mensajeError");
            const exito = document.getElementById("mensajeExito");

            boton.disabled = true;
            error.textContent = "";
            exito.textContent = "";

            const password = document.getElementById("password").value;
            const confirmarPassword =
                document.getElementById("confirmarPassword").value;

            const mensajePassword =
                document.getElementById("mensajePassword");

            mensajePassword.textContent = "";

            if (password !== confirmarPassword) {
                mensajePassword.textContent =
                    "Las contraseñas no coinciden. Verificá e intentá nuevamente.";

                boton.disabled = false;
                return;
            }

            const datos = {
                nombreCompleto: document.getElementById("nombreCompleto").value.trim(),
                email: document.getElementById("email").value.trim(),
                password: password,
                confirmarPassword: confirmarPassword,
                nombreOperador: document.getElementById("nombreOperador").value.trim(),
                colorPrimario: document.getElementById("colorPrimario").value,
                emailContacto: document.getElementById("emailContacto").value.trim()
            };

            try {
                const respuesta = await fetch("/api/auth/registro-operador", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify(datos)
                });

                if (!respuesta.ok) {
                    const resultadoError = await respuesta.json().catch(() => null);

                    throw new Error(
                        resultadoError?.mensaje ||
                        "No se pudo registrar el operador."
                    );
                }

                exito.textContent =
                    "Operador registrado correctamente. Redirigiendo al inicio de sesión...";

                document.getElementById("formRegistro").reset();

                window.location.assign("/Login");

            } catch (ex) {
                error.textContent = ex.message;
            } finally {
                boton.disabled = false;
            }
        });
</script>
