@page "/seleccionar-comercio"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject IJSRuntime JS
@inject NavigationManager Navegacion
@inject Notificaciones Notificaciones

<PageTitle>Seleccionar comercio - Última Milla</PageTitle>

<section class="tarjeta max-w-[480px]">
    <h1 class="titulo-tarjeta">Elegí el comercio</h1>
    @if (cargando)
    {
        <p class="vacio">Cargando comercios…</p>
    }
    else if (errorDeCarga is not null)
    {
        <p class="aviso error" role="alert">@errorDeCarga</p>
    }
    else
    {
        <div class="grid gap-2.5">
            @foreach (var comercio in comercios)
            {
                <button type="button" class="h-auto w-full justify-between px-4 py-3 text-left" disabled="@seleccionando"
                        @onclick="() => Seleccionar(comercio.Id)">
                    <span>
                        <b class="block">@comercio.Nombre</b>
                        <span class="nota">RUT @comercio.Rut · @(comercio.Perfil == "AdministradorComercio" ? "Administrador" : "Usuario")</span>
                    </span>
                    <i class="ph ph-arrow-right text-suave"></i>
                </button>
            }
        </div>
    }
</section>

@code {
    private List<ComercioDto> comercios = new();
    private bool cargando = true;
    private bool seleccionando;
    private string? errorDeCarga;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            comercios = await JS.InvokeAsync<List<ComercioDto>>("autenticacionPortal.misComercios") ?? new();
        }
        catch (JSException)
        {
            errorDeCarga = "No se pudieron cargar los comercios.";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task Seleccionar(Guid comercioId)
    {
        if (seleccionando)
            return;

        seleccionando = true;

        try
        {
            await JS.InvokeVoidAsync("autenticacionPortal.seleccionarComercio", comercioId);

            // Recargar para que Blazor tome la cookie con el comercio elegido.
            Navegacion.NavigateTo("/", forceLoad: true);
        }
        catch (JSException)
        {
            Notificaciones.Error("No se pudo seleccionar el comercio", "Probá de nuevo en unos segundos.");
            seleccionando = false;
        }
    }

    private sealed class ComercioDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Rut { get; set; } = "";
        public string Perfil { get; set; } = "";
    }
}
