@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject EnviosApiClient Api
@inject IJSRuntime JS
<PageTitle>Nuevo envío</PageTitle>

<h1>Nuevo envío</h1>

@if (errorDeCarga is not null)
{
    <p class="error">@errorDeCarga</p>
}
else if (cuentas is null)
{
    <p>Cargando…</p>
}
else
{
    <EditForm Model="modelo" OnValidSubmit="GuardarAsync" @ref="formulario">
        <DataAnnotationsValidator />
        
        <fieldset>
            <legend>Cuenta comercial</legend>
            <label for="cuenta">Comercio y operador</label>
            <InputSelect id="cuenta" @bind-Value="modelo.CuentaComercialId" @bind-Value:after="CambiarCuentaAsync">
                <option value="">Elegí una cuenta…</option>
                @foreach (var c in cuentas)
                {
                    <option value="@c.Id">@c.ComercioNombre → @c.OperadorNombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => modelo.CuentaComercialId" />

            <label for="referencia">Referencia del pedido</label>
            <InputText id="referencia" @bind-Value="modelo.ReferenciaExterna" />
            <ValidationMessage For="() => modelo.ReferenciaExterna" />

            <label for="modalidad">Modalidad</label>
            <InputSelect id="modalidad" @bind-Value="modelo.Modalidad">
                <option value="Estandar">Estándar</option>
                <option value="Urgente">Urgente</option>
            </InputSelect>
        </fieldset>

        <fieldset>
            <legend>Destinatario</legend>
            <label for="nombre">Nombre</label>
            <InputText id="nombre" @bind-Value="modelo.DestinatarioNombre" />
            <ValidationMessage For="() => modelo.DestinatarioNombre" />

            <label for="telefono">Teléfono (opcional)</label>
            <InputText id="telefono" @bind-Value="modelo.DestinatarioTelefono" />

            <div class="fila">
                <div>
                    <label for="calle">Calle</label>
                    <InputText id="calle" @bind-Value="modelo.Calle" />
                    <ValidationMessage For="() => modelo.Calle" />
                </div>
                <div>
                    <label for="numero">Número</label>
                    <InputText id="numero" @bind-Value="modelo.Numero" />
                </div>
            </div>
            <div class="fila">
                <div>
                    <label for="localidad">Localidad</label>
                    <InputText id="localidad" @bind-Value="modelo.Localidad" />
                    <ValidationMessage For="() => modelo.Localidad" />
                </div>
                <div>
                    <label for="departamento">Departamento</label>
                    <InputSelect id="departamento" @bind-Value="modelo.Departamento" disabled="@(departamentos is null)">
                        <option value="">@(departamentos is null ? "Elegí primero la cuenta" : "Elegí un departamento")</option>
                        @foreach (var d in departamentos ?? []) { <option value="@d">@d</option> }
                    </InputSelect>
                    @if (departamentos is { Count: 0 }) { <p class="nota">El operador de esta cuenta todavía no tiene zonas de cobertura, así que no puede recibir envíos.</p> }
                    <ValidationMessage For="() => modelo.Departamento" />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Bultos</legend>

            @for (var i = 0; i < modelo.Bultos.Count; i++)
            {
                var indice = i;
                var bulto = modelo.Bultos[indice];

                <div class="bulto">
                    <h3>Bulto @(indice + 1)</h3>

                    <div class="fila">
                        <div>
                            <label for="peso-@indice">Peso (kg)</label>
                            <InputNumber id="@($"peso-{indice}")" @bind-Value="bulto.PesoKg" />
                        </div>

                        <div>
                            <label for="alto-@indice">Alto (cm)</label>
                            <InputNumber id="@($"alto-{indice}")" @bind-Value="bulto.AltoCm" />
                        </div>

                        <div>
                            <label for="ancho-@indice">Ancho (cm)</label>
                            <InputNumber id="@($"ancho-{indice}")" @bind-Value="bulto.AnchoCm" />
                        </div>

                        <div>
                            <label for="profundidad-@indice">Profundidad (cm)</label>
                            <InputNumber id="@($"profundidad-{indice}")" @bind-Value="bulto.ProfundidadCm" />
                        </div>
                    </div>

                    @if (modelo.Bultos.Count > 1)
                    {
                        <button type="button"
                                class="peligro"
                                @onclick="() => EliminarBulto(indice)">
                            Eliminar bulto
                        </button>
                    }
                </div>
            }

            <button type="button" @onclick="AgregarBulto">
                Agregar bulto
            </button>

            <ValidationSummary />
        </fieldset>

        <div class="acciones">
            <button type="submit" class="primario" disabled="@guardando">@(guardando ? "Guardando…" : "Dar de alta")</button>
        </div>
    </EditForm>
    
    <hr />
    <section aria-labelledby="titulo-importacion">
        <h2 id="titulo-importacion">Importar envíos por CSV</h2>

        <p>
            Cargá varios envíos utilizando la cuenta comercial
            seleccionada arriba. Cada fila del archivo representa un bulto.
        </p>

        <p>
            Los bultos con la misma referencia externa
            se agrupan en un único envío.
        </p>

        <div>
            <label for="archivoCsv">Archivo CSV</label>
            <input id="archivoCsv"
                   type="file"
                   accept=".csv,text/csv"
                   disabled="@importando" />
        </div>

        <div class="acciones">
            <button type="button"
                    class="primario"
                    disabled="@importando"
                    @onclick="ImportarCsvAsync">
                @(importando ? "Importando..." : "Importar CSV")
            </button>
        </div>

        @if (mensajeImportacion is not null)
        {
            <p class="aviso @(importacionExitosa ? "ok" : "error")"
               role="status">
                @mensajeImportacion
            </p>
        }

        @if (resultadoImportacion is not null)
        {
            <h3>Resultado de la importación</h3>

            <p>
                Total: @resultadoImportacion.TotalEnvios |
                Creados: @resultadoImportacion.Creados |
                Ya existentes: @resultadoImportacion.YaExistentes |
                Con errores: @resultadoImportacion.ConErrores
            </p>

            <table>
                <thead>
                    <tr>
                        <th>Referencia</th>
                        <th>Fila inicial</th>
                        <th>Estado</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in resultadoImportacion.Resultados)
                    {
                        <tr>
                            <td>@item.ReferenciaExterna</td>
                            <td>@item.FilaInicial</td>
                            <td>@EstadoImportacionTexto(item.Estado)</td>
                            <td>@item.Mensaje</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>


    @if (mensaje is not null)
    {
        <p class="aviso @(exito ? "ok" : "error")" role="status" aria-live="polite">@mensaje</p>
    }
}

@code {
    private IReadOnlyList<CuentaComercialItem>? cuentas;
    private NuevoEnvioModel modelo = new();
    private string? errorDeCarga;
    private string? mensaje;
    private bool exito;
    private bool guardando;
    private IReadOnlyList<string>? departamentos;
    private EditForm? formulario;
    private bool importando;
    private bool importacionExitosa;
    private string? mensajeImportacion;
    private ResultadoImportacionPortal? resultadoImportacion;

    private async Task ImportarCsvAsync()
    {
        if (importando)
            return;

        mensajeImportacion = null;
        resultadoImportacion = null;
        importacionExitosa = false;

        if (!Guid.TryParse(modelo.CuentaComercialId, out var cuentaId))
        {
            mensajeImportacion = "Seleccioná una cuenta comercial válida.";
            return;
        }

        importando = true;

        try
        {
            var respuesta = await JS.InvokeAsync<RespuestaImportacionPortal>(
                "autenticacionPortal.importarEnviosCsv",
                cuentaId.ToString());

            importacionExitosa = respuesta.Exito;
            mensajeImportacion = respuesta.Mensaje;
            resultadoImportacion = respuesta.Resultado;

            if (resultadoImportacion is { ConErrores: > 0 })
            {
                mensajeImportacion =
                    "Importación procesada. Algunos envíos tuvieron errores.";
            }
        }
        catch (JSException)
        {
            mensajeImportacion =
                "No se pudo completar la importación. Revisá la conexión con la API.";
        }
        finally
        {
            importando = false;
        }
    }

    private static string EstadoImportacionTexto(int estado) =>
        estado switch
        {
            0 => "Creado",
            1 => "Ya existente",
            2 => "Error",
            _ => "Desconocido"
        };

    private sealed record RespuestaImportacionPortal(
        bool Exito,
        string Mensaje,
        ResultadoImportacionPortal? Resultado);

    private sealed record ResultadoImportacionPortal(
        int TotalEnvios,
        int Creados,
        int YaExistentes,
        int ConErrores,
        List<DetalleImportacionPortal> Resultados);

    private sealed record DetalleImportacionPortal(
        string ReferenciaExterna,
        int FilaInicial,
        int Estado,
        Guid? EnvioId,
        string? Mensaje);


   protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    try
    {
        cuentas = (await JS.InvokeAsync<List<CuentaComercialItem>>(
            "autenticacionPortal.obtenerCuentasComerciales"))
            .Where(c => c.Activa)
            .ToList();

        // La API ya devuelve únicamente las cuentas autorizadas.
        if (cuentas.Count == 1)
        {
            modelo.CuentaComercialId = cuentas[0].Id.ToString();
            await CambiarCuentaAsync();

        }
    }
    catch (JSException)
    {
        errorDeCarga = "No se pudieron cargar las cuentas comerciales.";
    }
    finally
    {
        StateHasChanged();
    }
}

   private async Task GuardarAsync()
{
    if (guardando)
        return;

    guardando = true;
    mensaje = null;

    try
    {
        var datos = new
        {
            cuentaComercialId = Guid.Parse(modelo.CuentaComercialId),
            referenciaExterna = modelo.ReferenciaExterna,
            modalidad = modelo.Modalidad,
            destinatarioNombre = modelo.DestinatarioNombre,
            destinatarioTelefono = modelo.DestinatarioTelefono,
            calle = modelo.Calle,
            numero = modelo.Numero,
            localidad = modelo.Localidad,
            departamento = modelo.Departamento,
            bultos = modelo.Bultos.Select(b => new
            {
                pesoKg = b.PesoKg,
                altoCm = b.AltoCm,
                anchoCm = b.AnchoCm,
                profundidadCm = b.ProfundidadCm
            }).ToArray()
        };

        var resultado = await JS.InvokeAsync<ResultadoAlta>(
            "autenticacionPortal.crearEnvio",
            datos);

        exito = resultado.Exito;
        mensaje = resultado.Mensaje;

        if (exito)
        {
            modelo = new NuevoEnvioModel
            {
                CuentaComercialId = modelo.CuentaComercialId,
                Departamento = modelo.Departamento
            };
        }
    }
    catch (JSException)
    {
        exito = false;
        mensaje = "No se pudo conectar con la API para crear el envío.";
    }
    finally
    {
        guardando = false;
    }
}
    
    private void AgregarBulto()
    {
        modelo.Bultos.Add(new NuevoBultoModel());
    }

    private void EliminarBulto(int indice)
    {
        if (modelo.Bultos.Count > 1)
            modelo.Bultos.RemoveAt(indice);
    }

    // El departamento sale de las zonas del operador de la cuenta: escrito a mano, un error de
    // tipeo terminaba en "no existe tarifa vigente".
   private async Task CambiarCuentaAsync()
{
    modelo.Departamento = string.Empty;
    departamentos = null;

    var cuenta = cuentas?.FirstOrDefault(
        c => c.Id.ToString() == modelo.CuentaComercialId);

    if (cuenta is null)
        return;

    try
    {
        var zonas = await JS.InvokeAsync<List<ZonaItem>>(
            "autenticacionPortal.obtenerZonas",
            cuenta.OperadorId);

        departamentos = zonas
            .Select(z => z.Departamento)
            .Distinct()
            .Order()
            .ToList();

        if (departamentos.Count == 1)
            modelo.Departamento = departamentos[0];

        formulario?.EditContext?.NotifyFieldChanged(
            FieldIdentifier.Create(() => modelo.Departamento));
    }
    catch (JSException)
    {
        errorDeCarga = "No se pudieron cargar las zonas del operador.";
    }
}
}
