@page "/"
@inject EnviosApiClient Api

<PageTitle>Nuevo envío</PageTitle>

<h1>Nuevo envío</h1>

@if (errorDeCarga is not null)
{
    <p class="error">@errorDeCarga</p>
}
else if (cuentas is null)
{
    <p>Cargando…</p>
}
else
{
    <EditForm Model="modelo" OnValidSubmit="GuardarAsync" @ref="formulario">
        <DataAnnotationsValidator />
        
        <fieldset>
            <legend>Cuenta comercial</legend>
            <label for="cuenta">Comercio y operador</label>
            <InputSelect id="cuenta" @bind-Value="modelo.CuentaComercialId" @bind-Value:after="CambiarCuentaAsync">
                <option value="">Elegí una cuenta…</option>
                @foreach (var c in cuentas)
                {
                    <option value="@c.Id">@c.ComercioNombre → @c.OperadorNombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => modelo.CuentaComercialId" />

            <label for="referencia">Referencia del pedido</label>
            <InputText id="referencia" @bind-Value="modelo.ReferenciaExterna" />
            <ValidationMessage For="() => modelo.ReferenciaExterna" />

            <label for="modalidad">Modalidad</label>
            <InputSelect id="modalidad" @bind-Value="modelo.Modalidad">
                <option value="Estandar">Estándar</option>
                <option value="Urgente">Urgente</option>
            </InputSelect>
        </fieldset>

        <fieldset>
            <legend>Destinatario</legend>
            <label for="nombre">Nombre</label>
            <InputText id="nombre" @bind-Value="modelo.DestinatarioNombre" />
            <ValidationMessage For="() => modelo.DestinatarioNombre" />

            <label for="telefono">Teléfono (opcional)</label>
            <InputText id="telefono" @bind-Value="modelo.DestinatarioTelefono" />

            <div class="fila">
                <div>
                    <label for="calle">Calle</label>
                    <InputText id="calle" @bind-Value="modelo.Calle" />
                    <ValidationMessage For="() => modelo.Calle" />
                </div>
                <div>
                    <label for="numero">Número</label>
                    <InputText id="numero" @bind-Value="modelo.Numero" />
                </div>
            </div>
            <div class="fila">
                <div>
                    <label for="localidad">Localidad</label>
                    <InputText id="localidad" @bind-Value="modelo.Localidad" />
                    <ValidationMessage For="() => modelo.Localidad" />
                </div>
                <div>
                    <label for="departamento">Departamento</label>
                    <InputSelect id="departamento" @bind-Value="modelo.Departamento" disabled="@(departamentos is null)">
                        <option value="">@(departamentos is null ? "Elegí primero la cuenta" : "Elegí un departamento")</option>
                        @foreach (var d in departamentos ?? []) { <option value="@d">@d</option> }
                    </InputSelect>
                    @if (departamentos is { Count: 0 }) { <p class="nota">El operador de esta cuenta todavía no tiene zonas de cobertura, así que no puede recibir envíos.</p> }
                    <ValidationMessage For="() => modelo.Departamento" />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Bultos</legend>

            @for (var i = 0; i < modelo.Bultos.Count; i++)
            {
                var indice = i;
                var bulto = modelo.Bultos[indice];

                <div class="bulto">
                    <h3>Bulto @(indice + 1)</h3>

                    <div class="fila">
                        <div>
                            <label for="peso-@indice">Peso (kg)</label>
                            <InputNumber id="@($"peso-{indice}")" @bind-Value="bulto.PesoKg" />
                        </div>

                        <div>
                            <label for="alto-@indice">Alto (cm)</label>
                            <InputNumber id="@($"alto-{indice}")" @bind-Value="bulto.AltoCm" />
                        </div>

                        <div>
                            <label for="ancho-@indice">Ancho (cm)</label>
                            <InputNumber id="@($"ancho-{indice}")" @bind-Value="bulto.AnchoCm" />
                        </div>

                        <div>
                            <label for="profundidad-@indice">Profundidad (cm)</label>
                            <InputNumber id="@($"profundidad-{indice}")" @bind-Value="bulto.ProfundidadCm" />
                        </div>
                    </div>

                    @if (modelo.Bultos.Count > 1)
                    {
                        <button type="button"
                                class="peligro"
                                @onclick="() => EliminarBulto(indice)">
                            Eliminar bulto
                        </button>
                    }
                </div>
            }

            <button type="button" @onclick="AgregarBulto">
                Agregar bulto
            </button>

            <ValidationSummary />
        </fieldset>

        <div class="acciones">
            <button type="submit" class="primario" disabled="@guardando">@(guardando ? "Guardando…" : "Dar de alta")</button>
        </div>
    </EditForm>

    @if (mensaje is not null)
    {
        <p class="aviso @(exito ? "ok" : "error")" role="status" aria-live="polite">@mensaje</p>
    }
}

@code {
    private IReadOnlyList<CuentaComercialItem>? cuentas;
    private NuevoEnvioModel modelo = new();
    private string? errorDeCarga;
    private string? mensaje;
    private bool exito;
    private bool guardando;
    private IReadOnlyList<string>? departamentos;
    private EditForm? formulario;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuentas = (await Api.ListarCuentasAsync()).Where(c => c.Activa).ToList();
        }
        catch (HttpRequestException)
        {
            errorDeCarga = "No se pudieron cargar las cuentas comerciales. Probá de nuevo en unos minutos.";
        }
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensaje = null;

        var resultado = await Api.CrearAsync(modelo);
        exito = resultado.Exito;
        mensaje = resultado.Mensaje;

        if (exito)
        {
            // Se conserva la cuenta elegida para cargar varios envíos seguidos.
            modelo = new NuevoEnvioModel { CuentaComercialId = modelo.CuentaComercialId, Departamento = modelo.Departamento };
        }

        guardando = false;
    }
    
    private void AgregarBulto()
    {
        modelo.Bultos.Add(new NuevoBultoModel());
    }

    private void EliminarBulto(int indice)
    {
        if (modelo.Bultos.Count > 1)
            modelo.Bultos.RemoveAt(indice);
    }

    // El departamento sale de las zonas del operador de la cuenta: escrito a mano, un error de
    // tipeo terminaba en "no existe tarifa vigente".
    private async Task CambiarCuentaAsync()
    {
        modelo.Departamento = string.Empty;
        departamentos = null;
        var cuenta = cuentas?.FirstOrDefault(c => c.Id.ToString() == modelo.CuentaComercialId);
        if (cuenta is null)
            return;
        try
        {
            var zonas = await Api.ListarZonasAsync(cuenta.OperadorId);
            departamentos = zonas.Select(z => z.Departamento).Distinct().Order().ToList();
            if (departamentos.Count == 1)
                modelo.Departamento = departamentos[0];
            // Revalida el departamento: asignado por código, el aviso "Elegí el departamento" quedaba colgado.
            formulario?.EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => modelo.Departamento));
        }
        catch (HttpRequestException)
        {
            errorDeCarga = "No se pudieron cargar las zonas del operador. Probá de nuevo en unos minutos.";
        }
    }
}
