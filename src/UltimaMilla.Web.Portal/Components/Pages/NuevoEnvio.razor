@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject IJSRuntime JS
@inject Notificaciones Notificaciones
<PageTitle>Nuevo envío</PageTitle>

@if (errorDeCarga is not null)
{
    <p class="aviso error" role="alert">@errorDeCarga</p>
}
else if (cuentas is null)
{
    <p class="text-suave">Cargando…</p>
}
else
{
    var cuenta = CuentaElegida;

    <EditForm EditContext="contexto" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />

        <div class="grid items-start gap-[24px] lg:grid-cols-[minmax(0,1fr)_320px]">
            <div class="grid gap-[24px]">
                <section class="tarjeta">
                    <h2 class="titulo-tarjeta"><span class="paso">1</span>Cuenta y pedido</h2>
                    <div class="grid gap-4">
                        <div class="campo">
                            <label for="cuenta">Cuenta comercial</label>
                            <InputSelect id="cuenta" @bind-Value="modelo.CuentaComercialId" @bind-Value:after="CambiarCuentaAsync">
                                <option value="">Elegí una cuenta…</option>
                                @foreach (var c in cuentas)
                                {
                                    <option value="@c.Id">@c.ComercioNombre → @c.OperadorNombre</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => modelo.CuentaComercialId" />
                        </div>
                        <div class="grid gap-4 sm:grid-cols-[2fr_1fr]">
                            <div class="campo">
                                <label for="referencia">Referencia del pedido</label>
                                <InputText id="referencia" @bind-Value="modelo.ReferenciaExterna" maxlength="64" />
                                <ValidationMessage For="() => modelo.ReferenciaExterna" />
                            </div>
                            <div class="campo">
                                <span class="etiqueta" id="modalidad">Modalidad</span>
                                <InputRadioGroup @bind-Value="modelo.Modalidad">
                                    <div class="segmento" role="radiogroup" aria-labelledby="modalidad">
                                        <label><InputRadio Value="@("Estandar")" />Estándar</label>
                                        <label><InputRadio Value="@("Urgente")" />Urgente</label>
                                    </div>
                                </InputRadioGroup>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="tarjeta">
                    <h2 class="titulo-tarjeta"><span class="paso">2</span>Destinatario y dirección</h2>
                    <div class="grid gap-4">
                        <div class="campo">
                            <label for="nombre">Nombre</label>
                            <InputText id="nombre" @bind-Value="modelo.DestinatarioNombre" maxlength="200" autocomplete="off" />
                            <ValidationMessage For="() => modelo.DestinatarioNombre" />
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="campo">
                                <label for="telefono">Teléfono <span class="opcional">(opcional)</span></label>
                                <InputText id="telefono" type="tel" @bind-Value="modelo.DestinatarioTelefono" maxlength="30" autocomplete="off" />
                                <ValidationMessage For="() => modelo.DestinatarioTelefono" />
                            </div>
                            <div class="campo">
                                <label for="correo">Correo <span class="opcional">(opcional, recibe el seguimiento)</span></label>
                                <InputText id="correo" type="email" @bind-Value="modelo.DestinatarioEmail" maxlength="200" autocomplete="off" />
                                <ValidationMessage For="() => modelo.DestinatarioEmail" />
                            </div>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-[2fr_1fr]">
                            <div class="campo">
                                <label for="calle">Calle</label>
                                <InputText id="calle" @bind-Value="modelo.Calle" maxlength="200" />
                                <ValidationMessage For="() => modelo.Calle" />
                            </div>
                            <div class="campo">
                                <label for="numero">Número <span class="opcional">(opcional)</span></label>
                                <InputText id="numero" @bind-Value="modelo.Numero" maxlength="20" />
                                <ValidationMessage For="() => modelo.Numero" />
                            </div>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="campo">
                                <label for="localidad">Localidad</label>
                                <InputText id="localidad" @bind-Value="modelo.Localidad" maxlength="100" />
                                <ValidationMessage For="() => modelo.Localidad" />
                            </div>
                            <div class="campo">
                                <label for="departamento">Departamento</label>
                                <InputSelect id="departamento" @bind-Value="modelo.Departamento" disabled="@(departamentos is null)">
                                    <option value="">@(departamentos is null ? "Elegí primero la cuenta" : "Elegí un departamento")</option>
                                    @foreach (var d in departamentos ?? []) { <option value="@d">@d</option> }
                                </InputSelect>
                                @if (departamentos is { Count: 0 }) { <p class="nota">El operador de esta cuenta todavía no tiene zonas de cobertura, así que no puede recibir envíos.</p> }
                                <ValidationMessage For="() => modelo.Departamento" />
                            </div>
                        </div>
                    </div>
                </section>

                <section class="tarjeta">
                    <h2 class="titulo-tarjeta"><span class="paso">3</span>Bultos</h2>
                    <div class="fila-bulto pb-1.5" aria-hidden="true">
                        <span></span><span class="etiqueta">Peso</span><span class="etiqueta">Alto</span><span class="etiqueta">Ancho</span><span class="etiqueta">Profundidad</span><span></span>
                    </div>
                    @for (var i = 0; i < modelo.Bultos.Count; i++)
                    {
                        var indice = i;
                        var bulto = modelo.Bultos[indice];
                        <div class="fila-bulto border-b border-borde py-3" @key="bulto">
                            <span class="numero-bulto">@(indice + 1)</span>
                            <div class="campo">
                                <div class="sufijo"><InputNumber @bind-Value="bulto.PesoKg" min="0.001" max="1000" aria-label="@($"Peso del bulto {indice + 1}, en kg")" ParsingErrorMessage="Ingresá un número." /><span>kg</span></div>
                                <ValidationMessage For="() => bulto.PesoKg" />
                            </div>
                            <div class="campo">
                                <div class="sufijo"><InputNumber @bind-Value="bulto.AltoCm" min="1" max="500" aria-label="@($"Alto del bulto {indice + 1}, en cm")" ParsingErrorMessage="Ingresá un número entero." /><span>cm</span></div>
                                <ValidationMessage For="() => bulto.AltoCm" />
                            </div>
                            <div class="campo">
                                <div class="sufijo"><InputNumber @bind-Value="bulto.AnchoCm" min="1" max="500" aria-label="@($"Ancho del bulto {indice + 1}, en cm")" ParsingErrorMessage="Ingresá un número entero." /><span>cm</span></div>
                                <ValidationMessage For="() => bulto.AnchoCm" />
                            </div>
                            <div class="campo">
                                <div class="sufijo"><InputNumber @bind-Value="bulto.ProfundidadCm" min="1" max="500" aria-label="@($"Profundidad del bulto {indice + 1}, en cm")" ParsingErrorMessage="Ingresá un número entero." /><span>cm</span></div>
                                <ValidationMessage For="() => bulto.ProfundidadCm" />
                            </div>
                            <button type="button" class="quitar" title="Quitar bulto @(indice + 1)"
                                    disabled="@(modelo.Bultos.Count == 1)" @onclick="() => EliminarBulto(indice)">
                                <i class="ph ph-trash"></i>
                            </button>
                        </div>
                    }
                    <button type="button" class="mt-4 w-full border-dashed text-suave" @onclick="AgregarBulto">
                        <i class="ph ph-plus"></i>Agregar bulto
                    </button>
                </section>

                @if (resultadoImportacion is not null)
                {
                    <section class="tarjeta">
                        <h2 class="titulo-tarjeta">Resultado de la importación</h2>
                        <p class="nota mb-4">
                            @resultadoImportacion.TotalEnvios envíos · @resultadoImportacion.Creados creados ·
                            @resultadoImportacion.YaExistentes ya existían · @resultadoImportacion.ConErrores con errores
                        </p>
                        <div class="tabla">
                            <table>
                                <thead><tr><th>Referencia</th><th>Fila inicial</th><th>Estado</th><th>Detalle</th></tr></thead>
                                <tbody>
                                    @foreach (var item in resultadoImportacion.Resultados)
                                    {
                                        <tr>
                                            <td>@item.ReferenciaExterna</td>
                                            <td class="num">@item.FilaInicial</td>
                                            <td>@EstadoImportacionTexto(item.Estado)</td>
                                            <td>@item.Mensaje</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>

            <aside class="tarjeta lg:sticky lg:top-[24px]">
                <h2 class="titulo-tarjeta">Resumen</h2>
                <dl class="resumen">
                    <dt>Operador</dt><dd>@(cuenta?.OperadorNombre ?? "—")</dd>
                    <dt>Modalidad</dt><dd>@(modelo.Modalidad == "Urgente" ? "Urgente" : "Estándar")</dd>
                    <dt>Destino</dt><dd>@(string.IsNullOrEmpty(modelo.Departamento) ? "—" : modelo.Departamento)</dd>
                    <dt>Bultos</dt><dd>@modelo.Bultos.Count</dd>
                </dl>
                <p class="nota">Peso total</p>
                <p class="cifra">@modelo.Bultos.Sum(b => b.PesoKg).ToString("0.###") kg</p>

                <ul class="secciones">
                    @foreach (var s in Secciones())
                    {
                        <li class="@s.Estado">
                            <i class="@(s.Estado switch { "ok" => "ph ph-check-circle", "mal" => "ph ph-x-circle", _ => "ph ph-circle" })"></i>
                            <div>
                                @s.Nombre
                                @foreach (var m in s.Errores) { <span class="error-seccion">@m</span> }
                            </div>
                        </li>
                    }
                </ul>

                <button type="submit" class="primario h-[44px] w-full" disabled="@guardando">
                    <i class="ph ph-paper-plane-tilt"></i>@(guardando ? "Guardando…" : "Dar de alta")
                </button>
                <label class="btn-secundario mt-2.5 h-[44px] w-full justify-center @(importando ? "pointer-events-none opacity-60" : null)"
                       title="Cada fila es un bulto; las filas con la misma referencia forman un envío. Usa la cuenta elegida arriba.">
                    <i class="ph ph-file-csv"></i>@(importando ? "Importando…" : "Importar CSV")
                    <input id="archivoCsv" type="file" accept=".csv,text/csv" class="sr-only" disabled="@importando" @onchange="ImportarCsvAsync" />
                </label>
            </aside>
        </div>
    </EditForm>
}

@code {
    private IReadOnlyList<CuentaComercialItem>? cuentas;
    private NuevoEnvioModel modelo = null!;
    private EditContext contexto = null!;
    private string? errorDeCarga;
    private bool guardando;
    private IReadOnlyList<string>? departamentos;
    private bool importando;
    private ResultadoImportacionPortal? resultadoImportacion;
    [SupplyParameterFromQuery(Name = "cuentaComercialId")]
    public Guid? CuentaComercialIdSeleccionada { get; set; }

    private static readonly string[] CamposBulto =
    [
        nameof(NuevoBultoModel.PesoKg), nameof(NuevoBultoModel.AltoCm),
        nameof(NuevoBultoModel.AnchoCm), nameof(NuevoBultoModel.ProfundidadCm)
    ];

    private CuentaComercialItem? CuentaElegida =>
        cuentas?.FirstOrDefault(c => c.Id.ToString() == modelo.CuentaComercialId);

    protected override void OnInitialized() => NuevoContexto(new NuevoEnvioModel());

    private void NuevoContexto(NuevoEnvioModel nuevo)
    {
        modelo = nuevo;
        contexto = ValidacionFormulario.Crear(modelo, () => modelo.Bultos, StateHasChanged);
    }

    private IEnumerable<SeccionResumen> Secciones()
    {
        yield return ValidacionFormulario.Seccion(contexto, "Cuenta y pedido",
            [nameof(NuevoEnvioModel.CuentaComercialId), nameof(NuevoEnvioModel.ReferenciaExterna)],
            modelo.CuentaComercialId, modelo.ReferenciaExterna);
        yield return ValidacionFormulario.Seccion(contexto, "Destinatario",
            [nameof(NuevoEnvioModel.DestinatarioNombre), nameof(NuevoEnvioModel.DestinatarioTelefono), nameof(NuevoEnvioModel.DestinatarioEmail)],
            modelo.DestinatarioNombre);
        yield return ValidacionFormulario.Seccion(contexto, "Dirección de entrega",
            [nameof(NuevoEnvioModel.Calle), nameof(NuevoEnvioModel.Numero), nameof(NuevoEnvioModel.Localidad), nameof(NuevoEnvioModel.Departamento)],
            modelo.Calle, modelo.Localidad, modelo.Departamento);
        yield return ValidacionFormulario.SeccionBultos(contexto, modelo.Bultos, CamposBulto);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            cuentas = (await JS.InvokeAsync<List<CuentaComercialItem>>("autenticacionPortal.obtenerCuentasComerciales"))
                .Where(c => c.Activa)
                .ToList();

            // Si viene una cuenta desde Mis operadores, la seleccionamos.
            if (CuentaComercialIdSeleccionada.HasValue)
            {
                var cuenta = cuentas.FirstOrDefault(c => c.Id == CuentaComercialIdSeleccionada.Value);

                if (cuenta is not null)
                {
                    modelo.CuentaComercialId = cuenta.Id.ToString();
                    await CambiarCuentaAsync();
                }
                else
                {
                    errorDeCarga = "La cuenta comercial seleccionada no está disponible.";
                }
            }
            // Si solamente tiene una cuenta activa, la seleccionamos automáticamente.
            else if (cuentas.Count == 1)
            {
                modelo.CuentaComercialId = cuentas[0].Id.ToString();
                await CambiarCuentaAsync();
            }
        }
        catch (JSException)
        {
            errorDeCarga = "No se pudieron cargar las cuentas comerciales.";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task GuardarAsync()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            var datos = new
            {
                cuentaComercialId = Guid.Parse(modelo.CuentaComercialId),
                referenciaExterna = modelo.ReferenciaExterna,
                modalidad = modelo.Modalidad,
                destinatarioNombre = modelo.DestinatarioNombre,
                destinatarioTelefono = modelo.DestinatarioTelefono,
                destinatarioEmail = modelo.DestinatarioEmail,
                calle = modelo.Calle,
                numero = modelo.Numero,
                localidad = modelo.Localidad,
                departamento = modelo.Departamento,
                bultos = modelo.Bultos.Select(b => new
                {
                    pesoKg = b.PesoKg,
                    altoCm = b.AltoCm,
                    anchoCm = b.AnchoCm,
                    profundidadCm = b.ProfundidadCm
                }).ToArray()
            };

            var resultado = await JS.InvokeAsync<ResultadoAlta>("autenticacionPortal.crearEnvio", datos);

            if (resultado.Exito)
            {
                Notificaciones.Exito("Envío creado", $"{modelo.ReferenciaExterna} para {modelo.DestinatarioNombre}.");
                NuevoContexto(new NuevoEnvioModel
                {
                    CuentaComercialId = modelo.CuentaComercialId,
                    Departamento = modelo.Departamento
                });
            }
            else
            {
                Notificaciones.Error("No se pudo crear el envío", resultado.Mensaje);
            }
        }
        catch (JSException)
        {
            Notificaciones.Error("No se pudo crear el envío", "No hay conexión con la API.");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task ImportarCsvAsync()
    {
        if (importando)
            return;

        resultadoImportacion = null;

        if (!Guid.TryParse(modelo.CuentaComercialId, out var cuentaId))
        {
            Notificaciones.Error("No se pudo importar", "Elegí primero la cuenta comercial.");
            return;
        }

        importando = true;

        try
        {
            var respuesta = await JS.InvokeAsync<RespuestaImportacionPortal>(
                "autenticacionPortal.importarEnviosCsv", cuentaId.ToString());

            resultadoImportacion = respuesta.Resultado;

            if (!respuesta.Exito)
                Notificaciones.Error("No se pudo importar", respuesta.Mensaje);
            else if (resultadoImportacion is { ConErrores: > 0 })
                Notificaciones.Error("Importación con errores",
                    $"{resultadoImportacion.ConErrores} de {resultadoImportacion.TotalEnvios} envíos no se crearon. Mirá el detalle.");
            else
                Notificaciones.Exito("Importación lista",
                    $"{resultadoImportacion?.Creados ?? 0} creados, {resultadoImportacion?.YaExistentes ?? 0} ya existían.");
        }
        catch (JSException)
        {
            Notificaciones.Error("No se pudo importar", "No hay conexión con la API.");
        }
        finally
        {
            importando = false;
        }
    }

    private void AgregarBulto() => modelo.Bultos.Add(new NuevoBultoModel());

    private void EliminarBulto(int indice)
    {
        if (modelo.Bultos.Count > 1)
            modelo.Bultos.RemoveAt(indice);
    }

    // El departamento sale de las zonas del operador de la cuenta: escrito a mano, un error de
    // tipeo terminaba en "no existe tarifa vigente".
    private async Task CambiarCuentaAsync()
    {
        modelo.Departamento = string.Empty;
        departamentos = null;

        var cuenta = CuentaElegida;

        if (cuenta is null)
            return;

        try
        {
            var zonas = await JS.InvokeAsync<List<ZonaItem>>("autenticacionPortal.obtenerZonas", cuenta.OperadorId);

            departamentos = zonas.Select(z => z.Departamento).Distinct().Order().ToList();

            if (departamentos.Count == 1)
                modelo.Departamento = departamentos[0];

            contexto.NotifyFieldChanged(FieldIdentifier.Create(() => modelo.Departamento));
        }
        catch (JSException)
        {
            errorDeCarga = "No se pudieron cargar las zonas del operador.";
        }
    }

    private static string EstadoImportacionTexto(int estado) =>
        estado switch
        {
            0 => "Creado",
            1 => "Ya existente",
            2 => "Error",
            _ => "Desconocido"
        };

    private sealed record RespuestaImportacionPortal(bool Exito, string Mensaje, ResultadoImportacionPortal? Resultado);

    private sealed record ResultadoImportacionPortal(
        int TotalEnvios,
        int Creados,
        int YaExistentes,
        int ConErrores,
        List<DetalleImportacionPortal> Resultados);

    private sealed record DetalleImportacionPortal(
        string ReferenciaExterna,
        int FilaInicial,
        int Estado,
        Guid? EnvioId,
        string? Mensaje);
}
