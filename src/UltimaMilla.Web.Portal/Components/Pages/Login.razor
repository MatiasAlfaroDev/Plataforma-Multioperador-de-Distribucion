@page "/login"
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión - Última Milla</PageTitle>

<div class="encabezado">
    <div>
        <h1>Portal del comercio</h1>
        <p>Ingresá tus credenciales para acceder a la plataforma.</p>
    </div>
</div>

<div class="tarjeta max-w-md">
    <form @onsubmit="IniciarSesion" @onsubmit:preventDefault>
        <div>
            <div>
                <label for="email">Correo electrónico</label>
                <input id="email"
                       type="email"
                       autocomplete="username"
                       @bind="email"
                       required />
            </div>

            <div>
                <label for="password">Contraseña</label>
                <input id="password"
                       type="password"
                       autocomplete="current-password"
                       @bind="password"
                       required />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="aviso error">
                <i class="ph ph-x-circle"></i>
                <span>@error</span>
            </div>
        }

        <div class="acciones">
            <button type="submit" class="primario" disabled="@procesando">
                @(procesando ? "Ingresando..." : "Ingresar")
            </button>
        </div>
    </form>
</div>

<div class="nota">
    <p>¿Todavía no tenés una cuenta? <a href="/registro">Registrate acá</a></p>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool procesando;

    private async Task IniciarSesion()
    {
        if (procesando)
            return;

        procesando = true;
        error = null;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.login",
                email,
                password);

            // Recarga completa para que Blazor reconozca la cookie.
            Navegacion.NavigateTo("/", forceLoad: true);
        }
        catch (JSException ex)
        {
            error = ex.Message; 
        }
        finally
        {
            password = "";
            procesando = false;
        }
    }
}
