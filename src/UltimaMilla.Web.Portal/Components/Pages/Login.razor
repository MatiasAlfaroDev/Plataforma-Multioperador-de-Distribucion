@page "/login"
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navegacion
@inject Notificaciones Notificaciones

<PageTitle>Iniciar sesión - Última Milla</PageTitle>

<section class="tarjeta max-w-[400px]">
    <h1 class="titulo-tarjeta">Portal del comercio</h1>
    <form class="grid gap-4" @onsubmit="IniciarSesion" @onsubmit:preventDefault>
        <div class="campo">
            <label for="email">Correo electrónico</label>
            <input id="email" type="email" autocomplete="username" @bind="email" required />
        </div>
        <div class="campo">
            <label for="password">Contraseña</label>
            <input id="password" type="password" autocomplete="current-password" @bind="password" required />
        </div>
        <button type="submit" class="primario mt-2 h-[44px] w-full" disabled="@procesando">
            @(procesando ? "Ingresando…" : "Ingresar")
        </button>
    </form>
</section>

<p class="nota max-w-[400px] text-center">¿Todavía no tenés una cuenta? <a href="/registro">Registrate acá</a></p>

@code {
    private string email = "";
    private string password = "";
    private bool procesando;

    private async Task IniciarSesion()
    {
        if (procesando)
            return;

        procesando = true;

        try
        {
            var resultado = await JS.InvokeAsync<ResultadoLogin>(
                "autenticacionPortal.login",
                email,
                password);

            // Recarga completa para que Blazor reconozca la cookie. Si el usuario trabaja para
            // más de un comercio, primero elige con cuál operar.
            Navegacion.NavigateTo(resultado.RequiereSeleccion ? "/seleccionar-comercio" : "/", forceLoad: true);
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo iniciar sesión", ex.Message);
        }
        finally
        {
            password = "";
            procesando = false;
        }
    }

    private sealed class ResultadoLogin
    {
        public bool RequiereSeleccion { get; set; }
    }
}
