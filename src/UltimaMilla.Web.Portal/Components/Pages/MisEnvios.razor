
@page "/mis-envios"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "ComercioPortal")]
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject Notificaciones Notificaciones

<PageTitle>Mis envíos - Última Milla</PageTitle>

@if (cargando)
{
    <p class="vacio">Cargando envíos…</p>
}
else if (!string.IsNullOrWhiteSpace(error) && envios.Count == 0)
{
    <p class="aviso error" role="alert">@error</p>
}
else
{
    <section class="tarjeta">
        <div class="cabecera-tarjeta">
            <h2 class="titulo-tarjeta">Envíos <span class="chip">@envios.Count</span></h2>
            <a href="/" class="btn-primario btn-chico"><i class="ph ph-plus-circle"></i>Nuevo envío</a>
        </div>

        @if (envios.Count == 0)
        {
            <p class="vacio">Todavía no tenés envíos registrados.</p>
        }
        else
        {
            <div class="tabla tabla-holgada">
                <table>
                    <thead>
                        <tr>
                            <th>Envío</th>
                            <th>Destinatario</th>
                            <th>Carga</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var envio in envios)
                        {
                            <tr @key="envio.Id">
                                <td>
                                    <b class="codigo">@envio.ReferenciaExterna</b>
                                    <span class="linea2">@envio.OperadorNombre · @envio.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    @envio.DestinatarioNombre
                                    <span class="linea2">@envio.Direccion</span>
                                </td>
                                <td>
                                    @(envio.CantidadBultos == 1 ? "1 bulto" : $"{envio.CantidadBultos} bultos") · @envio.PesoTotalKg.ToString("0.###") kg
                                    <span class="linea2">@FormatearModalidad(envio.Modalidad)</span>
                                </td>
                                <td><span class="@ClaseEstado(envio.Estado)">@FormatearEstado(envio.Estado)</span></td>
                                <td>
                                    <div class="flex items-center justify-end gap-2">
                                        <button type="button" class="btn-chico"
                                                aria-expanded="@(envioSeleccionado == envio.Id ? "true" : "false")"
                                                @onclick="() => AlternarDetalleAsync(envio.Id)">
                                            <i class="ph @(envioSeleccionado == envio.Id ? "ph-caret-up" : "ph-caret-down")"></i>Detalle
                                        </button>
                                        <button type="button" class="btn-chico" @onclick="() => ImprimirEtiquetaAsync(envio)">
                                            <i class="ph ph-printer"></i>Etiqueta
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @if (envioSeleccionado == envio.Id)
                            {
                                <tr class="hover:bg-transparent">
                                    <td colspan="5" class="bg-hundido">
                                        @if (cargandoDetalle)
                                        {
                                            <p class="vacio">Cargando detalle…</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(errorDetalle))
                                        {
                                            <p class="aviso error" role="alert">@errorDetalle</p>
                                        }
                                        else if (detalle is not null)
                                        {
                                            <p class="mb-2 text-[13px] font-semibold">Bultos</p>
                                            <ul class="flex flex-wrap gap-2">
                                                @foreach (var bulto in detalle.Bultos)
                                                {
                                                    <li class="chip"><span class="codigo">@bulto.Identificacion</span> · @FormatearEstado(bulto.Estado)</li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private List<EnvioDto> envios = new();
    private DetalleEnvioDto? detalle;

    private Guid? envioSeleccionado;

    private bool cargando = true;
    private bool cargandoDetalle;

    private string? error;
    private string? errorDetalle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            envios = await JS.InvokeAsync<List<EnvioDto>>(
                "autenticacionPortal.listarEnvios") ?? new();
        }
        catch (JSException ex)
        {
            error = Notificaciones.Limpiar(ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task VerDetalleAsync(Guid envioId)
    {
        envioSeleccionado = envioId;
        detalle = null;
        errorDetalle = null;
        cargandoDetalle = true;

        try
        {
            detalle = await JS.InvokeAsync<DetalleEnvioDto>(
                "autenticacionPortal.obtenerDetalleEnvio",
                envioId);
        }
        catch (JSException ex)
        {
            errorDetalle = Notificaciones.Limpiar(ex.Message);
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private Task AlternarDetalleAsync(Guid envioId)
    {
        if (envioSeleccionado != envioId)
            return VerDetalleAsync(envioId);

        CerrarDetalle();
        return Task.CompletedTask;
    }

    private void CerrarDetalle()
    {
        envioSeleccionado = null;
        detalle = null;
        errorDetalle = null;
    }

    private async Task ImprimirEtiquetaAsync(EnvioDto envio)
    {
        try
        {
            var detalleEnvio = await JS.InvokeAsync<DetalleEnvioDto>(
                "autenticacionPortal.obtenerDetalleEnvio",
                envio.Id);

            if (detalleEnvio.Bultos.Count == 0)
            {
                Notificaciones.Error("No se pudo imprimir la etiqueta", "El envío no tiene bultos.");
                return;
            }

            var datos = new
            {
                operador = envio.OperadorNombre,
                referencia = detalleEnvio.ReferenciaExterna,
                destinatario = detalleEnvio.Destinatario,
                direccion = detalleEnvio.Direccion,
                modalidad = FormatearModalidad(detalleEnvio.Modalidad),
                bultos = detalleEnvio.Bultos.Select(b => new
                {
                    identificacion = b.Identificacion
                }).ToArray()
            };

            await JS.InvokeVoidAsync(
                "etiquetasPortal.imprimir",
                datos);
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo imprimir la etiqueta", ex.Message);
        }
    }

    private static string FormatearEstado(string estado) => estado switch
    {
        "AsignadoARuta" => "Asignado a ruta",
        "EnTransito" => "En tránsito",
        "Entregado" => "Entregado",
        "NoEntregado" => "No entregado",
        "Reprogramado" => "Reprogramado",
        "EnDevolucion" => "En devolución",
        "Devuelto" => "Devuelto",
        "Pendiente" => "Pendiente",
        "Admitido" => "Admitido",
        "EnDeposito" => "En depósito",
        "EntregadoParcialmente" => "Entregado parcialmente",
        "Extraviado" => "Extraviado",
        _ => estado
    };

    private static string FormatearModalidad(string modalidad) => modalidad switch
    {
        "Estandar" => "Estándar",
        "Urgente" => "Urgente",
        _ => modalidad
    };

    private static string ClaseEstado(string estado) => estado switch
    {
        "Entregado" or "Devuelto" => "chip chip-exito",
        "EnTransito" or "AsignadoARuta" => "chip chip-acento",
        "Reprogramado" or "NoEntregado" => "chip chip-alerta",
        "EnDevolucion" or "Extraviado" => "chip chip-peligro",
        _ => "chip"
    };

    private sealed class EnvioDto
    {
        public Guid Id { get; set; }
        public string ReferenciaExterna { get; set; } = "";
        public string OperadorNombre { get; set; } = "";
        public string DestinatarioNombre { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string Estado { get; set; } = "";
        public int CantidadBultos { get; set; }
        public DateTimeOffset FechaAlta { get; set; }
        public decimal PesoTotalKg { get; set; }
        public string Modalidad { get; set; } = "";
    }

    private sealed class DetalleEnvioDto
    {
        public string ReferenciaExterna { get; set; } = "";
        public string Estado { get; set; } = "";
        public List<BultoDto> Bultos { get; set; } = new();
        public string Destinatario { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string Modalidad { get; set; } = "";
    }

    private sealed class BultoDto
    {
        public string Identificacion { get; set; } = "";
        public string Estado { get; set; } = "";
    }
}
