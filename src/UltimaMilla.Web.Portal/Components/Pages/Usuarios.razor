@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "AdministradorComercio")]
@inject IJSRuntime JS
@inject Notificaciones Notificaciones

<PageTitle>Usuarios - Última Milla</PageTitle>

<div class="pagina">
    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Usuarios del comercio</h2>
        @if (usuarios.Count == 0)
        {
            <p class="vacio">Cargando usuarios…</p>
        }
        else
        {
            <div class="tabla">
                <table>
                    <thead><tr><th>Nombre</th><th>Email</th><th>Perfil</th></tr></thead>
                    <tbody>
                        @foreach (var u in usuarios)
                        {
                            <tr>
                                <td>@u.Nombre</td>
                                <td>@u.Email</td>
                                <td><span class="chip @(u.Perfil == "AdministradorComercio" ? "chip-acento" : null)">@(u.Perfil == "AdministradorComercio" ? "Administrador" : "Usuario")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Dar de alta</h2>
        <form @onsubmit="Alta" @onsubmit:preventDefault>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="campo">
                    <label for="nombre">Nombre completo</label>
                    <input id="nombre" @bind="nombre" autocomplete="off" required />
                </div>
                <div class="campo">
                    <label for="email">Correo electrónico</label>
                    <input id="email" type="email" @bind="email" autocomplete="off" required />
                </div>
                <div class="campo">
                    <label for="password">Contraseña inicial <span class="opcional">(vacía si ya tiene cuenta)</span></label>
                    <input id="password" type="password" autocomplete="new-password" @bind="password" />
                </div>
                <div class="campo">
                    <label for="perfil">Perfil</label>
                    <select id="perfil" @bind="perfil">
                        <option value="Comercio">Usuario</option>
                        <option value="AdministradorComercio">Administrador</option>
                    </select>
                </div>
            </div>
            <div class="acciones">
                <button type="submit" class="primario h-[44px]" disabled="@procesando"><i class="ph ph-user-plus"></i>@(procesando ? "Dando de alta…" : "Dar de alta")</button>
            </div>
        </form>
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Integración por API</h2>
        <p class="nota mb-4">
            Tu sistema puede solicitar envíos y retiros llamando a <code>POST /api/envios</code> y <code>POST /api/retiros</code>
            con el encabezado <code>X-Api-Key</code>. La clave actúa con tu usuario y se muestra una sola vez;
            generar otra invalida la anterior.
        </p>
        <div class="grid gap-3">
            @if (claveApi is not null)
            {
                <p class="rounded-xl border border-borde bg-hundido px-4 py-3"><span class="etiqueta mb-1">Clave de API</span><code class="break-all">@claveApi</code></p>
            }
            @if (clavePruebas is not null)
            {
                <p class="rounded-xl border border-borde bg-hundido px-4 py-3"><span class="etiqueta mb-1">Clave de pruebas</span><code class="break-all">@clavePruebas</code></p>
            }
        </div>
        <div class="acciones">
            <button type="button" @onclick="GenerarClaveAsync"><i class="ph ph-key"></i>Generar clave de API</button>
            <button type="button" @onclick="ObtenerClavePruebasAsync"><i class="ph ph-flask"></i>Ver clave de pruebas</button>
        </div>
    </section>
</div>

@code {
    private string? claveApi;

    private async Task GenerarClaveAsync()
    {
        try
        {
            claveApi = await JS.InvokeAsync<string>("retirosPortal.generarClaveApi");
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo generar la clave", ex.Message);
        }
    }
    private string? clavePruebas;

    private async Task ObtenerClavePruebasAsync()
    {
        try
        {
            clavePruebas = await JS.InvokeAsync<string>("retirosPortal.obtenerClavePruebas");
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo obtener la clave de pruebas", ex.Message);
        }
    }

    private List<UsuarioDto> usuarios = new();
    private string nombre = "", email = "", password = "", perfil = "Comercio";
    private bool procesando;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            usuarios = await JS.InvokeAsync<List<UsuarioDto>>("autenticacionPortal.listarUsuariosComercio") ?? new();
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudieron cargar los usuarios", ex.Message);
        }
        StateHasChanged();
    }

    private async Task Alta()
    {
        procesando = true;
        try
        {
            await JS.InvokeVoidAsync("autenticacionPortal.altaUsuarioComercio", new
            {
                nombreCompleto = nombre,
                email,
                password = string.IsNullOrWhiteSpace(password) ? null : password,
                perfil
            });
            Notificaciones.Exito("Usuario dado de alta", email);
            nombre = email = password = "";
            await CargarAsync();
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo dar de alta", ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private sealed class UsuarioDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Perfil { get; set; } = "";
    }
}
