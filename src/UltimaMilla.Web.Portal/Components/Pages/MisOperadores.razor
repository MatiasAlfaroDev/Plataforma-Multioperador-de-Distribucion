@page "/mis-operadores"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "ComercioPortal")]
@inject IJSRuntime JS

<PageTitle>Mis operadores - Última Milla</PageTitle>

<div class="encabezado">
    <div>
        <h1>Mis operadores</h1>
        <p>Consultá los operadores logísticos disponibles y gestioná tus vinculaciones.</p>
    </div>
</div>

@if (cargando)
{
    <p>Cargando operadores...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="aviso error" role="alert">@error</p>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <p class="aviso ok" role="status">@mensaje</p>
    }

    @if (operadores.Count == 0 && error is null)
    {
        <p>No hay operadores disponibles.</p>
    }

    @foreach (var operador in operadores)
    {
        var cuenta = cuentas.FirstOrDefault(
            c => c.OperadorId == operador.Id);

        <div class="tarjeta">
            <h3>@operador.Nombre</h3>

            @if (cuenta is null)
            {
                <p>Estado: Sin vinculación</p>

                <button type="button"
                        disabled="@enviando"
                        @onclick="() => SolicitarAsync(operador.Id)">
                    Solicitar vinculación
                </button>
            }
           else if (cuenta.Estado == EstadoVinculacion.Confirmada
                    && cuenta.Activa)
            {
                <p class="ok flex items-center gap-1.5"><i class="ph ph-check-circle"></i>Vinculado</p>

                <p>Ya podés crear envíos con este operador.</p>

                <a class="btn-primario"
                href="@($"/?cuentaComercialId={cuenta.Id}")">
                    Crear envío
                </a>
                            <div class="mt-4">
                <h4>Dirección de recepción</h4>

                @if (cuenta.DireccionCargada)
                {
                    <p>
                        @cuenta.Calle @cuenta.Numero,
                        @cuenta.Localidad, @cuenta.Departamento
                    </p>
                }
                else
                {
                    <p>Esta cuenta todavía no tiene dirección configurada.</p>
                }

                @if (cuenta.EditandoDireccion)
                {
                    <div class="grid grid-cols-2 gap-3 mt-3">
                        <div>
                            <label>Calle</label>
                            <input @bind="cuenta.Calle"
                                placeholder="Calle" />
                        </div>

                        <div>
                            <label>Número</label>
                            <input @bind="cuenta.Numero"
                                placeholder="Número" />
                        </div>

                        <div>
                            <label>Localidad</label>
                            <input @bind="cuenta.Localidad"
                                placeholder="Localidad" />
                        </div>

                        <div>
                            <label>Departamento</label>
                            <input @bind="cuenta.Departamento"
                                placeholder="Departamento" />
                        </div>
                    </div>

                    <button type="button"
                            disabled="@enviando"
                            @onclick="() => GuardarDireccionAsync(cuenta)">
                        Guardar dirección
                    </button>
                }
                else
                {
                    <button type="button"
                            @onclick="() => EditarDireccionAsync(cuenta)">
                        Configurar dirección
                    </button>
                }
            </div>
            }
            else if (cuenta.Estado == EstadoVinculacion.Pendiente)
            {
                <p>Estado: Pendiente de aprobación</p>
            }
            else if (cuenta.Estado == EstadoVinculacion.Rechazada)
            {
                <p>Estado: Solicitud rechazada</p>
            }
            else
            {
                <p>Estado: Vinculación inactiva</p>
            }
        </div>
    }
}

@code {
    private async Task EditarDireccionAsync(CuentaComercialDto cuenta)
{
    error = null;

    try
    {
        var direccion = await JS.InvokeAsync<DireccionDto?>(
            "autenticacionPortal.obtenerDireccionRecepcion",
            cuenta.Id);

        if (direccion is not null)
        {
            cuenta.Calle = direccion.Calle;
            cuenta.Numero = direccion.Numero;
            cuenta.Localidad = direccion.Localidad;
            cuenta.Departamento = direccion.Departamento;
            cuenta.DireccionCargada = true;
        }

        cuenta.EditandoDireccion = true;
    }
    catch (JSException ex)
    {
        error = ex.Message;
    }
}

private async Task GuardarDireccionAsync(CuentaComercialDto cuenta)
{
    
    if (enviando)
        return;

    error = null;
    mensaje = null;

    if (string.IsNullOrWhiteSpace(cuenta.Calle) ||
        string.IsNullOrWhiteSpace(cuenta.Numero) ||
        string.IsNullOrWhiteSpace(cuenta.Localidad) ||
        string.IsNullOrWhiteSpace(cuenta.Departamento))
    {
        error = "Completá todos los campos de la dirección.";
        return;
    }

    enviando = true;

    try
    {
        await JS.InvokeVoidAsync(
            "autenticacionPortal.guardarDireccionRecepcion",
            cuenta.Id,
            new
            {
                cuenta.Calle,
                cuenta.Numero,
                cuenta.Localidad,
                cuenta.Departamento
            });

        cuenta.DireccionCargada = true;
        cuenta.EditandoDireccion = false;

        mensaje = "Dirección guardada correctamente.";
    }
    catch (JSException ex)
    {
        error = ex.Message;
    }
    finally
    {
        enviando = false;
    }
}

private sealed class DireccionDto
{
    public string Calle { get; set; } = "";
    public string Numero { get; set; } = "";
    public string Localidad { get; set; } = "";
    public string Departamento { get; set; } = "";
}

    private List<OperadorDto> operadores = new();
    private List<CuentaComercialDto> cuentas = new();
    private bool cargando = true;
    private bool enviando;
    private string? error;
    private string? mensaje;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            operadores = await JS.InvokeAsync<List<OperadorDto>>(
                "autenticacionPortal.listarOperadores") ?? new();

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales") ?? new();
        }
        catch (JSException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task SolicitarAsync(Guid operadorId)
    {
        if (enviando)
            return;

        enviando = true;
        error = null;
        mensaje = null;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.solicitarVinculacion",
                operadorId);

            mensaje = "Solicitud enviada correctamente.";

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales");
        }
        catch (JSException ex)
        {
            error = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private sealed class OperadorDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string ColorPrimario { get; set; } = "";
    }

    private sealed class CuentaComercialDto
{
    public Guid Id { get; set; }
    public Guid OperadorId { get; set; }
    public string OperadorNombre { get; set; } = "";
    public Guid ComercioId { get; set; }
    public string ComercioNombre { get; set; } = "";
    public bool Activa { get; set; }
    public EstadoVinculacion Estado { get; set; }

    // Datos de la dirección de recepción
    public string Calle { get; set; } = "";
    public string Numero { get; set; } = "";
    public string Localidad { get; set; } = "";
    public string Departamento { get; set; } = "";

    // Estado del formulario
    public bool DireccionCargada { get; set; }
    public bool EditandoDireccion { get; set; }
}

    private enum EstadoVinculacion
    {
        Pendiente = 0,
        Confirmada = 1,
        Rechazada = 2
    }
}
