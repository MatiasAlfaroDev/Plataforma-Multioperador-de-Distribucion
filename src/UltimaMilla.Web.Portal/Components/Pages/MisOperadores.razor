@page "/mis-operadores"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "ComercioPortal")]
@inject IJSRuntime JS
@inject Notificaciones Notificaciones

<PageTitle>Mis operadores - Última Milla</PageTitle>

@if (cargando)
{
    <p class="vacio">Cargando operadores…</p>
}
else
{
    <div class="pagina">
        @if (!string.IsNullOrWhiteSpace(errorDeCarga))
        {
            <p class="aviso error" role="alert">@errorDeCarga</p>
        }

        @if (operadores.Count == 0 && errorDeCarga is null)
        {
            <p class="vacio">No hay operadores disponibles.</p>
        }

        <AuthorizeView Policy="AdministradorComercio" Context="admin">
            <section class="tarjeta">
                <h2 class="titulo-tarjeta">Datos del comercio</h2>
                <form @onsubmit="GuardarNombreAsync" @onsubmit:preventDefault>
                    <div class="campo">
                        <label for="nombre-comercio">Nombre</label>
                        <input id="nombre-comercio" @bind="nombreComercio" required maxlength="200" />
                    </div>
                    <div class="acciones">
                        <button type="submit" class="primario h-[44px]" disabled="@enviando">
                            <i class="ph ph-floppy-disk"></i>Guardar nombre
                        </button>
                    </div>
                </form>
            </section>
        </AuthorizeView>

        <div class="grid items-start gap-[24px] xl:grid-cols-2">
            @foreach (var operador in operadores)
            {
                var cuenta = cuentas.FirstOrDefault(c => c.OperadorId == operador.Id);

                <section class="tarjeta" @key="operador.Id">
                    <div class="cabecera-tarjeta">
                        <h2 class="titulo-tarjeta">
                            <span class="operador mr-0" style="background-color: @ColorDe(operador.ColorPrimario)"></span>
                            @operador.Nombre
                        </h2>
                        @if (cuenta is null)
                        {
                            <span class="chip">Sin vinculación</span>
                        }
                        else if (cuenta.Estado == EstadoVinculacion.Confirmada && cuenta.Activa)
                        {
                            <span class="chip chip-exito"><i class="ph ph-check-circle"></i>Vinculado</span>
                        }
                        else if (cuenta.Estado == EstadoVinculacion.Pendiente)
                        {
                            <span class="chip chip-alerta">Pendiente de aprobación</span>
                        }
                        else if (cuenta.Estado == EstadoVinculacion.Rechazada)
                        {
                            <span class="chip chip-peligro">Solicitud rechazada</span>
                        }
                        else
                        {
                            <span class="chip">Dado de baja por el operador</span>
                        }
                    </div>

                    @if (cuenta is { Estado: EstadoVinculacion.Confirmada, Activa: false })
                    {
                        <p class="nota">No podés crear envíos ni retiros nuevos con este operador; los que ya tenés siguen visibles.</p>
                    }

                    @if (cuenta is null)
                    {
                        <AuthorizeView Policy="AdministradorComercio" Context="admin">
                            <Authorized>
                                @if (formularios.TryGetValue(operador.Id, out var pedido))
                                {
                                    <form @onsubmit="() => SolicitarAsync(operador.Id)" @onsubmit:preventDefault>
                                        @CamposDireccion(pedido, operador.Id)
                                        <div class="acciones">
                                            <button type="submit" class="primario h-[44px]" disabled="@enviando">Enviar solicitud</button>
                                            <button type="button" class="h-[44px]" @onclick="() => formularios.Remove(operador.Id)">Cancelar</button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => formularios[operador.Id] = new DireccionFormulario()">
                                        <i class="ph ph-handshake"></i>Solicitar vinculación
                                    </button>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <p class="nota">Solo el administrador del comercio puede solicitar la vinculación.</p>
                            </NotAuthorized>
                        </AuthorizeView>
                    }

                    @if (cuenta is not null && cuenta.Estado != EstadoVinculacion.Rechazada)
                    {
                        <div class="rounded-xl border border-borde bg-hundido px-4 py-3">
                            <p class="etiqueta mb-1">Dirección de recepción</p>
                            <p class="flex items-center gap-1.5 text-sm">
                                <i class="ph ph-map-pin text-suave"></i>@(cuenta.DireccionRecepcion ?? "Sin configurar")
                            </p>
                        </div>

                        <AuthorizeView Policy="AdministradorComercio" Context="admin">
                            @if (formularios.TryGetValue(operador.Id, out var edicion))
                            {
                                <form class="mt-4" @onsubmit="() => GuardarDireccionAsync(operador.Id, cuenta.Id)" @onsubmit:preventDefault>
                                    @CamposDireccion(edicion, operador.Id)
                                    <div class="acciones">
                                        <button type="submit" class="primario h-[44px]" disabled="@enviando">Guardar dirección</button>
                                        <button type="button" class="h-[44px]" @onclick="() => formularios.Remove(operador.Id)">Cancelar</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="texto btn-chico mt-3" @onclick="() => formularios[operador.Id] = new DireccionFormulario()">
                                    <i class="ph ph-pencil-simple"></i>Cambiar dirección
                                </button>
                            }
                        </AuthorizeView>
                    }
                </section>
            }
        </div>
    </div>
}

@code {
    private List<OperadorDto> operadores = new();
    private List<CuentaComercialDto> cuentas = new();

    private bool cargando = true;
    private bool enviando;
    private string? errorDeCarga;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        errorDeCarga = null;

        try
        {
            operadores = await JS.InvokeAsync<List<OperadorDto>>(
                "autenticacionPortal.listarOperadores") ?? new();

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales") ?? new();

            // ponytail: el nombre sale de las cuentas; sin cuentas el campo arranca vacío.
            nombreComercio = cuentas.FirstOrDefault()?.ComercioNombre ?? "";
        }
        catch (JSException ex)
        {
            errorDeCarga = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    // Dirección de recepción (RF 37 y devoluciones): adonde el operador lleva lo que vuelve al comercio.
    private readonly Dictionary<Guid, DireccionFormulario> formularios = new();

    private RenderFragment CamposDireccion(DireccionFormulario d, Guid operadorId) => __builder =>
    {
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="campo"><label for="@($"calle-{operadorId}")">Calle</label><input id="@($"calle-{operadorId}")" @bind="d.Calle" required /></div>
            <div class="campo"><label for="@($"numero-{operadorId}")">Número</label><input id="@($"numero-{operadorId}")" @bind="d.Numero" required /></div>
            <div class="campo"><label for="@($"localidad-{operadorId}")">Localidad</label><input id="@($"localidad-{operadorId}")" @bind="d.Localidad" required /></div>
            <div class="campo"><label for="@($"departamento-{operadorId}")">Departamento</label><input id="@($"departamento-{operadorId}")" @bind="d.Departamento" required /></div>
        </div>
    };

    private async Task GuardarDireccionAsync(Guid operadorId, Guid cuentaId)
    {
        if (enviando)
            return;

        enviando = true;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.guardarDireccionRecepcion",
                cuentaId,
                formularios[operadorId]);

            formularios.Remove(operadorId);
            Notificaciones.Exito("Dirección actualizada", "El operador ya tiene la nueva dirección de recepción.");

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales");
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo guardar la dirección", ex.Message);
        }
        finally
        {
            enviando = false;
        }
    }

    // RF 1: el comercio es global; solo su administrador cambia el nombre.
    private string nombreComercio = "";

    private async Task GuardarNombreAsync()
    {
        if (enviando)
            return;

        enviando = true;

        try
        {
            await JS.InvokeVoidAsync("autenticacionPortal.modificarComercio", nombreComercio);
            Notificaciones.Exito("Comercio actualizado", "Todos tus operadores ven el nombre nuevo.");
            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales");
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo guardar el nombre", ex.Message);
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task SolicitarAsync(Guid operadorId)
    {
        if (enviando)
            return;

        enviando = true;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.solicitarVinculacion",
                operadorId,
                formularios[operadorId]);

            formularios.Remove(operadorId);
            Notificaciones.Exito("Solicitud enviada", "El operador la tiene que aprobar.");

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales");
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo enviar la solicitud", ex.Message);
        }
        finally
        {
            enviando = false;
        }
    }

    // El color va a un atributo style: solo se acepta un hex, como en Seguimiento.
    private static string ColorDe(string? color) =>
        color is not null && System.Text.RegularExpressions.Regex.IsMatch(color, "^#[0-9A-Fa-f]{6}$")
            ? color
            : "var(--c-borde-fuerte)";

    private sealed class OperadorDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string ColorPrimario { get; set; } = "";
    }

    private sealed class CuentaComercialDto
    {
        public Guid Id { get; set; }
        public Guid OperadorId { get; set; }
        public string OperadorNombre { get; set; } = "";
        public Guid ComercioId { get; set; }
        public string ComercioNombre { get; set; } = "";
        public bool Activa { get; set; }
        public EstadoVinculacion Estado { get; set; }
        public string? DireccionRecepcion { get; set; }
    }

    private sealed class DireccionFormulario
    {
        public string Calle { get; set; } = "";
        public string Numero { get; set; } = "";
        public string Localidad { get; set; } = "";
        public string Departamento { get; set; } = "";
    }

    private enum EstadoVinculacion
    {
        Pendiente = 0,
        Confirmada = 1,
        Rechazada = 2
    }
}
