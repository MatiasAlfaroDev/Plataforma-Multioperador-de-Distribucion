@page "/mis-operadores"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "ComercioPortal")]
@inject IJSRuntime JS

<PageTitle>Mis operadores - Última Milla</PageTitle>

<div class="encabezado">
    <div>
        <h1>Mis operadores</h1>
        <p>Consultá los operadores logísticos disponibles y gestioná tus vinculaciones.</p>
    </div>
</div>

@if (cargando)
{
    <p>Cargando operadores...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="aviso error" role="alert">@error</p>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <p class="aviso ok" role="status">@mensaje</p>
    }

    @if (operadores.Count == 0 && error is null)
    {
        <p>No hay operadores disponibles.</p>
    }

    @foreach (var operador in operadores)
    {
        var cuenta = cuentas.FirstOrDefault(
            c => c.OperadorId == operador.Id);

        <div class="tarjeta">
            <h3>@operador.Nombre</h3>

            @if (cuenta is null)
            {
                <p>Estado: Sin vinculación</p>

                <AuthorizeView Policy="AdministradorComercio" Context="admin">
                    <Authorized>
                        @if (formularios.TryGetValue(operador.Id, out var pedido))
                        {
                            <form @onsubmit="() => SolicitarAsync(operador.Id)" @onsubmit:preventDefault>
                                @CamposDireccion(pedido, operador.Id)
                                <div class="acciones">
                                    <button type="submit" class="primario" disabled="@enviando">Enviar solicitud</button>
                                    <button type="button" @onclick="() => formularios.Remove(operador.Id)">Cancelar</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <button type="button" @onclick="() => formularios[operador.Id] = new DireccionFormulario()">
                                Solicitar vinculación
                            </button>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <p class="nota">Solo el administrador del comercio puede solicitar la vinculación.</p>
                    </NotAuthorized>
                </AuthorizeView>
            }
           else if (cuenta.Estado == EstadoVinculacion.Confirmada
                    && cuenta.Activa)
            {
                <p class="ok flex items-center gap-1.5"><i class="ph ph-check-circle"></i>Vinculado</p>

                <p>Ya podés crear envíos con este operador.</p>

                <a class="btn-primario"
                href="@($"/?cuentaComercialId={cuenta.Id}")">
                    Crear envío
                </a>
            }
            else if (cuenta.Estado == EstadoVinculacion.Pendiente)
            {
                <p>Estado: Pendiente de aprobación</p>
            }
            else if (cuenta.Estado == EstadoVinculacion.Confirmada)
            {
                <p>Estado: Dado de baja por el operador</p>
                <p class="nota">No podés crear envíos ni retiros nuevos con este operador; los que ya tenés siguen visibles.</p>
            }

            @if (cuenta is not null && cuenta.Estado != EstadoVinculacion.Rechazada)
            {
                <p class="nota flex items-center gap-1.5">
                    <i class="ph ph-map-pin"></i>
                    Dirección de recepción: @(cuenta.DireccionRecepcion ?? "sin configurar")
                </p>

                <AuthorizeView Policy="AdministradorComercio" Context="admin">
                    @if (formularios.TryGetValue(operador.Id, out var edicion))
                    {
                        <form @onsubmit="() => GuardarDireccionAsync(operador.Id, cuenta.Id)" @onsubmit:preventDefault>
                            @CamposDireccion(edicion, operador.Id)
                            <div class="acciones">
                                <button type="submit" class="primario" disabled="@enviando">Guardar dirección</button>
                                <button type="button" @onclick="() => formularios.Remove(operador.Id)">Cancelar</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <button type="button" @onclick="() => formularios[operador.Id] = new DireccionFormulario()">
                            <i class="ph ph-pencil-simple"></i>Cambiar dirección
                        </button>
                    }
                </AuthorizeView>
            }
            else if (cuenta.Estado == EstadoVinculacion.Rechazada)
            {
                <p>Estado: Solicitud rechazada</p>
            }
            else
            {
                <p>Estado: Vinculación inactiva</p>
            }
        </div>
    }
}

@code {
    private List<OperadorDto> operadores = new();
    private List<CuentaComercialDto> cuentas = new();

    private bool cargando = true;
    private bool enviando;
    private string? error;
    private string? mensaje;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            operadores = await JS.InvokeAsync<List<OperadorDto>>(
                "autenticacionPortal.listarOperadores") ?? new();

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales") ?? new();
        }
        catch (JSException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    // Dirección de recepción (RF 37 y devoluciones): adonde el operador lleva lo que vuelve al comercio.
    private readonly Dictionary<Guid, DireccionFormulario> formularios = new();

    private RenderFragment CamposDireccion(DireccionFormulario d, Guid operadorId) => __builder =>
    {
        <fieldset>
            <legend>Dirección de recepción</legend>
            <div class="campos">
                <div><label for="@($"calle-{operadorId}")">Calle</label><input id="@($"calle-{operadorId}")" @bind="d.Calle" required /></div>
                <div><label for="@($"numero-{operadorId}")">Número</label><input id="@($"numero-{operadorId}")" @bind="d.Numero" required /></div>
                <div><label for="@($"localidad-{operadorId}")">Localidad</label><input id="@($"localidad-{operadorId}")" @bind="d.Localidad" required /></div>
                <div><label for="@($"departamento-{operadorId}")">Departamento</label><input id="@($"departamento-{operadorId}")" @bind="d.Departamento" required /></div>
            </div>
        </fieldset>
    };

    private async Task GuardarDireccionAsync(Guid operadorId, Guid cuentaId)
    {
        if (enviando)
            return;

        enviando = true;
        error = null;
        mensaje = null;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.guardarDireccionRecepcion",
                cuentaId,
                formularios[operadorId]);

            formularios.Remove(operadorId);
            mensaje = "Dirección de recepción actualizada.";

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales");
        }
        catch (JSException ex)
        {
            error = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task SolicitarAsync(Guid operadorId)
    {
        if (enviando)
            return;

        enviando = true;
        error = null;
        mensaje = null;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.solicitarVinculacion",
                operadorId,
                formularios[operadorId]);

            formularios.Remove(operadorId);
            mensaje = "Solicitud enviada correctamente.";

            cuentas = await JS.InvokeAsync<List<CuentaComercialDto>>(
                "autenticacionPortal.obtenerCuentasComerciales");
        }
        catch (JSException ex)
        {
            error = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private sealed class OperadorDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string ColorPrimario { get; set; } = "";
    }

    private sealed class CuentaComercialDto
    {
        public Guid Id { get; set; }
        public Guid OperadorId { get; set; }
        public string OperadorNombre { get; set; } = "";
        public Guid ComercioId { get; set; }
        public string ComercioNombre { get; set; } = "";
        public bool Activa { get; set; }
        public EstadoVinculacion Estado { get; set; }
        public string? DireccionRecepcion { get; set; }
    }

    private sealed class DireccionFormulario
    {
        public string Calle { get; set; } = "";
        public string Numero { get; set; } = "";
        public string Localidad { get; set; } = "";
        public string Departamento { get; set; } = "";
    }

    private enum EstadoVinculacion
    {
        Pendiente = 0,
        Confirmada = 1,
        Rechazada = 2
    }
}
