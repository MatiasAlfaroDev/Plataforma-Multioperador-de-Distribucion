@page "/registro"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navegacion

<PageTitle>Crear cuenta - Última Milla</PageTitle>

<div class="encabezado">
    <div>
        <h1>Crear cuenta</h1>
        <p>Registrate para comenzar a trabajar con operadores de distribución.</p>
    </div>
</div>

<div class="tarjeta max-w-2xl">
    <form @onsubmit="Registrar" @onsubmit:preventDefault>
        <fieldset>
            <legend>Datos personales</legend>

            <div class="campos">
                <div>
                    <label for="nombre">Nombre completo</label>
                    <input id="nombre"
                           type="text"
                           @bind="nombreCompleto"
                           maxlength="150"
                           required />
                </div>

                <div>
                    <label for="email">Correo electrónico</label>
                    <input id="email"
                           type="email"
                           autocomplete="email"
                           @bind="email"
                           required />
                </div>

                <div>
                    <label for="password">Contraseña</label>
                    <input id="password"
                           type="password"
                           autocomplete="new-password"
                           @bind="password"
                           minlength="8"
                           required />
                </div>

                <div>
                    <label for="confirmarPassword">Confirmar contraseña</label>
                    <input id="confirmarPassword"
                           type="password"
                           autocomplete="new-password"
                           @bind="confirmarPassword"
                           required />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Datos del comercio</legend>

            <div class="campos">
                <div>
                    <label for="nombreComercio">Nombre del comercio</label>
                    <input id="nombreComercio"
                           type="text"
                           @bind="nombreComercio"
                           required />
                </div>

                <div>
                    <label for="rut">RUT del comercio</label>
                    <input id="rut"
                           type="text"
                           @bind="rut"
                           required />
                </div>
            </div>
        </fieldset>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="aviso error">
                <i class="ph ph-x-circle"></i>
                <span>@error</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(exito))
        {
            <div class="aviso ok">
                <i class="ph ph-check-circle"></i>
                <span>@exito</span>
            </div>
        }

        <div class="acciones">
            <button type="submit" class="primario" disabled="@procesando">
                @(procesando ? "Registrando..." : "Crear cuenta")
            </button>
        </div>
    </form>
</div>

<p class="nota">
    ¿Ya tenés una cuenta?
    <a href="/login">Iniciar sesión</a>
</p>

@code {
    private string nombreCompleto = "";
    private string email = "";
    private string password = "";
    private string confirmarPassword = "";
    private string nombreComercio = "";
    private string rut = "";

    private string? error;
    private string? exito;
    private bool procesando;

    private async Task Registrar()
    {
        if (procesando)
            return;

        error = null;
        exito = null;

        if (password != confirmarPassword)
        {
            error = "Las contraseñas no coinciden.";
            return;
        }

        procesando = true;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.registrar",
                nombreCompleto,
                email,
                password,
                confirmarPassword,
                nombreComercio,
                rut);

            exito = "Tu cuenta fue creada correctamente. Ya podés iniciar sesión.";

            nombreCompleto = "";
            email = "";
            password = "";
            confirmarPassword = "";
            nombreComercio = "";
            rut = "";
        }
        catch (JSException ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }
}
