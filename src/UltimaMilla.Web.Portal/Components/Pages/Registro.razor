@page "/registro"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navegacion
@inject Notificaciones Notificaciones

<PageTitle>Crear cuenta - Última Milla</PageTitle>

<EditForm Model="modelo" OnValidSubmit="Registrar" class="grid gap-[24px]">
    <DataAnnotationsValidator />

    <section class="tarjeta">
        <h2 class="titulo-tarjeta"><span class="paso">1</span>Tus datos</h2>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="campo sm:col-span-2">
                <label for="nombre">Nombre completo</label>
                <InputText id="nombre" @bind-Value="modelo.NombreCompleto" autocomplete="name" maxlength="150" />
                <ValidationMessage For="() => modelo.NombreCompleto" />
            </div>
            <div class="campo sm:col-span-2">
                <label for="email">Correo electrónico</label>
                <InputText id="email" type="email" @bind-Value="modelo.Email" autocomplete="email" />
                <ValidationMessage For="() => modelo.Email" />
            </div>
            <div class="campo">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" @bind-Value="modelo.Password" autocomplete="new-password" />
                <ValidationMessage For="() => modelo.Password" />
            </div>
            <div class="campo">
                <label for="confirmarPassword">Repetí la contraseña</label>
                <InputText id="confirmarPassword" type="password" @bind-Value="modelo.ConfirmarPassword" autocomplete="new-password" />
                <ValidationMessage For="() => modelo.ConfirmarPassword" />
            </div>
        </div>
        <p class="nota mt-3">8 caracteres o más, con mayúscula, minúscula y número.</p>
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta"><span class="paso">2</span>Tu comercio</h2>
        <div class="grid gap-4 sm:grid-cols-[2fr_1fr]">
            <div class="campo">
                <label for="nombreComercio">Nombre del comercio</label>
                <InputText id="nombreComercio" @bind-Value="modelo.NombreComercio" />
                <ValidationMessage For="() => modelo.NombreComercio" />
            </div>
            <div class="campo">
                <label for="rut">RUT</label>
                <InputText id="rut" @bind-Value="modelo.Rut" inputmode="numeric" />
                <ValidationMessage For="() => modelo.Rut" />
            </div>
        </div>
    </section>

    <button type="submit" class="primario h-[44px] w-full" disabled="@procesando">
        @(procesando ? "Creando la cuenta…" : "Crear cuenta")
    </button>
</EditForm>

<p class="nota text-center">¿Ya tenés una cuenta? <a href="/login">Iniciar sesión</a></p>

@code {
    private RegistroComercioModel modelo = new();
    private bool procesando;

    private async Task Registrar()
    {
        if (procesando)
            return;

        procesando = true;

        try
        {
            await JS.InvokeVoidAsync(
                "autenticacionPortal.registrar",
                modelo.NombreCompleto,
                modelo.Email,
                modelo.Password,
                modelo.ConfirmarPassword,
                modelo.NombreComercio,
                modelo.Rut);

            Notificaciones.Exito("Cuenta creada", "Ya podés iniciar sesión.");
            modelo = new RegistroComercioModel();
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo crear la cuenta", ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }
}
