@page "/avisos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject IJSRuntime JS
@inject Notificaciones Notificaciones

<PageTitle>Avisos</PageTitle>

<div class="pagina">
    @if (errorDeCarga is not null)
    {
        <p role="alert" class="aviso error">@errorDeCarga</p>
    }

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Suscripciones</h2>
        @if (cargando)
        {
            <p class="vacio">Cargando…</p>
        }
        else if (suscripciones.Count == 0)
        {
            <p class="vacio">Todavía no hay suscripciones. La plataforma le avisa a tu sistema por HTTP cada novedad del envío.</p>
        }
        else
        {
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>URL</th>
                            <th>Eventos</th>
                            <th>Secreto</th>
                            <th>Contrato</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suscripcion in suscripciones)
                        {
                            <tr>
                                <td class="codigo">@suscripcion.Url</td>
                                <td class="whitespace-normal">@string.Join(", ", suscripcion.TiposEvento)</td>
                                <td><code>@suscripcion.Secreto</code></td>
                                <td>v@(suscripcion.VersionContrato)</td>
                                <td><span class="chip @(suscripcion.Activa ? "chip-exito" : null)">@(suscripcion.Activa ? "Activa" : "Inactiva")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Nueva suscripción</h2>
        <form @onsubmit="SuscribirAsync" @onsubmit:preventDefault>
            <div class="grid gap-4">
                <div class="campo">
                    <label for="url">URL de tu sistema</label>
                    <input type="url" id="url" @bind="nuevaUrl" placeholder="https://mi-tienda.uy/avisos" required />
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="campo">
                        <label for="cuenta">Operador</label>
                        <select id="cuenta" @bind="cuentaElegida" required>
                            @foreach (var cuenta in cuentas)
                            {
                                <option value="@cuenta.Id">@cuenta.OperadorNombre</option>
                            }
                        </select>
                    </div>
                    <div class="campo">
                        <label for="version">Versión del contrato</label>
                        <select id="version" @bind="versionContrato">
                            <option value="1">v1: estado del envío (formato original)</option>
                            <option value="2">v2: agrega el detalle y los avisos por bulto</option>
                        </select>
                    </div>
                </div>
            </div>

            <h3 class="subtitulo">Eventos</h3>
            <div class="casillas">
                @foreach (var (tipo, nombre) in Tipos.Where(t => versionContrato >= 2 || !t.Tipo.StartsWith("bulto.")))
                {
                    <label>
                        <input type="checkbox" checked="@tiposElegidos.Contains(tipo)" @onchange="() => AlternarTipo(tipo)" />
                        @nombre <code class="text-suave">@tipo</code>
                    </label>
                }
            </div>

            <div class="acciones">
                <button type="submit" class="primario h-[44px]" disabled="@(guardando || tiposElegidos.Count == 0)">
                    <i class="ph ph-webhooks-logo"></i>@(guardando ? "Suscribiendo…" : "Suscribirme")
                </button>
            </div>
        </form>
    </section>

    <section class="tarjeta">
        <div class="cabecera-tarjeta">
            <h2 class="titulo-tarjeta">Historial</h2>
            <button type="button" class="btn-chico" @onclick="CargarAsync" disabled="@cargando"><i class="ph ph-arrow-clockwise"></i>Actualizar</button>
        </div>
        @if (cargando)
        {
            <p class="vacio">Cargando…</p>
        }
        else if (avisos.Count == 0)
        {
            <p class="vacio">Todavía no se generaron avisos.</p>
        }
        else
        {
            <div class="tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Evento</th>
                            <th>Estado</th>
                            <th class="num">Intentos</th>
                            <th>Último error</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aviso in avisos)
                        {
                            <tr>
                                <td>@aviso.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="codigo">@aviso.TipoEvento</td>
                                <td><span class="@ClaseEstado(aviso.Estado)">@aviso.Estado</span></td>
                                <td class="num">@aviso.Intentos</td>
                                <td class="whitespace-normal">@aviso.UltimoError</td>
                                <td>
                                    @if (aviso.Estado == "Fallida")
                                    {
                                        <button type="button" class="btn-chico" @onclick="() => ReenviarAsync(aviso.Id)"><i class="ph ph-arrow-bend-up-right"></i>Reenviar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private static readonly (string Tipo, string Nombre)[] Tipos =
    [
        ("envio.creado", "Alta del envío"),
        ("envio.en_deposito", "En depósito"),
        ("envio.asignado_a_ruta", "Asignado a ruta"),
        ("envio.en_transito", "En tránsito"),
        ("envio.entregado", "Entregado"),
        ("envio.no_entregado", "Intento fallido"),
        ("envio.reprogramado", "Reprogramado"),
        ("envio.en_devolucion", "En devolución"),
        ("envio.devuelto", "Devuelto"),
        ("envio.extraviado", "Extraviado"),
        ("envio.entregado_parcialmente", "Entregado parcialmente"),
        ("bulto.entregado", "Bulto entregado"),
        ("bulto.no_entregado", "Bulto no entregado"),
        ("bulto.en_devolucion", "Bulto en devolución"),
        ("bulto.devuelto", "Bulto devuelto"),
        ("bulto.extraviado", "Bulto extraviado"),
        ("bulto.reaparecido", "Bulto reaparecido")
    ];

    private List<CuentaItem> cuentas = [];
    private Guid cuentaElegida;
    private int versionContrato = 2;

    private List<AvisoItem> avisos = [];
    private List<SuscripcionItem> suscripciones = [];
    private readonly HashSet<string> tiposElegidos = [.. Tipos.Select(t => t.Tipo)];
    private string nuevaUrl = "";
    private bool cargando = true;
    private bool guardando;
    private string? errorDeCarga;

    // El JS solo está disponible después del primer render (igual que en NuevoEnvio).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        errorDeCarga = null;

        try
        {
            avisos = await JS.InvokeAsync<List<AvisoItem>>("avisosPortal.listarAvisos");
            suscripciones = await JS.InvokeAsync<List<SuscripcionItem>>("avisosPortal.listarSuscripciones");

            // Un comercio puede trabajar con varios operadores: la suscripción es por cuenta.
            cuentas = (await JS.InvokeAsync<List<CuentaItem>>("autenticacionPortal.obtenerCuentasComerciales"))
                .Where(c => c.Activa && c.Estado == CuentaConfirmada)
                .ToList();
            if (cuentaElegida == Guid.Empty && cuentas.Count > 0)
                cuentaElegida = cuentas[0].Id;
        }
        catch (JSException)
        {
            errorDeCarga = "No se pudieron cargar los avisos.";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task ReenviarAsync(Guid id)
    {
        await EjecutarAsync(() => JS.InvokeAsync<ResultadoOperacion>("avisosPortal.reenviar", id).AsTask(),
            "No se pudo reenviar el aviso.");
    }

    private async Task SuscribirAsync()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            if (await EjecutarAsync(() => JS.InvokeAsync<ResultadoOperacion>(
                    "avisosPortal.crearSuscripcion",
                    new
                    {
                        cuentaComercialId = cuentaElegida,
                        url = nuevaUrl,
                        versionContrato,
                        // Una suscripción v1 no recibe avisos de bulto: no se mandan.
                        tiposEvento = tiposElegidos.Where(t => versionContrato >= 2 || !t.StartsWith("bulto.")).ToArray()
                    }).AsTask(),
                "No se pudo crear la suscripción."))
            {
                nuevaUrl = "";
            }
        }
        finally
        {
            guardando = false;
        }
    }

    /// <summary>Corre una operación contra la API, avisa su resultado con un toast y recarga las tablas.</summary>
    private async Task<bool> EjecutarAsync(Func<Task<ResultadoOperacion>> operacion, string mensajeDeError)
    {
        var exito = false;
        try
        {
            var resultado = await operacion();
            exito = resultado.Exito;
            if (exito)
                Notificaciones.Exito("Listo", resultado.Mensaje);
            else
                Notificaciones.Error(mensajeDeError, resultado.Mensaje);
        }
        catch (JSException)
        {
            Notificaciones.Error(mensajeDeError, "No hay conexión con la API.");
        }

        await CargarAsync();
        return exito;
    }

    private static string ClaseEstado(string estado) => estado switch
    {
        "Entregada" => "chip chip-exito",
        "Fallida" => "chip chip-peligro",
        _ => "chip"
    };

    private void AlternarTipo(string tipo)
    {
        if (!tiposElegidos.Remove(tipo))
            tiposElegidos.Add(tipo);
    }

    private sealed record AvisoItem(
        Guid Id,
        string TipoEvento,
        string Estado,
        int Intentos,
        string? UltimoError,
        DateTimeOffset CreadoEn);

    private sealed record SuscripcionItem(
        Guid Id,
        string Url,
        string Secreto,
        List<string> TiposEvento,
        bool Activa,
        int VersionContrato);

    // La API serializa EstadoCuentaComercial como número: 1 = Confirmada.
    private const int CuentaConfirmada = 1;

    private sealed record CuentaItem(Guid Id, string OperadorNombre, bool Activa, int Estado);

    private sealed record ResultadoOperacion(bool Exito, string Mensaje);
}
