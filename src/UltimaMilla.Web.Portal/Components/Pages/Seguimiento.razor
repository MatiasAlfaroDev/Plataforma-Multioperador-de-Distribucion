@page "/seguimiento/{Token}"
@using UltimaMilla.Web.Portal.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject SeguimientoApiClient SeguimientoApi

<PageTitle>Seguimiento de envío</PageTitle>

@if (cargando)
{
    <p class="vacio text-center">Consultando el envío…</p>
}
else if (error is not null)
{
    <p class="aviso error" role="alert">@error</p>
}
else if (seguimiento is null)
{
    <p class="aviso" role="status">No encontramos un envío asociado a este enlace.</p>
}
else
{
    <section class="tarjeta border-t-4" style="border-top-color: @ColorOperador">
        @if (!string.IsNullOrWhiteSpace(seguimiento.OperadorNombre))
        {
            <div class="mb-5 flex items-center gap-3">
                <span class="grid size-11 shrink-0 place-items-center rounded-xl text-2xl text-white" style="background-color: @ColorOperador">
                    <i class="ph ph-truck"></i>
                </span>
                <div>
                    <b class="block">@seguimiento.OperadorNombre</b>
                    <span class="nota">Operador responsable de tu envío</span>
                </div>
            </div>
        }

        <div class="cabecera-tarjeta">
            <h1 class="titulo-tarjeta">@(seguimiento.Tipo == "Retiro" ? seguimiento.Referencia : $"Envío {seguimiento.Referencia}")</h1>
            <span class="chip border-transparent text-white" style="background-color: @ColorOperador">@seguimiento.Estado</span>
        </div>

        @if (seguimiento.BultosTotales > 1 && seguimiento.BultosEntregados > 0)
        {
            <p class="mb-1.5 text-sm">@seguimiento.BultosEntregados de @seguimiento.BultosTotales bultos entregados</p>
            <progress max="@seguimiento.BultosTotales" value="@seguimiento.BultosEntregados"
                      aria-label="Bultos entregados" class="mb-5 w-full" style="accent-color: @ColorOperador"></progress>
        }

        <dl class="datos">
            <dt>Fecha de creación</dt><dd>@seguimiento.FechaAlta.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (seguimiento.FechaEntregaComprometida.HasValue)
            {
                <dt>Entrega prevista</dt><dd>@seguimiento.FechaEntregaComprometida.Value.ToString("dd/MM/yyyy")</dd>
            }
            @if (seguimiento.HoraEntregaDesde.HasValue && seguimiento.HoraEntregaHasta.HasValue)
            {
                <dt>Horario previsto</dt><dd>@seguimiento.HoraEntregaDesde.Value.ToString("HH:mm")–@seguimiento.HoraEntregaHasta.Value.ToString("HH:mm")</dd>
            }
            @if (seguimiento.FechaReprogramada.HasValue)
            {
                <dt>Reprogramado para</dt><dd>@seguimiento.FechaReprogramada.Value.ToString("dd/MM/yyyy")</dd>
            }
        </dl>
    </section>

    @if (seguimiento.Tipo == "Envio")
    {
        @if (solicitudEnviada)
        {
            <p class="aviso ok" role="status">Registramos tu pedido de reprogramación. El operador lo va a revisar.</p>
        }
        else if (disponibilidad is not null && seguimiento.Estado is not ("Entregado" or "Devuelto" or "EnDevolucion" or "Extraviado"))
        {
            <section class="tarjeta">
                <h2 class="titulo-tarjeta">¿Necesitás reprogramar la entrega?</h2>
                <p class="nota mb-4">
                    @(disponibilidad.PuedeSolicitar
                        ? "Podés pedir un nuevo intento de entrega. El operador revisa la solicitud."
                        : disponibilidad.Motivo)
                </p>
                <button type="button" class="primario h-[44px]"
                        disabled="@(solicitandoReprogramacion || !disponibilidad.PuedeSolicitar)" @onclick="SolicitarReprogramacion">
                    @(solicitandoReprogramacion ? "Enviando solicitud…" : "Solicitar reprogramación")
                </button>
            </section>
        }

        @if (errorReprogramacion is not null)
        {
            <p class="aviso error" role="alert">@errorReprogramacion</p>
        }
    }

    <section class="tarjeta">
        <h2 class="titulo-tarjeta">Historial</h2>
        @if (seguimiento.Historial.Count == 0)
        {
            <p class="vacio">Todavía no hay movimientos registrados.</p>
        }
        else
        {
            <ol class="grid gap-4">
                @foreach (var movimiento in seguimiento.Historial)
                {
                    <li class="border-l-[3px] pl-3" style="border-left-color: @ColorOperador">
                        <b class="block">@movimiento.Estado</b>
                        <span class="nota">@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private SeguimientoPublicoDto? seguimiento;
    private bool cargando = true;
    private string? error;
    private DisponibilidadReprogramacionPublicaDto? disponibilidad;
    private bool solicitandoReprogramacion;
    private bool solicitudEnviada;
    private string? errorReprogramacion;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = null;
        seguimiento = null;

        try
        {
            seguimiento = await SeguimientoApi.ConsultarAsync(Token);

            disponibilidad = null;
            solicitudEnviada = false;
            errorReprogramacion = null;

            if (seguimiento is not null && seguimiento.Tipo == "Envio")
            {
                disponibilidad = await SeguimientoApi
                    .ConsultarDisponibilidadAsync(Token);
            }
        }
        catch (HttpRequestException)
        {
            error = "No pudimos consultar el seguimiento. Intentá nuevamente más tarde.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ColorOperador
    {
        get
        {
            var color = seguimiento?.OperadorColorPrimario;

            return !string.IsNullOrWhiteSpace(color) &&
                System.Text.RegularExpressions.Regex.IsMatch(
                    color,
                    @"^#[0-9A-Fa-f]{6}$")
                ? color
                : "#c2410c";
        }
    }

    private async Task SolicitarReprogramacion()
{
    if (solicitandoReprogramacion ||
        disponibilidad?.PuedeSolicitar != true)
        return;

    solicitandoReprogramacion = true;
    errorReprogramacion = null;

    try
    {
        var resultado = await SeguimientoApi
            .SolicitarReprogramacionAsync(Token);

        if (resultado)
        {
            solicitudEnviada = true;
            disponibilidad = new(false, "Solicitud pendiente.");
        }
        else
        {
            errorReprogramacion =
                "No pudimos registrar la solicitud. " +
                "Es posible que las condiciones del envío hayan cambiado.";

            disponibilidad = await SeguimientoApi
                .ConsultarDisponibilidadAsync(Token);
        }
    }
    catch (HttpRequestException)
    {
        errorReprogramacion =
            "Ocurrió un problema de conexión. Intentá nuevamente más tarde.";
    }
    finally
    {
        solicitandoReprogramacion = false;
    }
}
}