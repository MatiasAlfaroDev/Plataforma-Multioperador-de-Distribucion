@page "/seguimiento/{Token}"
@using UltimaMilla.Web.Portal.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject SeguimientoApiClient SeguimientoApi

<PageTitle>Seguimiento de envío</PageTitle>

<div class="container py-5" style="max-width: 850px;">

    <h1 class="mb-2">Seguimiento de envío</h1>
    <p class="text-muted mb-4">
        Consultá el estado y los movimientos de tu paquete.
    </p>

    @if (cargando)
    {
        <div class="alert alert-info">
            Consultando información del envío...
        </div>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }
    else if (seguimiento is null)
    {
        <div class="alert alert-warning">
            No encontramos un envío asociado a este enlace.
        </div>
    }
    else
    {

@if (!string.IsNullOrWhiteSpace(seguimiento.OperadorNombre))
{
    <div class="card shadow-sm mb-4"
         style="border-top: 5px solid @ColorOperador;">

        <div class="card-body d-flex align-items-center gap-3">

            <div style="background-color: @ColorOperador;
                        width: 52px;
                        height: 52px;
                        border-radius: 12px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: white;
                        font-size: 25px;">
                🚚
            </div>

            <div>
                <h4 class="mb-1">
                    @seguimiento.OperadorNombre
                </h4>

                <span class="text-muted">
                    Operador responsable de tu envío
                </span>
            </div>

        </div>
    </div>
}

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="card-title">
                    @(seguimiento.Tipo == "Retiro" ? seguimiento.Referencia : $"Envío {seguimiento.Referencia}")
                </h5>

                <p>
                    <strong>Estado actual:</strong>
                    <span class="badge"
                    style="background-color: @ColorOperador;">
                    @seguimiento.Estado
                </span>
                </p>

                @if (seguimiento.BultosTotales > 1 && seguimiento.BultosEntregados > 0)
                {
                    <p>
                        <strong>Avance de la entrega:</strong>
                        @seguimiento.BultosEntregados de @seguimiento.BultosTotales bultos entregados
                    </p>
                    <progress max="@seguimiento.BultosTotales" value="@seguimiento.BultosEntregados"
                              aria-label="Bultos entregados" class="w-full"></progress>
                }

                <p>
                    <strong>Fecha de creación:</strong>
                    @seguimiento.FechaAlta.ToString("dd/MM/yyyy HH:mm")
                </p>

                @if (seguimiento.FechaEntregaComprometida.HasValue)
                {
                    <p>
                        <strong>Fecha prevista de entrega:</strong>
                        @seguimiento.FechaEntregaComprometida.Value.ToString("dd/MM/yyyy")
                    </p>
                }

                @if (seguimiento.HoraEntregaDesde.HasValue &&
                     seguimiento.HoraEntregaHasta.HasValue)
                {
                    <p>
                        <strong>Horario previsto:</strong>
                        @seguimiento.HoraEntregaDesde.Value.ToString("HH:mm")
                        -
                        @seguimiento.HoraEntregaHasta.Value.ToString("HH:mm")
                    </p>
                }

                @if (seguimiento.FechaReprogramada.HasValue)
                {
                    <p>
                        <strong>Fecha de reprogramación:</strong>
                        @seguimiento.FechaReprogramada.Value.ToString("dd/MM/yyyy")
                    </p>
                }
            </div>
        </div>
        @if (seguimiento.Tipo == "Envio")
{
    @if (solicitudEnviada)
    {
        <div class="alert alert-success mb-4" role="status">
            Tu solicitud de reprogramación fue registrada correctamente.
            El operador deberá revisarla.
        </div>
    }
    else if (disponibilidad?.PuedeSolicitar == true)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5>¿Necesitás reprogramar la entrega?</h5>

                <p class="text-muted">
                    Podés solicitar un nuevo intento de entrega.
                    El operador revisará tu solicitud.
                </p>

                <button type="button"
                        class="btn btn-primary"
                        disabled="@solicitandoReprogramacion"
                        @onclick="SolicitarReprogramacion">
                    @(solicitandoReprogramacion
                        ? "Enviando solicitud..."
                        : "Solicitar reprogramación")
                </button>
            </div>
        </div>
    }

    @if (errorReprogramacion is not null)
    {
        <div class="alert alert-danger mb-4" role="alert">
            @errorReprogramacion
        </div>
    }
}

        <h4 class="mb-3">Historial del envío</h4>

        <div class="card shadow-sm">
            <div class="card-body">

                @if (seguimiento.Historial.Count == 0)
                {
                    <p class="text-muted">
                        Todavía no hay movimientos registrados.
                    </p>
                }
                else
                {
                    @foreach (var movimiento in seguimiento.Historial)
                    {
                        <div class="border-start border-3 ps-3 mb-4"
     style="border-color: @ColorOperador !important;">
                            <strong>@movimiento.Estado</strong>

                            <div class="text-muted small">
                                @movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private SeguimientoPublicoDto? seguimiento;
    private bool cargando = true;
    private string? error;
    private DisponibilidadReprogramacionPublicaDto? disponibilidad;
    private bool solicitandoReprogramacion;
    private bool solicitudEnviada;
    private string? errorReprogramacion;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = null;
        seguimiento = null;

        try
        {
            seguimiento = await SeguimientoApi.ConsultarAsync(Token);

            disponibilidad = null;
            solicitudEnviada = false;
            errorReprogramacion = null;

            if (seguimiento is not null && seguimiento.Tipo == "Envio")
            {
                disponibilidad = await SeguimientoApi
                    .ConsultarDisponibilidadAsync(Token);
            }
        }
        catch (HttpRequestException)
        {
            error = "No pudimos consultar el seguimiento. Intentá nuevamente más tarde.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ColorOperador
    {
        get
        {
            var color = seguimiento?.OperadorColorPrimario;

            return !string.IsNullOrWhiteSpace(color) &&
                System.Text.RegularExpressions.Regex.IsMatch(
                    color,
                    @"^#[0-9A-Fa-f]{6}$")
                ? color
                : "#0D6EFD";
        }
    }

    private async Task SolicitarReprogramacion()
{
    if (solicitandoReprogramacion ||
        disponibilidad?.PuedeSolicitar != true)
        return;

    solicitandoReprogramacion = true;
    errorReprogramacion = null;

    try
    {
        var resultado = await SeguimientoApi
            .SolicitarReprogramacionAsync(Token);

        if (resultado)
        {
            solicitudEnviada = true;
            disponibilidad = new(false, "Solicitud pendiente.");
        }
        else
        {
            errorReprogramacion =
                "No pudimos registrar la solicitud. " +
                "Es posible que las condiciones del envío hayan cambiado.";

            disponibilidad = await SeguimientoApi
                .ConsultarDisponibilidadAsync(Token);
        }
    }
    catch (HttpRequestException)
    {
        errorReprogramacion =
            "Ocurrió un problema de conexión. Intentá nuevamente más tarde.";
    }
    finally
    {
        solicitandoReprogramacion = false;
    }
}
}