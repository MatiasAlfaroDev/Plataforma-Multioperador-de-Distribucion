@page "/retiros"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "ComercioPortal")]
@inject IJSRuntime JS
@inject Notificaciones Notificaciones

<PageTitle>Mis retiros - Última Milla</PageTitle>

<section class="tarjeta">
    <div class="cabecera-tarjeta">
        <h2 class="titulo-tarjeta">Mis retiros <span class="chip">@retiros.Count</span></h2>
        <div class="flex flex-wrap items-center gap-3">
            @if (retiros.Count > 0)
            {
                <select class="w-auto min-w-44" @bind="filtroEstado" aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>
                    @foreach (var e in TextosEstado)
                    {
                        <option value="@e.Key">@e.Value</option>
                    }
                </select>
                @if (nombresOperador.Count > 1)
                {
                    <select class="w-auto min-w-44" @bind="filtroOperador" aria-label="Filtrar por operador">
                        <option value="@Guid.Empty">Todos los operadores</option>
                        @foreach (var o in nombresOperador)
                        {
                            <option value="@o.Key">@o.Value</option>
                        }
                    </select>
                }
            }
            <a href="/retiros/nuevo" class="btn-primario btn-chico"><i class="ph ph-calendar-plus"></i>Solicitar retiro</a>
        </div>
    </div>

    @if (cargando)
    {
        <p class="vacio">Cargando…</p>
    }
    else if (retiros.Count == 0)
    {
        <p class="vacio">Todavía no solicitaste retiros.</p>
    }
    else
    {
        <div class="tabla tabla-holgada">
            <table>
                <thead>
                    <tr>
                        <th>Retiro</th>
                        <th>Domicilio</th>
                        <th>Operador</th>
                        <th>Estado</th>
                        <th class="num">Tarifa</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!RetirosFiltrados.Any())
                    {
                        <tr><td colspan="6" class="vacio">No hay retiros con esos filtros.</td></tr>
                    }
                    @foreach (var r in RetirosFiltrados)
                    {
                        <tr @key="r.Id">
                            <td>
                                <b>@r.FechaSolicitada.ToString("dd/MM/yyyy")</b>
                                <span class="linea2">@r.HoraDesde.ToString("HH:mm")–@r.HoraHasta.ToString("HH:mm") · @Bultos(r.Bultos.Count)</span>
                            </td>
                            <td>
                                @r.DomicilioRetiro.Calle @r.DomicilioRetiro.Numero
                                <span class="linea2">@r.DomicilioRetiro.Localidad, @r.DomicilioRetiro.Departamento</span>
                            </td>
                            <td>@nombresOperador.GetValueOrDefault(r.OperadorId, "-")</td>
                            <td>
                                <span class="@ClaseEstado(r.Estado)">@TextosEstado.GetValueOrDefault(r.Estado, r.Estado)</span>
                                @if (r.MotivoCancelacion is not null)
                                {
                                    <span class="linea2">@r.MotivoCancelacion</span>
                                }
                            </td>
                            <td class="num">@(r.TarifaCalculada?.ToString("C2") ?? "-")</td>
                            <td>
                                <div class="flex items-center justify-end gap-2">
                                    @if (enlaces.TryGetValue(r.Id, out var enlace))
                                    {
                                        <a href="@enlace" target="_blank" class="btn-secundario btn-chico"><i class="ph ph-arrow-square-out"></i>Abrir enlace</a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-chico" title="Enlace de seguimiento para el comprador" @onclick="() => GenerarEnlaceAsync(r.Id)">
                                            <i class="ph ph-link"></i>Enlace
                                        </button>
                                    }
                                    @if (r.Estado == "Solicitado" && cancelando != r.Id)
                                    {
                                        <button type="button" class="peligro btn-chico" @onclick="() => { cancelando = r.Id; motivoCancelacion = string.Empty; }">
                                            Cancelar
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @if (cancelando == r.Id)
                        {
                            <tr class="hover:bg-transparent">
                                <td colspan="6" class="bg-hundido">
                                    <form class="flex flex-wrap items-end gap-3" @onsubmit="() => CancelarAsync(r.Id)" @onsubmit:preventDefault>
                                        <div class="campo min-w-64 flex-1">
                                            <label for="motivo-cancelacion">Motivo de la cancelación</label>
                                            <input id="motivo-cancelacion" @bind="motivoCancelacion" maxlength="1000" required />
                                        </div>
                                        <button type="submit" class="peligro h-[44px]" disabled="@guardando">Cancelar retiro</button>
                                        <button type="button" class="h-[44px]" @onclick="() => cancelando = null">Volver</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>


@code {
    private List<RetiroItem> retiros = [];
    private readonly Dictionary<Guid, string> enlaces = [];
    private bool cargando = true, guardando;

    // Filtros del listado: se aplican sobre lo ya cargado (son los retiros de un solo comercio).
    private string filtroEstado = "";
    private Guid filtroOperador;
    private Dictionary<Guid, string> nombresOperador = [];
    private Guid? cancelando;
    private string motivoCancelacion = "";

    private static readonly Dictionary<string, string> TextosEstado = new()
    {
        ["Solicitado"] = "Solicitado",
        ["AsignadoARuta"] = "Asignado a ruta",
        ["EnTransito"] = "En tránsito",
        ["Retirado"] = "Retirado",
        ["NoRetirado"] = "No retirado",
        ["EnDeposito"] = "En depósito",
        ["AsignadoARutaComercio"] = "Asignado a ruta al comercio",
        ["EnTransitoComercio"] = "En tránsito al comercio",
        ["EntregadoAlComercio"] = "Entregado al comercio",
        ["Cancelado"] = "Cancelado"
    };

    private static string ClaseEstado(string estado) => estado switch
    {
        "EntregadoAlComercio" or "Retirado" => "chip chip-exito",
        "AsignadoARuta" or "EnTransito" or "AsignadoARutaComercio" or "EnTransitoComercio" or "EnDeposito" => "chip chip-acento",
        "NoRetirado" => "chip chip-alerta",
        "Cancelado" => "chip chip-peligro",
        _ => "chip"
    };

    private static string Bultos(int cantidad) => cantidad == 1 ? "1 bulto" : $"{cantidad} bultos";

    private IEnumerable<RetiroItem> RetirosFiltrados => retiros
        .Where(r => filtroEstado == "" || r.Estado == filtroEstado)
        .Where(r => filtroOperador == Guid.Empty || r.OperadorId == filtroOperador);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        try
        {
            retiros = await JS.InvokeAsync<List<RetiroItem>>("retirosPortal.listar");
            var todasLasCuentas = await JS.InvokeAsync<List<CuentaItem>>("autenticacionPortal.obtenerCuentasComerciales");
            nombresOperador = todasLasCuentas
                .GroupBy(c => c.OperadorId)
                .ToDictionary(g => g.Key, g => g.First().OperadorNombre);
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudieron cargar los retiros", ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CancelarAsync(Guid id)
    {
        if (guardando)
            return;

        guardando = true;
        try
        {
            var resultado = await JS.InvokeAsync<ResultadoOperacion>("retirosPortal.cancelar", id, motivoCancelacion);
            if (resultado.Exito)
            {
                Notificaciones.Exito("Retiro cancelado", resultado.Mensaje);
                cancelando = null;
                await CargarAsync();
            }
            else
            {
                Notificaciones.Error("No se pudo cancelar el retiro", resultado.Mensaje);
            }
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo cancelar el retiro", ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GenerarEnlaceAsync(Guid id)
    {
        try
        {
            enlaces[id] = await JS.InvokeAsync<string>("retirosPortal.enlacePublico", id);
        }
        catch (JSException ex)
        {
            Notificaciones.Error("No se pudo generar el enlace", ex.Message);
        }
    }

    private sealed record DireccionItem(string Calle, string Numero, string Localidad, string Departamento);
    private sealed record BultoItem(Guid Id, string Identificacion);
    private sealed record RetiroItem(
        Guid Id, Guid OperadorId, DateOnly FechaSolicitada, TimeOnly HoraDesde, TimeOnly HoraHasta, string Estado,
        DireccionItem DomicilioRetiro, decimal? TarifaCalculada, List<BultoItem> Bultos, string? MotivoCancelacion);
    private sealed record CuentaItem(Guid Id, Guid OperadorId, string OperadorNombre, bool Activa, int Estado);
    private sealed record ResultadoOperacion(bool Exito, string Mensaje);
}
