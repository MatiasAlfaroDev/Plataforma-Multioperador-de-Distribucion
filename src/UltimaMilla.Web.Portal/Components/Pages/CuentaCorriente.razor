@page "/cuenta-corriente"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "ComercioPortal")]
@inject IJSRuntime JS
@inject Notificaciones Notificaciones

<PageTitle>Cuenta corriente - Última Milla</PageTitle>

<div class="pagina">
    <section class="tarjeta">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="buscador w-full sm:w-72">
                <i class="ph ph-magnifying-glass"></i>
                <input type="search" placeholder="Buscar por referencia…" aria-label="Buscar movimientos por referencia"
                       @bind="busqueda" @bind:event="oninput" />
            </div>
            <form class="flex flex-wrap items-end gap-4" @onsubmit="CargarAsync" @onsubmit:preventDefault>
                <div class="campo">
                    <label for="desde">Desde</label>
                    <input id="desde" type="date" @bind="desde" required />
                </div>
                <div class="campo">
                    <label for="hasta">Hasta</label>
                    <input id="hasta" type="date" @bind="hasta" required />
                </div>
                <button type="submit" class="primario" disabled="@cargando"><i class="ph ph-magnifying-glass"></i>Consultar</button>
            </form>
        </div>
    </section>

    @if (cargando)
    {
        <p class="vacio">Cargando…</p>
    }
    else if (datos is null || datos.Cuentas.Count == 0)
    {
        <p class="vacio">Todavía no trabajás con ningún operador: no hay cuenta corriente para mostrar.</p>
    }
    else
    {
        @foreach (var cuenta in datos.Cuentas)
        {
            <section class="tarjeta">
                <h2 class="titulo-tarjeta">@cuenta.Operador</h2>

                <dl class="cifras">
                    <div><dt>Saldo anterior al @datos.Desde.ToString("dd/MM/yyyy")</dt><dd>@cuenta.SaldoAnterior.ToString("C2")</dd></div>
                    <div><dt>Cargos del período</dt><dd>@cuenta.CargosDelPeriodo.ToString("C2")</dd></div>
                    <div><dt>Saldo al @datos.Hasta.ToString("dd/MM/yyyy")</dt><dd>@cuenta.SaldoFinal.ToString("C2")</dd></div>
                </dl>

                @if (cuenta.ServiciosSinTarifa > 0)
                {
                    <p class="aviso mt-4">@cuenta.ServiciosSinTarifa servicio(s) del período no tienen tarifa calculada y no suman importe.</p>
                }

                <h3 class="subtitulo">Liquidaciones mensuales</h3>
                @if (cuenta.Liquidaciones.Count == 0)
                {
                    <p class="vacio">No hay servicios en el período.</p>
                }
                else
                {
                    <div class="tabla">
                        <table>
                            <thead>
                                <tr>
                                    <th>Mes</th>
                                    <th class="num">Envíos</th>
                                    <th class="num">Retiros</th>
                                    <th class="num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in cuenta.Liquidaciones)
                                {
                                    <tr>
                                        <td>@NombreMes(l.Mes) @l.Anio</td>
                                        <td class="num">@l.Envios</td>
                                        <td class="num">@l.Retiros</td>
                                        <td class="num">@l.Total.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h3 class="subtitulo">Movimientos</h3>
                @{ var movimientos = Filtrar(cuenta.Movimientos).ToList(); }
                @if (movimientos.Count == 0)
                {
                    <p class="vacio">@(string.IsNullOrWhiteSpace(busqueda) ? "No hay movimientos en el período." : $"Ningún movimiento coincide con «{busqueda.Trim()}».")</p>
                }
                else
                {
                    <div class="tabla">
                        <table>
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Servicio</th>
                                    <th>Referencia</th>
                                    <th>Estado</th>
                                    <th class="num">Importe</th>
                                    <th class="num">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in movimientos)
                                {
                                    <tr>
                                        <td>@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(m.Tipo == "Retiro" ? "Retiro" : "Envío")</td>
                                        <td class="codigo">@m.Referencia</td>
                                        <td>@TextoEstado(m.Estado)</td>
                                        <td class="num">@(m.Importe?.ToString("C2") ?? "Sin tarifa")</td>
                                        <td class="num">@m.SaldoAcumulado.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private CuentaCorrienteItem? datos;
    private DateOnly desde = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-5);
    private DateOnly hasta = DateOnly.FromDateTime(DateTime.Today);
    private bool cargando = true;

    private static readonly string[] Meses =
    [
        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Setiembre", "Octubre", "Noviembre", "Diciembre"
    ];

    private static readonly Dictionary<string, string> Estados = new()
    {
        ["Admitido"] = "Admitido",
        ["EnDeposito"] = "En depósito",
        ["AsignadoARuta"] = "Asignado a ruta",
        ["EnTransito"] = "En tránsito",
        ["Entregado"] = "Entregado",
        ["EntregadoParcialmente"] = "Entregado parcialmente",
        ["NoEntregado"] = "No entregado",
        ["Reprogramado"] = "Reprogramado",
        ["EnDevolucion"] = "En devolución",
        ["Devuelto"] = "Devuelto",
        ["Extraviado"] = "Extraviado",
        ["Solicitado"] = "Solicitado",
        ["Retirado"] = "Retirado",
        ["NoRetirado"] = "No retirado",
        ["EntregadoAlComercio"] = "Entregado al comercio"
    };

    // La búsqueda filtra los movimientos ya traídos: el período lo decide la consulta.
    private string busqueda = "";

    private IEnumerable<MovimientoItem> Filtrar(IEnumerable<MovimientoItem> movimientos) =>
        string.IsNullOrWhiteSpace(busqueda)
            ? movimientos
            : movimientos.Where(m => m.Referencia.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string NombreMes(int mes) => mes is >= 1 and <= 12 ? Meses[mes - 1] : mes.ToString();

    private static string TextoEstado(string estado) => Estados.GetValueOrDefault(estado, estado);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (hasta < desde)
        {
            Notificaciones.Error("Período inválido", "La fecha «hasta» no puede ser anterior a «desde».");
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            datos = await JS.InvokeAsync<CuentaCorrienteItem>(
                "cuentaCorrientePortal.obtener",
                desde.ToString("yyyy-MM-dd"),
                hasta.ToString("yyyy-MM-dd"));
        }
        catch (JSException ex)
        {
            datos = null;
            Notificaciones.Error("No se pudo cargar la cuenta corriente", ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private sealed record CuentaCorrienteItem(
        DateOnly Desde,
        DateOnly Hasta,
        List<CuentaOperadorItem> Cuentas);

    private sealed record CuentaOperadorItem(
        Guid CuentaComercialId,
        Guid OperadorId,
        string Operador,
        decimal SaldoAnterior,
        decimal CargosDelPeriodo,
        decimal SaldoFinal,
        int ServiciosSinTarifa,
        List<MovimientoItem> Movimientos,
        List<LiquidacionItem> Liquidaciones);

    private sealed record MovimientoItem(
        DateTimeOffset Fecha,
        string Tipo,
        Guid Id,
        string Referencia,
        string Estado,
        decimal? Importe,
        decimal SaldoAcumulado);

    private sealed record LiquidacionItem(int Anio, int Mes, int Envios, int Retiros, decimal Total);
}
