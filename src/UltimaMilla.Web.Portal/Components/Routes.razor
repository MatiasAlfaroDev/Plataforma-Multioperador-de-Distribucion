@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData"
                                DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <div class="max-w-md">
                        <h1>Iniciá sesión</h1>
                        <p class="mt-2 text-suave">Necesitás iniciar sesión para ver esta página.</p>
                        <a href="/login" class="btn-primario mt-6">Ir al inicio de sesión</a>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
    </Router>
</CascadingAuthenticationState>
